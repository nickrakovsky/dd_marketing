---
import { Linkedin, Youtube } from "lucide-react";

const MAIN_SITE = "";

const hoverLinkClass = `
  relative inline-block text-[#FFF8E9] transition-colors duration-300
  hover:text-[#FF5722]
  after:content-[''] 
  after:absolute 
  after:w-full 
  after:scale-x-0 
  after:h-[1px] 
  after:bottom-0 
  after:left-0 
  after:bg-[#FF5722] 
  after:origin-bottom-right 
  after:transition-transform 
  after:duration-300 
  hover:after:scale-x-100 
  hover:after:origin-bottom-left
`;

const columns = {
  contact: {
    title: "Contact Us",
    address: [
      "405 Queen Street S",
      "#75078",
      "Bolton, ON",
      "L7E 1H6"
    ],
    email: "info@datadocks.com",
    phone: "(647) 848-8250"
  },
  howItHelps: {
    title: "How DataDocks Helps",
    links: [
      { label: "Increase Capacity", href: `${MAIN_SITE}/benefits/increase-capacity` },
      { label: "See Everything", href: `${MAIN_SITE}/benefits/see-everything` },
      { label: "Delight Carriers", href: `${MAIN_SITE}/benefits/delight-carriers` },
      { label: "Digitize Operations", href: `${MAIN_SITE}/benefits/digitize-operations` },
    ]
  },
  features1: {
    title: "Features",
    links: [
      { label: "In-app QC & Compliance Checks", href: `${MAIN_SITE}/datadocks-features/documentation` },
      { label: "Capacity Control", href: `${MAIN_SITE}/datadocks-features/capacity-limits` },
      { label: "Automated Rules", href: `${MAIN_SITE}/datadocks-features/custom-rules` },
      { label: "Appointment Validation & Data Integrity", href: `${MAIN_SITE}/datadocks-features/data-validation` },
      { label: "Self-Scheduling", href: `${MAIN_SITE}/datadocks-features/carrier-portal` },
      { label: "Yard Visibility & Jockey Orders", href: `${MAIN_SITE}/datadocks-features/yard-management` },
    ]
  },
  features2: {
    title: "",
    links: [
      { label: "Live Dock Dashboard", href: `${MAIN_SITE}/datadocks-features/dock-dashboard` },
      { label: "Analytics & Reporting", href: `${MAIN_SITE}/datadocks-features/efficiency-reports` },
      { label: "Automated Alerts & Notifications", href: `${MAIN_SITE}/datadocks-features/notifications` },
      { label: "Mobile Companion App", href: `${MAIN_SITE}/datadocks-features/access-anywhere` },
      { label: "AI Logistics Assistant", href: `${MAIN_SITE}/datadocks-features/ai-assistant` },
      { label: "WMS & TMS Integrations", href: `${MAIN_SITE}/datadocks-features/integration` },
    ]
  },
  quickLinks: {
    title: "Quick Links",
    links: [
      { label: "Login", href: "https://app.datadocks.com" },
      { label: "About", href: `${MAIN_SITE}/about` },
      { label: "News & updates", href: "/news" },
      { label: "Support", href: `${MAIN_SITE}/support` },
      { label: "Mobile App", href: "/mobile-app" },
      { label: "DataDocks v.s. Opendock", href: `${MAIN_SITE}/datadocks-vs-opendock` },
      { label: "Privacy Policy", href: "/privacy-policy" },
    ]
  }
};
---

<footer class="bg-black text-[#FFF8E9] py-12 border-t border-white/10 font-sans text-sm sm:text-base transition-[font-size] duration-300" style="content-visibility: auto; contain-intrinsic-size: auto 500px;">
  <div class="container mx-auto px-6 max-w-7xl">

    {/* One markup tree: phones stack supporting links beside Features; from 640px,
        display: contents restores the existing tablet and desktop column layout. */}
    <div class="footer-link-columns grid grid-cols-2 sm:grid-cols-3 md:grid-cols-[1.2fr_1fr_2.2fr_1fr] gap-x-6 sm:gap-x-8 gap-y-10 mb-10">
      <div class="footer-support-columns flex min-w-0 flex-col gap-10 sm:contents">
        {/* Contact — semantic <address> for NAP consistency (local SEO) */}
        <div class="footer-contact min-w-0 sm:col-start-1 sm:row-start-1">
          <h3 class="font-recoleta font-bold text-lg mb-4 text-[#FFF8E9]">{columns.contact.title}</h3>
          <address class="not-italic text-[#FFF8E9]/90 leading-snug space-y-0 mb-4">
            {columns.contact.address.map(line => <p>{line}</p>)}
          </address>
          <div class="flex flex-col gap-1">
            <a href={`mailto:${columns.contact.email}`} class={hoverLinkClass}>{columns.contact.email.split("@")[0]}@<wbr class="sm:hidden" />{columns.contact.email.split("@")[1]}</a>
            <a href={`tel:${columns.contact.phone.replace(/\D/g,'')}`} class={hoverLinkClass}>{columns.contact.phone}</a>
          </div>
        </div>

        <div class="footer-quick-links min-w-0 sm:col-start-2 sm:row-start-2 md:col-start-4 md:row-start-1">
          <h3 class="font-recoleta font-bold text-lg mb-4 text-[#FFF8E9]">{columns.quickLinks.title}</h3>
          <ul class="space-y-1.5">
            {columns.quickLinks.links.map(link => (<li><a href={link.href} class={hoverLinkClass}>{link.label}</a></li>))}
          </ul>
        </div>

        <div class="footer-how-it-helps min-w-0 sm:col-start-2 sm:row-start-1">
          <h3 class="font-recoleta font-bold text-lg mb-4 text-[#FFF8E9]">{columns.howItHelps.title}</h3>
          <ul class="space-y-1.5">
            {columns.howItHelps.links.map(link => (<li><a href={link.href} class={hoverLinkClass}>{link.label}</a></li>))}
          </ul>
        </div>
      </div>

      {/* Features stays in the right column on phones, spans both tablet rows,
          and flows into two sub-columns on desktop. */}
      <div class="footer-features min-w-0 sm:col-start-3 sm:row-start-1 sm:row-span-2 md:row-span-1">
        <h3 class="font-recoleta font-bold text-lg mb-4 text-[#FFF8E9]">{columns.features1.title}</h3>
        <ul class="space-y-1.5 md:columns-2 md:gap-8 [&>li]:break-inside-avoid">
          {[...columns.features1.links, ...columns.features2.links].map(link => (<li><a href={link.href} class={hoverLinkClass}>{link.label}</a></li>))}
        </ul>
      </div>
    </div>

    {/* ── BRAND + LEGAL BAR ────────────────────────────────────────────────────────
        Logo, badges, social links and copyright each appear ONCE. Stacks and centers
        on mobile; spreads into a row on desktop. Social icons are real links at every
        size (previously the small-screen variants were non-clickable icons).
    ─────────────────────────────────────────────────────────────────────────────── */}
    <div class="flex flex-col items-center gap-8 pt-8 border-t border-white/10 md:flex-row md:justify-between md:items-center">
      {/* Logo + trust badges */}
      <div class="footer-trust-badges grid w-full grid-cols-2 items-center justify-center gap-6 sm:flex sm:w-auto sm:flex-nowrap sm:gap-10 md:justify-start">
        <a href="/" class="justify-self-end hover:scale-105 transition-transform duration-300">
          <img src="/images/Orange-Logo.svg" alt="DataDocks Logo" width="56" height="56" class="h-16 w-16 min-[480px]:h-20 min-[480px]:w-20 max-w-full object-contain" loading="lazy" decoding="async" />
        </a>
        <img src="/images/soc2-badge.webp" alt="AICPA SOC2 Certified" width="160" height="159" class="justify-self-start h-16 min-[480px]:h-20 w-auto max-w-full object-contain" loading="lazy" decoding="async" />
        <a href="https://feddev-ontario.canada.ca/" target="_blank" rel="noopener noreferrer" class="footer-funding-badge col-span-2 min-w-0 w-full hover:scale-105 transition-transform duration-300 sm:w-auto">
          <img src="/images/canada-badge-1200.webp" srcset="/images/canada-badge-600.webp 600w, /images/canada-badge-1200.webp 1200w" sizes="(min-width: 640px) 563px, calc(100vw - 48px)" alt="Government of Canada" width="1200" height="85" class="h-auto w-full max-w-full object-contain sm:h-10 sm:w-auto" loading="lazy" decoding="async" />
        </a>
      </div>

      {/* Social links + copyright */}
      <div class="flex flex-col items-center gap-3 md:items-end">
        <div class="flex items-center gap-5">
          <a href="https://www.linkedin.com/company/datadocks" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="text-[#FFF8E9]/60 hover:text-[#0077b5] transition-colors"><Linkedin aria-hidden="true" className="w-5 h-5" /></a>
          <a href="https://x.com/datadocks" target="_blank" rel="noopener noreferrer" aria-label="X (Twitter)" class="text-[#FFF8E9]/60 hover:text-[#FFF8E9] transition-colors">
            <svg viewBox="0 0 24 24" aria-hidden="true" class="w-5 h-5 fill-current"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"></path></svg>
          </a>
          <a href="https://www.youtube.com/@datadocks" target="_blank" rel="noopener noreferrer" aria-label="YouTube" class="text-[#FFF8E9]/60 hover:text-[#FF0000] transition-colors"><Youtube aria-hidden="true" className="w-5 h-5" /></a>
        </div>
        <p class="text-sm text-[#FFF8E9]/80">©{new Date().getFullYear()} Northfire Inc.</p>
      </div>
    </div>

  </div>
</footer>
