---
import datadocksLogo from "../assets/datadocks-logo.svg";
import datadocksLogoWhite from "../assets/datadocks-logo-white.svg";
import { CALENDLY_BOOKING_URL } from "../lib/calendly-config.mjs";

interface Props {
  isOrange?: boolean;
  demoHref?: string;
  featuresHref?: string;
}

const { isOrange = false, demoHref = CALENDLY_BOOKING_URL, featuresHref = '/#features' } = Astro.props;

const basePath = import.meta.env.BASE_URL.replace(/\/$/, "");

const dropdownItems = [
  { label: "Increase Capacity", href: `${basePath}/benefits/increase-capacity` },
  { label: "See Everything", href: `${basePath}/benefits/see-everything` },
  { label: "Delight Carriers", href: `${basePath}/benefits/delight-carriers` },
  { label: "Digitize Operations", href: `${basePath}/benefits/digitize-operations` },
];

const textClass = isOrange
  ? "text-white hover:text-white/80"
  : "text-foreground dark:text-[color:var(--blog-ink,#e5e7eb)] hover:text-foreground/70 dark:hover:text-[color:var(--blog-link,#9ca3af)]";

const mobileTextClass = isOrange
  ? "text-white border-white/20"
  : "text-foreground dark:text-[color:var(--blog-ink,#e5e7eb)] border-[#e3d5c4a6] dark:border-[var(--blog-rule,#374151)]";

const mobileBg = isOrange
  ? "bg-[#fd4f00] border-white/20"
  : "bg-[#FFF8E9] dark:bg-[var(--blog-canvas,#111827)] border-border dark:border-[var(--blog-rule,#374151)]";

const desktopBtnClass = isOrange
  ? "bg-white text-[#fd4f00] hover:bg-black hover:text-white border-transparent hover:border-b-white"
  : "bg-[#FF5722] hover:bg-black text-white border-transparent hover:border-b-[#FF5722]";

const mobileBtnClass = isOrange
  ? "bg-white text-[#fd4f00] hover:bg-black hover:text-white border-transparent hover:border-b-white"
  : "bg-[#FF5722] hover:bg-black text-white border-transparent hover:border-b-[#FF5722]";

const mobileDropdownBg = isOrange
  ? ""
  : "bg-[#EFE2D2] dark:bg-[var(--blog-surface,#1f2937)]";

const mobileDropdownLinkClass = isOrange
  ? "text-white/90 border-white/10 hover:text-white"
  : "text-foreground dark:text-[color:var(--blog-ink,#e5e7eb)] border-[#e3d5c4a6] dark:border-[var(--blog-rule,#374151)] hover:text-[#665238] dark:hover:text-[color:var(--blog-link,#ff7635)]";
---

<nav class={`z-50 transition-colors duration-300 ${isOrange ? "relative bg-transparent" : "relative bg-[#FFF8E9] dark:bg-[var(--blog-canvas,#111827)]"}`} data-nav aria-label="Main">
  <div class="container mx-auto px-0 md:px-8 pt-4 md:pt-12 pb-4 md:pb-6">
    <div class="flex items-center justify-between flex-wrap min-h-[4rem] gap-2 sm:gap-4 px-4 md:px-0 py-2 md:py-0 w-full">

      <div class="flex items-center flex-shrink min-w-0">
        <a href="/" class="flex-shrink min-w-0">
          <img
            src={datadocksLogo.src}
            alt="DataDocks Logo"
            width="201"
            height="43"
            class={`h-[clamp(1.5rem,10vw,2.5rem)] sm:h-12 w-auto max-w-[65vw] object-contain ${isOrange ? "hidden" : "block dark:hidden"}`}
          />
          <img
            src={datadocksLogoWhite.src}
            alt="DataDocks Logo"
            width="201"
            height="43"
            class={`h-[clamp(1.5rem,10vw,2.5rem)] sm:h-12 w-auto max-w-[65vw] object-contain ${isOrange ? "block" : "hidden dark:block"}`}
          />
        </a>
      </div>

      <!-- Desktop Nav -->
      <div class="hidden lg:flex items-center lg:space-x-6 xl:space-x-8 flex-1 justify-end">

        <div class="relative" data-dropdown>
          <button type="button" aria-expanded="false" aria-controls="desktop-help-links" class={`flex items-center gap-1 transition-colors font-recoleta text-base xl:text-lg ${textClass}`} data-dropdown-trigger>
            How DataDocks Helps
            <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
          </button>
          <div id="desktop-help-links" class="absolute top-full left-0 mt-0 pt-2 w-56 z-50 hidden" data-dropdown-menu>
            <div class="bg-[#EFE2D2] dark:bg-[var(--blog-surface,#1f2937)] border border-border dark:border-[var(--blog-rule,#374151)] rounded-[8px] overflow-hidden py-2 transition-colors duration-300">
              {dropdownItems.map((item) => (
                <a
                  href={item.href}
                  class="block px-4 py-1.5 text-foreground dark:text-[color:var(--blog-ink,#e5e7eb)] hover:pl-6 hover:translate-x-1 hover:text-[#665238] dark:hover:text-[color:var(--blog-link,#ff7635)] transition-all duration-300 font-recoleta text-base"
                >
                  {item.label}
                </a>
              ))}
            </div>
          </div>
        </div>

        <a href={featuresHref} class={`transition-colors font-recoleta text-base xl:text-lg ${textClass}`}>Features</a>
        <a href={`${basePath}/posts`} class={`transition-colors font-recoleta text-base xl:text-lg ${textClass}`}>Resources</a>
        <a href="/integrations" class={`transition-colors font-recoleta text-base xl:text-lg ${textClass}`}>Integrations</a>
        <a href="https://booking.datadocks.com/" class={`transition-colors font-recoleta text-base xl:text-lg ${textClass}`}>Login</a>

        <a
          href={demoHref}
          target={demoHref.startsWith('#') ? undefined : '_blank'}
          rel={demoHref.startsWith('#') ? undefined : 'noopener noreferrer'}
          class={`blog-nav-cta inline-flex items-center justify-center whitespace-nowrap h-10 px-6 font-recoleta font-normal rounded-none text-[1.2rem] xl:text-[1.2rem] border-b-4 transition-all shadow-none ${desktopBtnClass}`}
        >
          Schedule a Demo
        </a>
      </div>

      <!-- Mobile hamburger -->
      <button
        aria-label="Toggle Navigation Menu"
        class={`lg:hidden shrink-0 p-2 transition-colors duration-300 ${isOrange ? "text-white" : "text-foreground dark:text-[color:var(--blog-ink,#e5e7eb)]"}`}
        data-mobile-toggle
      >
        <svg class="w-6 h-6" data-icon-menu xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="20" y1="18" y2="18"/></svg>
        <svg class="w-6 h-6 hidden" data-icon-close xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
      </button>
    </div>

    <!-- Mobile menu -->
    <div class={`lg:hidden absolute top-full left-0 right-0 border-t z-50 shadow-xl transition-colors duration-300 hidden ${mobileBg}`} data-mobile-menu>
      <div class="flex flex-col space-y-0">
        <div class="flex flex-col">
          <button
            class={`flex items-center justify-between px-4 py-3 font-recoleta border-b transition-colors duration-300 ${mobileTextClass}`}
            data-mobile-dropdown-trigger
          >
            How DataDocks Helps
            <svg class="w-4 h-4 transition-transform" data-mobile-chevron xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
          </button>
          <div class={`${mobileDropdownBg} flex flex-col transition-colors duration-300 hidden`} data-mobile-dropdown>
            {dropdownItems.map((item) => (
              <a
                href={item.href}
                class={`px-8 py-3 font-recoleta border-b last:border-0 transition-colors duration-300 ${mobileDropdownLinkClass}`}
                data-mobile-link
              >
                {item.label}
              </a>
            ))}
          </div>
        </div>

        <a href={featuresHref} class={`px-4 py-3 font-recoleta border-b transition-colors duration-300 ${mobileTextClass}`} data-mobile-link>Features</a>
        <a href={`${basePath}/posts`} class={`px-4 py-3 font-recoleta border-b transition-colors duration-300 ${mobileTextClass}`} data-mobile-link>Resources</a>
        <a href="/integrations" class={`px-4 py-3 font-recoleta border-b transition-colors duration-300 ${mobileTextClass}`} data-mobile-link>Integrations</a>
        <a href="https://booking.datadocks.com/" class={`px-4 py-3 font-recoleta border-b transition-colors duration-300 ${mobileTextClass}`} data-mobile-link>Login</a>

        <div class="p-0">
          <a
            href={demoHref}
            target={demoHref.startsWith('#') ? undefined : '_blank'}
            rel={demoHref.startsWith('#') ? undefined : 'noopener noreferrer'}
            data-mobile-link
            class={`blog-nav-cta w-full inline-flex items-center justify-center rounded-none border-b-4 transition-all shadow-none font-recoleta font-normal py-8 text-[1.2rem] ${mobileBtnClass}`}
          >
            Schedule a Demo
          </a>
        </div>
      </div>
    </div>
  </div>
</nav>

<script>
  function initNav() {
    const nav = document.querySelector<HTMLElement>('[data-nav]');
    if (!nav || nav.dataset.navInitialized) return;
    nav.dataset.navInitialized = 'true';

    // Desktop dropdown
    const dropdown = nav.querySelector<HTMLElement>('[data-dropdown]');
    const dropdownTrigger = nav.querySelector<HTMLButtonElement>('[data-dropdown-trigger]');
    const dropdownMenu = nav.querySelector<HTMLElement>('[data-dropdown-menu]');
    let dropdownTimeout: ReturnType<typeof setTimeout>;

    const isDropdownOpen = () => dropdownTrigger?.getAttribute('aria-expanded') === 'true';
    const setDropdownOpen = (open: boolean) => {
      clearTimeout(dropdownTimeout);
      dropdownMenu?.classList.toggle('hidden', !open);
      dropdownTrigger?.setAttribute('aria-expanded', String(open));
    };

    dropdown?.addEventListener('mouseenter', () => {
      setDropdownOpen(true);
    });
    dropdown?.addEventListener('mouseleave', () => {
      dropdownTimeout = setTimeout(() => {
        if (!dropdown.contains(document.activeElement)) setDropdownOpen(false);
      }, 300);
    });

    dropdownTrigger?.addEventListener('click', (event) => {
      // Hover already opens the pointer interaction; Enter/Space toggle it.
      setDropdownOpen(event.detail === 0 ? !isDropdownOpen() : true);
    });
    dropdownTrigger?.addEventListener('keydown', (event) => {
      if (event.key !== 'ArrowDown') return;
      event.preventDefault();
      setDropdownOpen(true);
      const firstLink = dropdownMenu?.querySelector<HTMLAnchorElement>('a');
      firstLink?.focus();
    });
    dropdown?.addEventListener('focusout', (event) => {
      if (!(event.relatedTarget instanceof Node) || !dropdown.contains(event.relatedTarget)) {
        setDropdownOpen(false);
      }
    });

    const desktopEvents = new AbortController();
    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape' || !isDropdownOpen()) return;
      event.preventDefault();
      setDropdownOpen(false);
      dropdownTrigger?.focus();
    }, { signal: desktopEvents.signal });
    document.addEventListener('pointerdown', (event) => {
      if (event.target instanceof Node && !dropdown?.contains(event.target)) setDropdownOpen(false);
    }, { signal: desktopEvents.signal });
    const desktopLayout = window.matchMedia('(min-width: 1024px)');
    desktopLayout.addEventListener('change', () => {
      if (!desktopLayout.matches) setDropdownOpen(false);
    }, { signal: desktopEvents.signal });
    document.addEventListener('astro:before-swap', () => desktopEvents.abort(), { once: true });

    // Mobile toggle
    const mobileToggle = nav.querySelector('[data-mobile-toggle]');
    const mobileMenu = nav.querySelector('[data-mobile-menu]');
    const iconMenu = nav.querySelector('[data-icon-menu]');
    const iconClose = nav.querySelector('[data-icon-close]');

    mobileToggle?.addEventListener('click', () => {
      const isOpen = !mobileMenu?.classList.contains('hidden');
      mobileMenu?.classList.toggle('hidden');
      iconMenu?.classList.toggle('hidden', !isOpen);
      iconClose?.classList.toggle('hidden', isOpen);
    });

    // Mobile dropdown
    const mobileDropdownTrigger = nav.querySelector('[data-mobile-dropdown-trigger]');
    const mobileDropdown = nav.querySelector('[data-mobile-dropdown]');
    const mobileChevron = nav.querySelector('[data-mobile-chevron]');

    mobileDropdownTrigger?.addEventListener('click', () => {
      mobileDropdown?.classList.toggle('hidden');
      mobileChevron?.classList.toggle('rotate-180');
    });

    // Close mobile menu on link click
    nav.querySelectorAll('[data-mobile-link]').forEach((link) => {
      link.addEventListener('click', () => {
        mobileMenu?.classList.add('hidden');
        iconMenu?.classList.remove('hidden');
        iconClose?.classList.add('hidden');
      });
    });
  }

  initNav();
  document.addEventListener('astro:after-swap', initNav);
</script>

<style>
  :global(html.dark[data-blog-theme]) .blog-nav-cta {
    background: var(--blog-orange);
    color: #fff;
    font-family: Inter, sans-serif;
    font-size: 20px;
    font-weight: 700;
  }

  :global(html.dark[data-blog-theme]) .blog-nav-cta:hover {
    background: var(--blog-surface);
    border-bottom-color: var(--blog-orange);
    color: var(--blog-ink);
  }
</style>
