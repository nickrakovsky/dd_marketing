---
interface Props {
  sourceName: string;
  program?: string;
  year: string;
  awardCategory?: string;
  variant?: 'orange' | 'paper' | 'ink';
}

const { program = Astro.props.sourceName, year, awardCategory, variant = 'orange' } = Astro.props;
const displayProgram = year !== 'undated' && program.endsWith(` ${year}`)
  ? program.slice(0, -(year.length + 1))
  : program;
---

<div class:list={['news-artwork', `news-artwork--${variant}`]} aria-hidden="true">
  <div class="news-artwork__program">{displayProgram}</div>
  <div class="news-artwork__bottom">
    <span class="news-artwork__category">{awardCategory || 'DataDocks'}</span>
    {year !== 'undated' && <span class="news-artwork__year">{year}</span>}
  </div>
</div>

<style>
  .news-artwork {
    --art-ground: #fe5000;
    --art-ink: #fff;
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 330px;
    height: 100%;
    padding: 25px 27px 20px;
    overflow: hidden;
    container-type: inline-size;
    background: var(--art-ground);
    color: var(--art-ink);
  }

  .news-artwork--paper { --art-ground: #efe2d2; --art-ink: #000; }
  .news-artwork--ink { --art-ground: #000; --art-ink: #fff8e9; }

  .news-artwork__program { max-width: 100%; padding: 12px 0 32px; font: 800 clamp(1.55rem, 14cqw, 3.2rem)/.95 Bruta, Bruta-Fallback, Impact, sans-serif; text-transform: uppercase; text-wrap: balance; overflow-wrap: break-word; }
  .news-artwork__bottom { display: flex; align-items: flex-end; justify-content: space-between; gap: 16px; border-top: 1px solid color-mix(in srgb, currentColor 45%, transparent); padding-top: 16px; }
  .news-artwork__category { font: 400 14px/1.5 Inter, system-ui, sans-serif; }
  .news-artwork__year { flex-shrink: 0; font: 800 clamp(2.7rem, 22cqw, 3.75rem)/.85 Bruta, Bruta-Fallback, Impact, sans-serif; letter-spacing: -.02em; }
  @container (max-width: 250px) {
    .news-artwork__bottom { flex-direction: column; align-items: stretch; gap: 14px; }
    .news-artwork__year { align-self: flex-end; }
  }
  @media (max-width: 767px) {
    .news-artwork { min-height: 300px; padding: 23px; }
  }
</style>
