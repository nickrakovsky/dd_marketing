---
export interface Props {
  headline: string;
  buttonText?: string;
  eventName: string;
  ctaId?: string;
  redirectUrl: string;
}

const {
  headline,
  buttonText = "Download",
  eventName,
  ctaId = "resource-sidebar",
  redirectUrl,
} = Astro.props;

const BENTO_UUID = "b4cb9a34a989bcc643714151df7b7154";
const uid = Math.random().toString(36).slice(2, 9);
---

<div class="blog-lead-widget sidebar-card mb-4 group/lmf lead-magnet-container !p-5" id={`lmf-${uid}`}>
  <div class="success-message hidden w-full text-center py-2">
    <div class="flex items-center justify-center gap-1 text-green-700 font-bold font-recoleta text-sm">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
      </svg>
      Check your email!
    </div>
    <p class="sidebar-card-snippet mt-2">
      Didn't get it?{" "}
      <a href={redirectUrl} target="_blank" rel="noreferrer" class="sidebar-card-link !mt-0 !inline">
        Download directly
      </a>.
    </p>
  </div>

  <form
    class="lead-magnet-form block w-full"
    data-event={eventName}
    data-lead-capture data-capture-kind="resource"
    data-lead-event={eventName} data-cta-id={ctaId} data-cta-placement="sidebar"
    data-redirect={redirectUrl}
    data-uuid={BENTO_UUID}
  >
    <div class="sidebar-card-title font-bold text-gray-900 dark:text-[color:var(--blog-ink,#fff)] leading-snug mb-3">
      {headline}
    </div>

    <div class="flex flex-col gap-0 mt-3">
      <input
        type="email"
        name="email"
        placeholder="Enter your email"
        required
        class="w-full h-10 px-3 bg-[#FFF8EE] dark:bg-[var(--blog-canvas,#111827)] border border-[#E5D3B3] dark:border-[var(--blog-control,#4b5563)] border-b-0 rounded-none text-sm font-sans placeholder:text-gray-400 focus:border-[#fd4f00] focus:outline-none transition-colors relative z-10 focus:border-b"
      />
      <button
        type="submit"
        class="w-full h-10 bg-[#fd4f00] hover:bg-[#e54700] text-white font-sans font-bold text-sm rounded-none shadow-sm transition-colors cursor-pointer"
      >
        {buttonText}
      </button>
    </div>
  </form>

  <p class="disclaimer-message block text-center text-[10px] text-gray-400 mt-2 font-sans leading-tight">
    You'll also receive occasional updates. Unsubscribe anytime.
  </p>
</div>

<style>
  :global(html.dark[data-blog-theme]) .blog-lead-widget input {
    color: var(--blog-ink);
  }

  :global(html.dark[data-blog-theme]) .blog-lead-widget input::placeholder,
  :global(html.dark[data-blog-theme]) .blog-lead-widget .disclaimer-message {
    color: var(--blog-muted);
  }

  :global(html.dark[data-blog-theme]) .blog-lead-widget button[type="submit"] {
    background: var(--blog-canvas);
    border: 1px solid var(--blog-orange);
    color: var(--blog-ink);
  }

  :global(html.dark[data-blog-theme]) .blog-lead-widget button[type="submit"]:hover {
    background: var(--blog-surface);
    border-color: var(--blog-link);
  }

  :global(html.dark[data-blog-theme]) .blog-lead-widget .success-message > div {
    color: var(--blog-ink);
  }
</style>
