---
interface Props { id?: string; }
const { id = 'post-six-who-decides' } = Astro.props;
const decisions = [
  {
    key: 'first', label: 'First bookings',
    situation: 'You’re introducing appointments for regular pallet deliveries first.',
    manager: 'Choose which deliveries will use bookings first and set the start date. Tell the teams and carriers involved what is changing.',
    supervisors: 'Run through a delivery with the receiving crew. Check who finds the booking, records arrival and tells the driver where to go.',
    support: 'Demonstrate the booking and arrival steps with the team. Help configure the delivery types and booking hours for those loads.',
    finish: 'Introducing bookings changes the carrier’s instructions and the receiving team’s routine, as well as the software setup.'
  },
  {
    key: 'changes', label: 'Booking changes',
    situation: 'A carrier requests 11:00 instead of 10:00. Who can approve the change?',
    manager: 'Decide which booking changes supervisors can approve and which need a manager’s decision.',
    supervisors: 'Check whether 11:00 fits the crew’s workload and other bookings. Give the carrier an answer and update the booking if the change is approved.',
    support: 'Show supervisors how to update a booking. Check that their access allows the changes they are responsible for.',
    finish: 'The decision to accept a new arrival time depends on the work planned for that shift.'
  },
  {
    key: 'cancellation', label: 'Automatic cancellation',
    situation: 'A proposed rule would cancel appointments when required paperwork is missing. Should you turn it on?',
    manager: 'Decide with your colleagues which missing documents should prevent delivery, and who can authorize an exception.',
    supervisors: 'Test the rule against a delivery with missing paperwork. Check whether the load could still be received and what to do if the truck arrives after its appointment is cancelled.',
    support: 'Configure the chosen reminder and cancellation conditions. Demonstrate when each would run and which message the booking contact would receive.',
    finish: 'Decide which deliveries the facility will accept before asking the software to enforce that rule.'
  }
];
const roles = [
  { key: 'manager', label: 'Warehouse manager' },
  { key: 'supervisors', label: 'Shift supervisors' },
  { key: 'support', label: 'DataDocks support' }
] as const;
---
<figure class="p6r not-prose" aria-labelledby={`${id}-title`}>
  <h3 id={`${id}-title`}>Who decides what?</h3>
  <fieldset class="p6r-controls">
    <legend>Choose a situation</legend>
    {decisions.map((item,index) => <label><input type="radio" name={`${id}-decision`} value={item.key} checked={index===0} /><span>{item.label}</span></label>)}
  </fieldset>
  <div class="p6r-situation" aria-live="polite" aria-atomic="true">
    {decisions.map(item => <p class={`p6r-state p6r-${item.key}`}>{item.situation}</p>)}
  </div>
  <div class="p6r-people">
    <svg viewBox="0 0 660 154" fill="none" aria-hidden="true" focusable="false">
      <path class="p6r-link" d="M160 76H260M400 76H500" />
      <path class="p6r-link" d="M169 69L160 76L169 83M251 69L260 76L251 83M409 69L400 76L409 83M491 69L500 76L491 83" />
      <g class="p6r-manager">
        <circle class="p6r-ring" cx="100" cy="76" r="55" />
        <circle class="p6r-line" cx="100" cy="48" r="12" />
        <path class="p6r-line" d="M79 93V80C79 58 121 58 121 80V93M88 74V93M112 74V93" />
        <rect class="p6r-paper p6r-line" x="78" y="91" width="44" height="24" rx="2" />
        <path class="p6r-line" d="M87 98H112M87 105H105" />
      </g>
      <g class="p6r-supervisors">
        <circle class="p6r-ring" cx="330" cy="76" r="55" />
        <circle class="p6r-line" cx="312" cy="57" r="10" />
        <path class="p6r-line" d="M294 101V87C294 66 330 66 330 87V101M302 82V101M322 82V101" />
        <circle class="p6r-line" cx="351" cy="49" r="10" />
        <path class="p6r-line" d="M333 93V79C333 58 369 58 369 79V93M341 74V93M361 74V93" />
      </g>
      <g class="p6r-support">
        <circle class="p6r-ring" cx="560" cy="76" r="55" />
        <rect class="p6r-paper p6r-line" x="531" y="49" width="58" height="43" rx="3" />
        <path class="p6r-line" d="M525 102H595L589 92H531L525 102ZM548 112H572M560 102V112" />
        <circle class="p6r-line" cx="560" cy="67" r="8" />
        <path class="p6r-line" d="M548 78V68C548 50 572 50 572 68V78M548 73H552M568 73H572M568 80H560" />
      </g>
    </svg>
  </div>
  <div class="p6r-actions" aria-live="polite" aria-atomic="true">
    <div class="p6r-roles">
      {roles.map(role => <section>
        <h4>{role.label}</h4>
        {decisions.map(item => <p class={`p6r-state p6r-${item.key}`}>{item[role.key]}</p>)}
      </section>)}
    </div>
    <div class="p6r-agreements">
      {decisions.map(item => <p class={`p6r-agreement p6r-state p6r-${item.key}`}>{item.finish}</p>)}
    </div>
  </div>
</figure>
<style>
  .p6r { --paper:#faf8f5; --ink:#000000; --muted:#5f483a; --rule:#ad9686; --soft:#efe2d2; --accent:#fe5000; box-sizing:border-box; width:100%; max-width:760px; margin:28px auto; padding:24px; border:1px solid var(--rule); border-radius:4px; background:var(--paper); color:var(--ink); font:14px/1.6 Inter,Arial,sans-serif; text-align:left; color-scheme:light; }
  .p6r *, .p6r *::before, .p6r *::after { box-sizing:border-box; }
  .p6r h3 { margin:0 0 18px; color:var(--ink); font:800 clamp(25px,3.8vw,32px)/1.15 Bruta,Inter,Arial,sans-serif; text-transform:uppercase; }
  .p6r-controls { display:flex; flex-wrap:wrap; gap:8px; padding:0; margin:0 0 19px; border:0; min-width:0; }
  .p6r-controls legend { position:absolute; width:1px; height:1px; padding:0; margin:-1px; clip-path:inset(50%); overflow:hidden; }
  .p6r-controls label { display:flex; align-items:center; gap:9px; min-height:44px; padding:9px 12px; border:1px solid var(--rule); border-radius:3px; cursor:pointer; font:inherit; }
  .p6r-controls input { appearance:auto; width:17px; height:17px; flex:0 0 17px; margin:0; accent-color:var(--accent); }
  .p6r-controls label:has(:checked) { border-color:var(--accent); background:var(--soft); }
  .p6r-controls label:has(:focus-visible) { outline:2px solid var(--accent); outline-offset:3px; }
  .p6r-situation { display:grid; }
  .p6r-situation p { grid-area:1/1; margin:0; color:var(--ink); font:inherit; }
  .p6r svg { display:block; width:100%; height:auto; }
  .p6r svg path, .p6r svg rect, .p6r svg circle { stroke-linecap:round; stroke-linejoin:round; }
  .p6r-line { stroke:var(--ink); stroke-width:1.8; }
  .p6r-link { stroke:var(--muted); stroke-width:1.5; }
  .p6r-paper { fill:var(--paper); }
  .p6r-ring { fill:var(--paper); stroke:var(--rule); stroke-width:1.5; stroke-dasharray:4 5; }
  .p6r-roles { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:16px; }
  .p6r-roles section { display:grid; grid-template-rows:auto 1fr; min-width:0; }
  .p6r-roles h4 { grid-area:1/1; margin:0 0 10px; color:var(--ink); font:600 18px/1.3 'DD-Recoleta',Recoleta-Fallback,Georgia,serif; text-align:center; }
  .p6r-roles p { grid-area:2/1; margin:0; color:var(--ink); font:inherit; }
  .p6r-agreements { display:grid; margin-top:20px; padding-top:14px; border-top:1px solid var(--rule); }
  .p6r-agreement { grid-area:1/1; margin:0; color:var(--ink); font:400 17px/1.5 'DD-Recoleta',Recoleta-Fallback,Georgia,serif; }
  .p6r-state { visibility:hidden; }
  .p6r:has(input[value='first']:checked) .p6r-first, .p6r:has(input[value='changes']:checked) .p6r-changes, .p6r:has(input[value='cancellation']:checked) .p6r-cancellation { visibility:visible; }
  .p6r:has(input[value='first']:checked) .p6r-manager .p6r-ring, .p6r:has(input[value='changes']:checked) .p6r-supervisors .p6r-ring, .p6r:has(input[value='cancellation']:checked) .p6r-ring { fill:var(--soft); stroke:var(--accent); stroke-width:2.5; stroke-dasharray:none; }
  :global(html.dark) .p6r, :global(html[data-theme='dark']) .p6r { --paper:#000000; --ink:#fff8ee; --muted:#efe2d2; --rule:#9c806d; --soft:#5f483a; --accent:#fe5000; color-scheme:dark; }
  @media(max-width:520px) { .p6r { padding:19px 15px; margin:24px auto; } .p6r-controls label { padding:9px; } .p6r-roles { grid-template-columns:1fr; gap:14px; } .p6r-roles section { border-top:1px solid var(--rule); padding-top:12px; } .p6r-roles h4 { margin-bottom:4px; text-align:left; } }
  @media print { .p6r { break-inside:avoid; } .p6r-controls { display:none; } }
</style>
