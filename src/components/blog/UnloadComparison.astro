      <path class="uc-floor" d={deck} />
      <g aria-hidden="true"><path class="uc-carton" d="M-4 3H8V43H-4m0 6H8V89H-4"/><path class="uc-seam" d="M2 4v38m0 8v38"/></g>
      <path class="uc-rail" d="M0-3h168l2 3H0zm0 106h168l2-3H0z"/><path class="uc-sill" d="M170 0v100"/>
      {[14,40,66,92,118,144].map(x=><path class="uc-rivet" d={'M'+x+' -2v.6m0 103v.6'}/>)}
    </g>
    <g id="uc-pallet"><rect class="uc-skid" x={-palletLength} y="-20" width={palletLength} height="40" rx=".5"/>
      <path class="uc-carton" d="M-46.5-18.5h21.7v17.7h-21.7zm23.4 0h21.7v17.7h-21.7zm-23.4 19.3h21.7v17.7h-21.7zm23.4 0h21.7v17.7h-21.7z"/>
      <path class="uc-seam" d="M-36-18v16m24-16v16m-24 4v16m24-16v16"/>
      <path class="uc-strap" d="M-48-14H0v2h-48zm0 25H0v2h-48z"/>
    </g>
    <g id="uc-out-pallet">
      <rect class="uc-skid" x="-48" y="-20" width="48" height="40" rx=".5"/>
