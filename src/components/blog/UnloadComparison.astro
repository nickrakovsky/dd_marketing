      <path class="uc-out-mark" d="M-42-15h9v6h-9Z"/>
    </g>
    <g id="uc-frame"><path class="uc-skid" d={frameShape}/><path class="uc-seam" d="M-88-4h85m-85 11h85m-85 19h17"/>
      <path class="uc-steel" d="M-88-16h86v4h-86zm0 28h86v4h-86zm3-24h4l20 23h-4zm24 23 21-23h4l-21 23zm26-22h4l23 22h-5z"/>
      <path class="uc-steel" d="M-89-13h7v43h8v-43h6v48h-21z"/><path class="uc-forks" d="M-.4-10v5m0 10v5"/>
    </g>
    <g id="uc-tines"><path class="uc-tine" d="M-11-10h-42v3.8h42zm0 15h-42v3.8h42z"/></g>
    <g id="uc-long-tines"><path class="uc-tine" d="M-11-10h-76v3.8h76zm0 15h-76v3.8h76z"/></g>
    <g id="uc-truck">
      <path class="uc-rail" d="M-4-18h11v4H-4zm0 32H7v4H-4zm51-30h10v4H47zm0 28h10v4H47z"/>
      <path class="uc-carton" d="M-9-15h47q18 0 22 8V7q-4 8-22 8H-9Z"/><rect class="uc-skid" x="4" y="-12" width="28" height="24" rx="2"/>
      <path class="uc-seam" d="M-10-17v34m20-28v22m15-22v22m14-17h12m-12 5h12"/>
    </g>
    {pallets.map(id=><g id={'uc-load-'+id}><use href="#uc-pallet"/><text class="uc-code" x="-24" y="1">{id}</text></g>)}
  </defs></svg>

  <section class="uc-door-check" aria-label="The load at the doors">
    <div class="uc-door-plans">
      <div>
        <p class="uc-view-label">At the doors</p>
        <svg viewBox="-5 -6 196 112" class="uc-door-svg" aria-hidden="true">
          <use href="#uc-van"/>
          <g transform={'translate('+aboard.frame.x+' '+aboard.frame.y+')'}><use href="#uc-frame"/></g>
          {pallets.map(id=><g transform={'translate('+aboard[id].x+' '+aboard[id].y+')'}><use href={'#uc-load-'+id}/></g>)}
          <path class="uc-route-empty" d="M189 22H165m24 42h-24"/>
          <path class="uc-gauge" d="m169 19-4 3 4 3m0 36-4 3 4 3"/>
        </svg>
        <p>The two pallets at the doors block the forklift.</p>
      </div>
      <div>
        <p class="uc-view-label">With the two door pallets off</p>
        <svg viewBox="-5 -6 196 112" class="uc-door-svg" aria-hidden="true">
          <use href="#uc-van"/>
          <g transform={'translate('+aboard.frame.x+' '+aboard.frame.y+')'}>
            <path class="uc-guide" d={frameShape}/>
            <g transform={'translate('+straightPull+' 0)'}><use href="#uc-frame"/></g>
          </g>
          <g transform={'translate('+aboard.A.x+' '+aboard.A.y+')'}><use href="#uc-load-A"/></g>
          <g transform={'translate('+contactX+' 50)'}><circle class="uc-halo" r="5"/><circle class="uc-ring" r="5"/></g>
        </svg>
        <p>The forks can reach the skid now. The frame’s arm would still catch pallet A.</p>
      </div>
    </div>
  </section>
  <details class="uc-orientation">
    <summary class="dd-disclosure">Could the crew unload the frame on its side?<svg class="dd-chevron" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></summary>
    <div class="uc-profiles">
      {endProfiles.map(({faces,armTip},index)=><div>
        <svg viewBox="-8 -78 101 92" aria-hidden="true" focusable="false">
          <path class="uc-profile-floor" d="M-5 0 52-30 85-20 28 10Z"/>
          {faces.map(({points,skid})=><polygon class={skid?'uc-profile-skid':'uc-profile-steel'} points={points}/>)}
          <g class="uc-arm-marker" transform={'translate('+armTip.join(' ')+')'}>
            {index===1&&<path d="M0 0l-5-6h-8"/>}
            <circle r="1.4"/>
          </g>
        </svg>
        <b>{index?'Frame on its side':'Frame upright'}</b>
        <span>{index?'24 inches across the trailer':'52 inches across the trailer'}</span>
      </div>)}
    </div>
    <p>With the frame upright, the long forks reach both marked supports beneath the skid. On its side, the skid would rest on the narrow ends of its crosspieces, with no marked lift points for the forks.</p>
    <p>The fixed arm makes one side heavier. If the load’s center of gravity passes the edge supporting it during the turn, the frame can roll and pin someone against the trailer wall. A tie-down strap around the frame and skid would roll with them. This dock has no rated equipment to control that turn, so the frame has to come out upright.</p>
  </details>

  <div class="uc-plans">
    <fieldset class="uc-options"><legend>Receiving plan</legend>
      <div class="uc-buttons">{plans.map(([key,label])=><label><input type="radio" name="unload-plan" value={key} checked={key==='defer'}/><span>{label}</span></label>)}</div>
    </fieldset>
    <div class="uc-model" style={'--uc-minutes:'+endOfWindow}>
      {models.map(model=><p class="uc-summary" data-for-plan={model.id}>{model.summary}</p>)}
      <div class="uc-dynamic">
        <div class="uc-control-head">
          <span class="uc-control-label"><label for="uc-time">Drag through the unload</label><span class="uc-scroll-label">Scroll through the unload</span></span>
          <output class="uc-position uc-clock" for="uc-time" aria-hidden="true"></output>
        </div>
        <div class="uc-control">
          <div class="uc-phase-band" aria-hidden="true">
            {timedPlans.map(model=><div data-for-plan={model.id}><div class="uc-phase-segments">
              {model.intervals.map(({phase,start,end})=><i data-kind={phase.kind} style={'width:'+100*(end-start)/endOfWindow+'%'}/>)}
            </div></div>)}
          </div>
          <input id="uc-time" class="uc-range" type="range" min="0" max={endOfWindow} step="any" value="0" aria-label="Minutes since the trailer arrived at 08:00"/>
