---
const plans = [
  ['defer', 'Reschedule the delivery'],
  ['stage', 'Stage all three pallets'],
  ['aboard', 'Rearrange the pallets in the trailer'],
];
type InboundPallet = 'A' | 'B' | 'C';
type Inbound = InboundPallet | 'frame';
type Outbound = 'out-A' | 'out-B' | 'out-C';
type Cargo = Inbound | Outbound;
type P = { x:number; y:number; a:number };
const at = (x:number,y:number,a=0):P => ({x,y,a});
const names: Inbound[] = ['A','B','C','frame'];
const pallets: InboundPallet[] = ['C','B','A'];
const outbound: Outbound[] = ['out-C','out-B','out-A'];
const cargoNames = [...names,...outbound];
// Inch coordinates. Each reference point is the centre of the rear-facing lift
// face; the frame's asymmetric footprint extends 17 inches above its fork line.
const aboard: Record<Inbound,P> = { A:at(108,64), B:at(160,64), C:at(160,22), frame:at(104,21) };
const spots: Record<Inbound,P> = { A:at(229,-24), B:at(229,130), C:at(229,179), frame:at(270,-111) };
const palletLength = 48;
const armLeadingEdge = -68;
const frameShape = `M-90-17H0V17H${armLeadingEdge}V35H-90Z`;
// The two oblique views use the same steel members and skid. Coordinates are
// inches across the frame, back from its projecting end, and above the floor.
type ProfilePoint = [number, number, number];
type BeamFootprint = [number, number][];
const rectangle = (x0:number,y0:number,x1:number,y1:number):BeamFootprint =>
  [[x0,y0],[x1,y0],[x1,y1],[x0,y1]];
const profileMembers: {footprint:BeamFootprint; low:number; high:number; skid:boolean}[] = [];
function addMember(footprint:BeamFootprint, low:number, high:number, skid=false) {
  profileMembers.push({footprint,low,high,skid});
}
for (const x of [2,28]) addMember(rectangle(x,0,x+4,90),0,3,true);
const crossMemberPositions = [15,80];
for (const y of crossMemberPositions) addMember(rectangle(0,y,34,y+5),3,4,true);
for (const x of [1,29]) {
  for (const y of crossMemberPositions) addMember(rectangle(x,y,x+4,y+5),4,20);
  addMember(rectangle(x,2,x+4,88),20,24);
}
addMember(rectangle(5,84,29,88),20,24);
for (const [y0,x0,y1,x1] of [[5,5,25,29],[26,29,47,5],[54,5,77,29]]) {
  const brace:BeamFootprint = [[x0,y0],[x1,y1],[x1,y1+4],[x0,y0+4]];
  addMember(x0<x1 ? brace : brace.reverse(),20,23);
}
// This U-shaped mounting arm bridges one end of the skid and projects 18 inches.
const armLength = 90 + armLeadingEdge;
for (const y of [1,armLength-6]) addMember(rectangle(5,y,52,y+6),19,24);
addMember(rectangle(47,7,52,armLength-6),19,24);

function frameProfile(armUp:boolean) {
  // A quarter turn about the long axis puts the protruding arm overhead.
  // The original 24-inch height is now the width across the trailer.
  const orient = ([x,y,z]:ProfilePoint):ProfilePoint => armUp ? [24-z,y,x] : [x,y,z];
  const project = ([x,y,z]:ProfilePoint) => [0.8*x+0.6*y,0.24*x-0.32*y-0.9165*z];
  const surfaces = profileMembers.flatMap(({footprint,low,high,skid}) => {
    const corners = (z:number) => footprint.map(([x,y]) => orient([x,y,z]));
    const lower = corners(low), upper = corners(high);
    const faces = [upper, [...lower].reverse(), ...lower.map((v,i) => {
      const j = (i+1)%lower.length;
      return [v,lower[j],upper[j],upper[i]];
    })];
    return faces.flatMap(vertices => {
      const points = vertices.map(project);
      const area = points.reduce((sum,[x,y],i) => {
        const [nx,ny] = points[(i+1)%points.length];
        return sum+x*ny-nx*y;
      },0);
      if (area >= 0) return [];
      const depth = vertices.reduce((sum,[x,y,z]) => sum+0.55*x-0.7332*y+0.4*z,0) / vertices.length;
      return [{points:points.map(pt=>pt.join(',')).join(' '),depth,skid}];
    });
  });
  const armTip = project(orient([52,armLength/2,21.5]));
  return {faces:surfaces.sort((a,b)=>a.depth-b.depth),armTip};
}
const endProfiles = [frameProfile(false),frameProfile(true)];
const contactX = aboard.A.x - palletLength;
const straightPull = contactX - (aboard.frame.x + armLeadingEdge);
const d2r=(n:number)=>n*Math.PI/180;
const r2d=(n:number)=>n*180/Math.PI;
const round=(n:number)=>Math.round(n*100)/100;
const faceToAxle = 11;
const dockLine = 308;
// Beyond the right edge of the apron, with even the long forks out of view.
const adjoiningBay = 700;
const outboundDoorY = 140;
const awayFromDoor = -260;
// The rear edge of the trailer is at x=170 when docked. The drawing starts
// at x=-4. Keep the label at the door and fade it over the first visible 36 in.
const trailerAtEdge = -174;
const labelFullyVisible = trailerAtEdge+36;
const outboundSlots: Record<Outbound,P> = {
  'out-C':at(90,outboundDoorY+72), 'out-B':at(90,outboundDoorY+24), 'out-A':at(146,outboundDoorY+72),
};
const startingState = ():Record<Cargo,P> => ({
  ...aboard,'out-A':spots.A,'out-B':spots.B,'out-C':spots.C,
});
const transform=(p:P)=>'translate('+round(p.x)+'px,'+round(p.y)+'px) rotate('+round(p.a)+'deg)';
type Pose = { t:number; truck:P; freight:Record<Cargo,P>; shift:number; inboundTrailerX:number; outboundTrailerX:number };
type Journey = { id:string; points:Pose[]; trace:string; emptyTrace:string; longForks:boolean };
// Keep the actual poses continuous across successive pallet movements. Every
// lane change occurs on the open apron with the whole load beyond the sill.
let truck = at(dockLine,22);
let inboundTrailerX = 0;
let outboundTrailerX = awayFromDoor;
let freight = startingState();
let held:Cargo|null=null;
let carriageOffset=0;
let ticks=0;
let log:Pose[]=[];
let loadedPath:P[]=[];
let emptyPaths:P[][]=[[]];
const copyFreight = () => Object.fromEntries(cargoNames.map(n=>[n,{...freight[n]}])) as Record<Cargo,P>;
function keypoint(p:P, dt:number) {
  ticks+=dt; truck={...p};
  if(held) {
    const a=d2r(p.a);
    freight[held]=at(p.x-faceToAxle*Math.cos(a)-carriageOffset*Math.sin(a),p.y-faceToAxle*Math.sin(a)+carriageOffset*Math.cos(a),p.a);
    loadedPath.push({...p});
  } else emptyPaths[emptyPaths.length-1].push({...p});
  log.push({t:ticks,truck:{...p},freight:copyFreight(),shift:carriageOffset,inboundTrailerX,outboundTrailerX});
}
function drive(p:P) {
  const length=Math.hypot(p.x-truck.x,p.y-truck.y);
  if(length>0) keypoint(p,length);
}
function lineUp(y:number) {
  const from=truck.y, dy=y-from;
  if(Math.abs(dy)<0.01) return;
  const gate=held==='frame'?348:dockLine;
  drive(at(gate,from));
  // Back along two tangent arcs with the steered rear wheels; the truck
  // ends up parallel to its initial heading on a different approach line.
  const radius=Math.max(84,Math.abs(dy)*.61);
  const theta=Math.acos(1-Math.abs(dy)/(2*radius)), dx=2*radius*Math.sin(theta);
  for(let i=1;i<=12;i++){
    const t=i/12, first=t<=.5, a=2*theta*(first?t:1-t);
    const partX=radius*Math.sin(a), partY=Math.sign(dy)*radius*(1-Math.cos(a));
    drive(at(gate+(first?partX:dx-partX),first?from+partY:y-partY,Math.sign(dy)*r2d(a)));
  }
}
function path(points:P[]) {
  return points.map(p=>round(p.x)+','+round(p.y)).join(' ');
}
function startLog(){
  log=[]; ticks=0; loadedPath=[]; emptyPaths=[[]]; keypoint(truck,0);
}
const journeys: Journey[]=[];
function save(id:string,longForks=false) {
  const trace=path(loadedPath), emptyTrace=emptyPaths.filter(p=>p.length>1).map(p=>'M'+path(p)).join(' ');
  journeys.push({id,points:log,trace,emptyTrace,longForks});
}
function bringFrameForklift(key:string) {
  startLog();
  drive(at(dockLine,aboard.frame.y));
  save(key,true);
}
function cargoMove(id:Cargo, target:P, nextLine:number, key:string, changeForklifts=false) {
  startLog();
  const p=freight[id];
  lineUp(p.y); drive(at(p.x+faceToAxle,p.y));
  keypoint(truck,34); held=id; keypoint(truck,28);
  lineUp(target.y); drive(at(target.x+faceToAxle,target.y));
  keypoint(truck,35); held=null; emptyPaths.push([]); keypoint(truck,26);
  if(changeForklifts) {
    // The empty forklift backs away from the freight and leaves the drawing.
    // The other machine enters on its own approach line from the adjoining bay.
    drive(at(adjoiningBay,truck.y));
    keypoint(at(adjoiningBay,nextLine),1);
  } else lineUp(nextLine);
  save(key,id==='frame');
}
function moveOutboundTrailer(departing:boolean) {
  startLog();
  const stops=departing?[labelFullyVisible,trailerAtEdge,awayFromDoor]:[trailerAtEdge,labelFullyVisible,0];
  for(const x of stops) {
    const distance=x-outboundTrailerX;
    if(departing) {
      for(const id of outbound) freight[id]=at(freight[id].x+distance,freight[id].y);
    }
    outboundTrailerX=x;
    keypoint(truck,Math.abs(distance));
  }
  save(departing?'pickup-leaves':'pickup-docks');
}
function releaseInbound(key:string) {
  startLog();
  inboundTrailerX=awayFromDoor;
  for(const id of pallets) freight[id]=at(freight[id].x+inboundTrailerX,freight[id].y);
  keypoint(truck,Math.abs(inboundTrailerX));
  save(key);
}
startLog();save('parked');
moveOutboundTrailer(false);
cargoMove('out-C',outboundSlots['out-C'],spots.B.y,'clear-C');
cargoMove('out-B',outboundSlots['out-B'],spots.A.y,'clear-B');
cargoMove('out-A',outboundSlots['out-A'],aboard.C.y,'clear-A');
moveOutboundTrailer(true);
cargoMove('C',spots.C,aboard.B.y,'stage-C');
cargoMove('B',spots.B,aboard.A.y,'stage-B');
cargoMove('A',spots.A,aboard.frame.y,'stage-A',true);
bringFrameForklift('stage-equipment');
cargoMove('frame',spots.frame,spots.A.y,'receive',true);
cargoMove('A',aboard.A,spots.B.y,'reload-A');
cargoMove('B',aboard.B,spots.C.y,'reload-B');
cargoMove('C',aboard.C,aboard.frame.y,'reload-C');
startLog();save('done');
releaseInbound('stage-leaves');
// A single protected spot is reused. The truck has a five-inch powered
// sideshift from centre. After each stroke the truck leaves the pallet planted,
// clears it, recentres its carriage and approaches on the new pocket line.
freight=startingState(); truck=at(dockLine,22); inboundTrailerX=0; outboundTrailerX=awayFromDoor;
const buffer=spots.A, wallB=at(160,79);
cargoMove('B',buffer,aboard.A.y,'swap-open');
startLog();
for(let stroke=0;stroke<3;stroke++){
  const from=freight.A;
  lineUp(from.y); drive(at(from.x+faceToAxle,from.y)); keypoint(truck,24);
  held='A'; keypoint(truck,18);
  carriageOffset=5; keypoint(truck,60);
  held=null; emptyPaths.push([]); keypoint(truck,22);
  drive(at(dockLine,truck.y)); carriageOffset=0; keypoint(truck,18);
}
lineUp(buffer.y);
save('swap-shift');
cargoMove('B',wallB,aboard.C.y,'swap-return');
cargoMove('C',buffer,aboard.frame.y,'swap-swap',true);
bringFrameForklift('swap-equipment');
cargoMove('frame',spots.frame,buffer.y,'swap-frame',true);
cargoMove('C',aboard.C,aboard.frame.y,'swap-finish');
releaseInbound('swap-leaves');

type Step = { scene:string; end:number; caption:string; hold?:boolean };
type Phase = { label:string; kind:'checks'|'permission'|'pallets'|'equipment'|'frame'|'released'; steps:Step[] };
type Model = { id:'stage'|'aboard'; phases:Phase[]; summary:string; conclusion:string };
const endOfWindow = 180;
const models: Model[] = [
  { id:'stage',
    summary:'The three pallets are for the other warehouse. With the shipper’s permission, our crew takes them off, unloads the frame and puts them back.',
    conclusion:'The receipt shows one frame in three hours. Watch the other customer’s pallets cross the trailer doors twice. Even with a clear path, the crew had to wait for the forklift that could lift the frame.',
    phases:[
      { label:'Check in', kind:'checks', steps:[
        { scene:'parked', end:10, caption:'The driver identifies the three pallets. Receiving asks the operator in the other bay to bring the forklift with the long forks.' },
      ] },
      { label:'Get the shipper’s clearance', kind:'permission', steps:[
        { scene:'parked', end:40, caption:'Dispatch calls the shipper for permission to move the pallets. The driver and receiving lead record the pallet IDs and any visible damage.' },
        { scene:'pickup-docks', end:45, caption:'As the shipper confirms we can move the pallets, the outbound driver backs into the next door for the three cross-strapped pallets.' },
      ] },
      { label:'Clear floor space', kind:'pallets', steps:[
        { scene:'clear-C', end:49, caption:'With both trailers ready, the forklift takes the first outbound pallet across to the pickup and backs out empty.' },
        { scene:'clear-B', end:53, caption:'The second outbound pallet goes alongside the first. Two floor spaces are clear.' },
        { scene:'clear-A', end:57, caption:'The forklift loads the last outbound pallet at the doors, then returns empty to our inbound trailer.' },
        { scene:'pickup-leaves', end:60, caption:'The floor is clear. The outbound driver pulls away with all three pallets.' },
      ] },
      { label:'Stage the pallets', kind:'pallets', steps:[
        { scene:'stage-C', end:68, caption:'The driver checks C as it comes off. Receiving records its condition and where it will wait.' },
        { scene:'stage-B', end:76, caption:'The crew checks B and sets it in the second space. The forklift now has a straight approach to A.' },
        { scene:'stage-A', end:84, caption:'The crew checks A into the last space. The frame’s projecting arm has a clear path.' },
      ] },
      { label:'Prepare the frame lift', kind:'equipment', steps:[
        { scene:'stage-A', hold:true, end:110, caption:'The pallet forks fall short of the skid’s marked supports. The second forklift is still working in the other bay.' },
        { scene:'stage-equipment', end:114, caption:'The second forklift arrives from the other bay. Its long forks can reach the marked supports.' },
        { scene:'stage-equipment', hold:true, end:120, caption:'The operator checks the load chart for the frame’s weight and load center, then confirms where the forks will support the skid.' },
      ] },
      { label:'Receive the frame', kind:'frame', steps:[
        { scene:'receive', end:141, caption:'The long forks support the skid as the operator backs the frame clear of the trailer and lowers it onto the stand.' },
        { scene:'receive', hold:true, end:147, caption:'The frame is on the stand. Receiving checks the projecting arm and the mounting feet for damage.' },
      ] },
      { label:'Reload the pallets', kind:'pallets', steps:[
        { scene:'reload-A', end:154, caption:'The pallet forklift puts A back while its space is still accessible.' },
        { scene:'reload-B', end:161, caption:'B goes back in front of A.' },
        { scene:'reload-C', end:167, caption:'C goes back beside B, ready for the other warehouse.' },
      ] },
      { label:'Release the trailer', kind:'checks', steps:[
        { scene:'done', end:178, caption:'The driver and receiver check the pallet IDs and condition again. The driver secures them and updates dispatch. Receiving signs for the frame alone.' },
        { scene:'stage-leaves', end:endOfWindow, caption:'The driver pulls away with all three pallets for the other warehouse. The frame stays on our stand.' },
      ] },
    ] },
  { id:'aboard',
    summary:'With one clear space on the dock, the crew takes B off and shifts A toward the trailer wall. B goes back on, and C takes its place on the dock.',
    conclusion:'From the office, shifting one pallet sounds like one move. At the dock it took three approaches. The driver left after 2 hours 47 minutes, saving 13 minutes because only one pallet had to go back after the frame came off.',
    phases:[
      { label:'Check in', kind:'checks', steps:[
        { scene:'parked', end:10, caption:'The driver identifies the pallets. Receiving calls the other bay for the forklift with the long forks.' },
      ] },
      { label:'Get the shipper’s clearance', kind:'permission', steps:[
        { scene:'parked', end:45, caption:'The shipper confirms in writing that our crew can rearrange the pallets for the next delivery.' },
      ] },
      { label:'Open a lane', kind:'pallets', steps:[
        { scene:'swap-open', end:53, caption:'The driver and receiver note pallet IDs and condition in case of a claim. B comes out onto the one clear space.' },
      ] },
      { label:'Restow A and B', kind:'pallets', steps:[
        { scene:'swap-open', hold:true, end:54, caption:'With B out of the way, the crew finds pallet A is too heavy to shift by hand.' },
        { scene:'swap-shift', end:65, caption:'The forklift shifts A toward the wall in three approaches. The operator sets the pallet down and backs clear each time.' },
        { scene:'swap-return', end:72, caption:'B goes back in line with A. That frees the only space on the dock.' },
      ] },
      { label:'Clear the frame’s exit', kind:'pallets', steps:[
        { scene:'swap-swap', end:80, caption:'C takes the space B just freed. The forklift can now approach the skid, and the mounting arm can pass A.' },
      ] },
      { label:'Prepare the frame lift', kind:'equipment', steps:[
        { scene:'swap-swap', hold:true, end:110, caption:'The pallet forks fall short of the skid’s marked supports. The crew waits for the second forklift.' },
        { scene:'swap-equipment', end:114, caption:'The second forklift arrives from the other bay with forks long enough to reach the marked supports.' },
        { scene:'swap-equipment', hold:true, end:120, caption:'The operator checks the load chart for the frame’s weight and load center and confirms the skid’s support points.' },
      ] },
      { label:'Receive the frame', kind:'frame', steps:[
        { scene:'swap-frame', end:141, caption:'The second forklift brings the frame out upright and lands it on the stand.' },
        { scene:'swap-frame', hold:true, end:147, caption:'Receiving checks the mounting arm and feet before signing for the frame.' },
      ] },
      { label:'Reload the pallet', kind:'pallets', steps:[
        { scene:'swap-finish', end:154, caption:'The pallet forklift puts C back aboard for the next warehouse.' },
      ] },
      { label:'Release the trailer', kind:'checks', steps:[
        { scene:'swap-finish', hold:true, end:165, caption:'The driver and receiver recheck IDs and pallet condition. The driver secures the new arrangement and confirms it with dispatch.' },
        { scene:'swap-leaves', end:167, caption:'The driver pulls away with the three pallets. The frame stays on the receiving stand.' },
      ] },
      { label:'Door free', kind:'released', steps:[
        { scene:'swap-leaves', hold:true, end:endOfWindow, caption:'The trailer left at 10:47. Receiving can use this door for another delivery.' },
      ] },
    ] },
];
const stepsFor = (model:Model) => model.phases.flatMap(phase=>phase.steps.map(step=>({...step, phase})));
const timedPlans = models.map(model=>{
  let start=0;
  const intervals=model.phases.map(phase=>{
    const end=phase.steps[phase.steps.length-1].end;
    const interval={phase,start,end};
    start=end;
    return interval;
  });
  return {...model,steps:stepsFor(model),intervals};
});
const clockTime = (minute:number) => String(8+Math.floor(minute/60)).padStart(2,'0')+':'+String(minute%60).padStart(2,'0');
const actors = [...cargoNames,'truck','carriage','inboundTrailer','outboundTrailer'] as const;
type Actor = typeof actors[number];
const actorAt = (p:Pose, n:Actor) => n==='truck' ? p.truck : n==='carriage' ? at(0,p.shift) : n==='inboundTrailer' ? at(p.inboundTrailerX,0) : n==='outboundTrailer' ? at(p.outboundTrailerX,0) : p.freight[n];
const deck = 'M0 0H170V100H0Z';
const css:string[] = [];
function addMotion(name:string, frames:{pct:number;rule:string}[]) {
  const kept=frames.filter((f,i)=>i===0 || i===frames.length-1 || f.rule!==frames[i-1].rule || f.rule!==frames[i+1].rule);
  css.push('@keyframes '+name+'{'+kept.map(f=>f.pct+'%{'+f.rule+'}').join('')+'}');
}
for (const model of timedPlans) {
  const steps=model.steps;
  const duration=endOfWindow;
  const moments: { pct:number; pose:Pose }[] = [];
  let start=0;
  for (const [i,step] of steps.entries()) {
    const j=journeys.find(j=>j.id===step.scene)!;
    const last=j.points[j.points.length-1];
    const from=100*start/duration, to=100*step.end/duration;
    const percent=(v:number)=>Math.round(v*100000)/100000;
    if(!step.hold && last.t>0) {
      for(const p of j.points) moments.push({pct:percent(from+(to-from)*p.t/last.t),pose:p});
    } else {
      moments.push({pct:percent(from),pose:last},{pct:percent(to),pose:last});
    }
    if(step.scene==='stage-C') {
      css.push('@keyframes uc-inbound-spots{0%{visibility:hidden}'+percent(from)+'%,100%{visibility:visible}}');
    }
    const cue='uc-'+model.id+'-cue-'+i;
    const keys=(from>0?'0%{visibility:hidden}':'')+percent(from)+'%{visibility:visible}'+
      (i<steps.length-1?percent(to)+'%,100%{visibility:hidden}':'100%{visibility:visible}');
    css.push('@keyframes '+cue+'{'+keys+'}');
    const panel='.uc-figure [data-plan="'+model.id+'"]';
    css.push(panel+' [data-cue="'+i+'"]{--uc-motion:'+cue+';}');
    start=step.end;
  }
  for(const n of actors) {
    if(model.id==='aboard' && (n==='outboundTrailer' || n.startsWith('out-'))) continue;
    addMotion('uc-'+model.id+'-'+n,moments.map(m=>({pct:m.pct,rule:'transform:'+transform(actorAt(m.pose,n))})));
  }
  if(model.id==='stage') {
    addMotion('uc-door-visit',moments.map(({pct,pose})=>{
      const opacity=Math.min(1,Math.max(0,(pose.outboundTrailerX-trailerAtEdge)/(labelFullyVisible-trailerAtEdge)));
      return {pct,rule:'opacity:'+opacity+';visibility:'+(opacity?'visible':'hidden')};
    }));
  }
}
