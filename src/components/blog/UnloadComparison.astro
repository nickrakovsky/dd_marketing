          <div class="uc-scroll" tabindex="0" role="region" aria-label="Scroll through the unload from 08:00 to 11:00"><span></span></div>
        </div>
        <div class="uc-axis" aria-hidden="true">
          <span>08:00</span><span>{clockTime(endOfWindow/2)}</span><span>{clockTime(endOfWindow)}</span>
        </div>
        {timedPlans.map(model=>{
          const staged=model.id==='stage';
          const steps=model.steps;
          const palletSpots=staged?pallets:['A'] as InboundPallet[];
          return <section class="uc-plan-panel" data-plan={model.id} aria-label={plans.find(p=>p[0]===model.id)![1]}>
          <div class="uc-current" aria-live="polite" aria-atomic="true">
            {steps.map((step,i)=><p class="uc-cue" data-cue={i}>
              <strong><i aria-hidden="true" data-kind={step.phase.kind}/>{step.phase.label}</strong>{step.caption}
            </p>)}
          </div>
          <svg viewBox={staged?'-4 -166 584 416':'-4 -166 584 301'} class="uc-scene" aria-hidden="true">
            <path class="uc-apron" d={staged?'M171-165H579V249H171Z':'M171-165H579V134H171Z'}/>
            <g class="uc-actor" data-inbound-trailer="" style={'--uc-motion:uc-'+model.id+'-inboundTrailer'}><use href="#uc-van"/></g>
            {staged&&<g transform={'translate(0 '+outboundDoorY+')'}>
              <g class="uc-actor" data-outbound-trailer="" style="--uc-motion:uc-stage-outboundTrailer">
                <path class="uc-floor" d="M-250 0H170V100H-250Z"/>
                <path class="uc-rail" d="M-250-3H168l2 3h-420zm0 106H168l2-3h-420z"/>
                <path class="uc-sill" d="M170 0v100"/>
              </g>
              <path class="uc-door-jamb" d="M175-5h-5v5m0 100v5h5"/>
              <text x="4" y="-8" class="uc-door-name uc-actor" data-outbound-label="" style="--uc-motion:uc-door-visit">Outbound<tspan class="uc-door-word"> door</tspan></text>
            </g>}
            {palletSpots.map(id=><g transform={'translate('+spots[id].x+' '+spots[id].y+')'}>
              <rect class="uc-space" x="-50" y="-22" width="52" height="44" rx="1"/>
              {staged&&<text x="-58" y="0" class="uc-spot-label uc-cue" style="--uc-motion:uc-inbound-spots">{id}</text>}
            </g>)}
            <g transform={'translate('+spots.frame.x+' '+spots.frame.y+')'}>
              <rect class="uc-stand" x="-93" y="-20" width="96" height="58"/><path class="uc-standmark" d="M-91-16l7-4m75 56 10-7"/>
            </g>
            {steps.map((s,i)=>{
              const j=journeys.find(j=>j.id===s.scene)!;
              return !s.hold&&j.trace&&<g class="uc-cue" data-cue={i}>
                <path class="uc-route-empty" d={j.emptyTrace}/><polyline class="uc-route-load" points={j.id==='swap-shift'?'84,64 84,79':j.trace}/>
              </g>;
            })}
            <g class="uc-actor" data-truck="forklift" style={'--uc-motion:uc-'+model.id+'-truck'}>
              <g class="uc-actor" style={'--uc-motion:uc-'+model.id+'-carriage'}>
                <use href="#uc-tines"/>
                {steps.map((step,i)=>journeys.find(j=>j.id===step.scene)!.longForks&&<g class="uc-cue" data-cue={i}><use href="#uc-long-tines"/></g>)}
              </g><use href="#uc-truck"/>
            </g>
            {staged&&outbound.map(n=><g class="uc-actor" data-cargo={n} style={'--uc-motion:uc-stage-'+n}><use href="#uc-out-pallet"/></g>)}
            {names.map(n=><g class="uc-actor" data-cargo={n} style={'--uc-motion:uc-'+model.id+'-'+n}><use href={n==='frame'?'#uc-frame':'#uc-load-'+n}/></g>)}
          </svg>
          <p class="uc-key"><span><i></i>Loaded forklift</span><span><i></i>Empty forklift</span></p>
        </section>;
        })}
      </div>
      <div class="uc-fallback">
        {timedPlans.map(model=><dl data-for-plan={model.id}>{model.intervals.map(({phase,start,end})=><div>
          <dt>{clockTime(start)+'–'+clockTime(end)}</dt>
          <dd><strong>{phase.label}. </strong>{phase.steps.map(step=>step.caption).join(' ')}</dd>
        </div>)}</dl>)}
      </div>
      {models.map(model=><p class="uc-conclusion" data-for-plan={model.id}>{model.conclusion}</p>)}
    </div>
    <section class="uc-plan-panel" data-plan="defer" aria-label="Reschedule the delivery">
      <p>The frame stays aboard. Dispatch confirms the other warehouse can receive its pallets at noon. Our crew leaves at 11:30, so dispatch books a return appointment for the frame.</p>
    </section>
  </div>
</figure>
