---
const checks = [
  {
    key: 'equipment', label: 'Equipment installed', completed: 'Equipment is installed',
    verify: 'Review its acceptance evidence against the intended work.',
    decision: 'What use and operating restrictions have been accepted?',
    owner: 'Equipment and facilities leads',
    evidence: 'Acceptance record, operating restrictions and maintenance responsibility.',
    href: '#3-layout-and-equipment', link: 'Review the layout and equipment checks',
    icon: 'M5 4v27m26-27v27M4 14h28M4 28h28M9 6h8v8H9zm12 12h7v10h-7z',
  },
  {
    key: 'records', label: 'Opening records loaded', completed: 'Opening records are loaded',
    verify: 'Trace a receipt and dispatch through the stock records, including an exception.',
    decision: 'Do the records follow the intended movement of goods?',
    owner: 'Inventory and operations leads; IT where relevant',
    evidence: 'Transaction trail showing the item, unit, location and exception handling.',
    href: '#4-inventory-and-records', link: 'Review the inventory and records checks',
    icon: 'M5 5h26v26H5zM5 13h26M5 22h26M14 13v18M23 13v18M10 9h16',
  },
  {
    key: 'people', label: 'Team trained', completed: 'The team has attended training',
    verify: 'Have the intended shift team demonstrate the work and escalation for one exception.',
    decision: 'Can the team handle the work and obtain a decision when needed?',
    owner: 'Operations and training leads',
    evidence: 'Observed demonstration, named shift cover and usable escalation contacts.',
    href: '#5-people-and-operating-ownership', link: 'Review the people and ownership checks',
    icon: 'M23 10a5 5 0 1 1-10 0 5 5 0 0 1 10 0ZM8 31v-5a10 10 0 0 1 20 0v5M4 12v9m28-9v9',
  },
];
---

<figure class="not-prose setup-readiness" aria-labelledby="setup-next-title">
  <fieldset>
    <legend id="setup-next-title">What should you verify next?</legend>
    <p class="setup-next-intro">Choose a completed task to find a verification step and the relevant checklist area.</p>
    {checks.map(check => <input class="setup-next-input" type="radio" name="setup-next-check" id={`setup-next-${check.key}`} aria-controls={`setup-result-${check.key}`} aria-describedby={`setup-result-${check.key}`} />)}
    <div class="setup-next-options">
      {checks.map(check => <label for={`setup-next-${check.key}`}><span class="setup-next-indicator" aria-hidden="true"></span>{check.label}</label>)}
    </div>
    <p class="setup-next-placeholder">Select a task above. Each result identifies what to check, who to involve and what evidence to keep.</p>
    <div class="setup-next-results">
      {checks.map(check => (
        <section class:list={['setup-next-result', `result-${check.key}`]} id={`setup-result-${check.key}`} aria-label={`Next check: ${check.label}`}>
          <div class="setup-check-route">
            <div class="setup-route-step">
              <svg class="setup-route-icon" viewBox="0 0 36 36" aria-hidden="true" focusable="false"><path d={check.icon} /></svg>
              <p class="setup-route-label">Completed work</p><p>{check.completed}</p>
            </div>
            <svg class="setup-route-arrow" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M3 12h16m-6-6 6 6-6 6" /></svg>
            <div class="setup-route-step">
              <svg class="setup-route-icon" viewBox="0 0 36 36" aria-hidden="true" focusable="false"><path d="M12 7H7v25h22V7h-5M13 3h10v8H13zM12 17h12M12 23h12M12 28h7" /></svg>
              <p class="setup-route-label">Verify next</p><p>{check.verify}</p>
            </div>
            <svg class="setup-route-arrow" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M3 12h16m-6-6 6 6-6 6" /></svg>
            <div class="setup-route-step">
              <svg class="setup-route-icon" viewBox="0 0 36 36" aria-hidden="true" focusable="false"><path d="M8 4h15l7 7v21H8zM23 4v8h7M16 19a4 4 0 0 1 8 0c0 3-4 3-4 6m0 3v1" /></svg>
              <p class="setup-route-label">Decision informed</p><p>{check.decision}</p>
            </div>
          </div>
          <div class="setup-next-action">
            <p><strong>Arrange this with:</strong> {check.owner}.</p>
            <p><strong>Evidence to keep:</strong> {check.evidence}</p>
            <a href={check.href}>{check.link}<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 20V5m-6 6 6-6 6 6" /></svg></a>
          </div>
        </section>
      ))}
    </div>
  </fieldset>
  <figcaption>Repeat for other completed tasks and carry unresolved prerequisites into the launch review.</figcaption>
</figure>

<style>
  .setup-readiness { --next-ink: #292929; --next-muted: #626262; --next-paper: #fffdf8; --next-panel: #f5f1e8; --next-line: #d8d1c5; --next-orange: #fd4f00; margin: 2rem 0; padding: clamp(1rem, 3vw, 1.5rem); border: 1px solid var(--next-line); border-radius: .75rem; color: var(--next-ink); background: var(--next-panel); font-family: Inter, Arial, sans-serif; container-type: inline-size; }
  fieldset { min-width: 0; margin: 0; padding: 0; border: 0; }
  legend { padding: 0; max-width: 100%; color: var(--next-ink); font-family: 'DD-Recoleta', 'Recoleta-Fallback', Georgia, serif; font-size: 1.5rem; font-weight: 600; line-height: 1.3; }
  .setup-next-intro { margin: .5rem 0 1rem; color: var(--next-muted); font-size: .875rem; line-height: 1.6; }
  .setup-next-input { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .setup-next-options { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: .5rem; }
  .setup-next-options label { display: flex; align-items: center; gap: .5rem; min-height: 3rem; padding: .625rem .75rem; border: 1px solid var(--next-line); border-radius: .375rem; background: var(--next-paper); font-size: .8125rem; line-height: 1.4; font-weight: 600; cursor: pointer; }
  .setup-next-indicator { flex: 0 0 .875rem; width: .875rem; height: .875rem; border: 1.5px solid var(--next-muted); border-radius: 50%; }
  #setup-next-equipment:checked ~ .setup-next-options label[for="setup-next-equipment"], #setup-next-records:checked ~ .setup-next-options label[for="setup-next-records"], #setup-next-people:checked ~ .setup-next-options label[for="setup-next-people"] { border-color: var(--next-orange); box-shadow: inset 0 0 0 1px var(--next-orange); }
  #setup-next-equipment:checked ~ .setup-next-options label[for="setup-next-equipment"] .setup-next-indicator, #setup-next-records:checked ~ .setup-next-options label[for="setup-next-records"] .setup-next-indicator, #setup-next-people:checked ~ .setup-next-options label[for="setup-next-people"] .setup-next-indicator { background: var(--next-orange); border-color: var(--next-orange); box-shadow: inset 0 0 0 3px var(--next-paper); }
  #setup-next-equipment:focus-visible ~ .setup-next-options label[for="setup-next-equipment"], #setup-next-records:focus-visible ~ .setup-next-options label[for="setup-next-records"], #setup-next-people:focus-visible ~ .setup-next-options label[for="setup-next-people"] { outline: 3px solid var(--next-orange); outline-offset: 3px; }
  .setup-next-placeholder { margin: 1rem 0 0; padding: 1rem; border: 1px dashed var(--next-line); border-radius: .375rem; color: var(--next-muted); font-size: .875rem; line-height: 1.6; }
  .setup-readiness:has(.setup-next-input:checked) .setup-next-placeholder { display: none; }
  .setup-next-result { display: none; margin-top: 1.5rem; }
  #setup-next-equipment:checked ~ .setup-next-results .result-equipment, #setup-next-records:checked ~ .setup-next-results .result-records, #setup-next-people:checked ~ .setup-next-results .result-people { display: block; }
  .setup-check-route { display: grid; grid-template-columns: minmax(0,1fr) 1.5rem minmax(0,1fr) 1.5rem minmax(0,1fr); gap: .5rem; }
  .setup-route-step { min-width: 0; text-align: center; }
  .setup-route-icon { display: block; width: 2.75rem; height: 2.75rem; margin: 0 auto .75rem; color: var(--next-ink); }
  .setup-route-arrow { width: 1.5rem; height: 1.5rem; margin-top: .625rem; color: var(--next-orange); }
  .setup-route-icon path, .setup-route-arrow path { fill: none; stroke: currentColor; stroke-width: 1.75; stroke-linecap: round; stroke-linejoin: round; vector-effect: non-scaling-stroke; }
  .setup-route-step p { margin: 0; color: var(--next-ink); font-size: .8125rem; line-height: 1.6; }
  .setup-route-step .setup-route-label { margin: 0 0 .375rem; color: var(--next-muted); font-size: .6875rem; font-weight: 600; line-height: 1.5; text-transform: uppercase; letter-spacing: .04em; }
  .setup-next-action { margin-top: 1.25rem; padding: 1rem; border-left: 3px solid var(--next-orange); background: var(--next-paper); }
  .setup-next-action p { margin: 0 0 .5rem; font-size: .8125rem; line-height: 1.6; }
  .setup-next-action a { display: inline-flex; align-items: center; gap: .5rem; margin-top: .25rem; color: var(--next-ink); font-size: .8125rem; font-weight: 600; line-height: 1.5; text-decoration-line: underline; text-decoration-color: var(--next-orange); text-decoration-thickness: 2px; text-underline-offset: .25em; }
  .setup-next-action a svg { flex: 0 0 1rem; width: 1rem; height: 1rem; fill: none; stroke: var(--next-orange); stroke-width: 1.75; stroke-linecap: round; stroke-linejoin: round; }
  .setup-next-action a:focus-visible { outline: 3px solid var(--next-orange); outline-offset: 4px; }
  figcaption { margin: 1rem 0 0; color: var(--next-muted); font-size: .75rem; line-height: 1.6; }
  :global(.dark) .setup-readiness { --next-ink: #f5f1e8; --next-muted: #c4c0b8; --next-paper: #303030; --next-panel: #252525; --next-line: #575757; }
  @container (max-width: 29rem) {
    .setup-next-options { grid-template-columns: minmax(0,1fr); }
    .setup-check-route { grid-template-columns: minmax(0,1fr); gap: .75rem; }
    .setup-route-step { display: grid; grid-template-columns: 2.75rem minmax(0,1fr); gap: 0 .875rem; text-align: left; }
    .setup-route-icon { grid-column: 1; grid-row: 1 / 3; margin: 0; }
    .setup-route-step .setup-route-label { grid-column: 2; }
    .setup-route-step p:last-child { grid-column: 2; }
    .setup-route-arrow { justify-self: start; margin: 0 0 0 .625rem; transform: rotate(90deg); }
  }
  @media (forced-colors: active) { .setup-next-options label { border: 1px solid ButtonText; } .setup-next-indicator { forced-color-adjust: none; } }
  @media print {
    .setup-next-input, .setup-next-options, .setup-next-placeholder { display: none !important; }
    .setup-next-result { display: block !important; break-inside: avoid; padding-top: 1rem; border-top: 1px solid var(--next-line); }
    .setup-readiness, :global(.dark) .setup-readiness { background: white; color: #292929; --next-ink: #292929; --next-muted: #626262; --next-paper: white; --next-panel: white; --next-line: #d8d1c5; }
    .setup-next-action a svg { display: none; }
  }
</style>
