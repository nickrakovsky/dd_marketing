---
import { Image } from 'astro:assets';
import receivingPhoto from '../../assets/blog-images/warehouse-receiving-damage-record-v1.webp';

const titleId = `receiving-damage-record-${crypto.randomUUID()}`;
---

<figure id="receiving-damage-record" class="receiving-record not-prose" aria-labelledby={titleId}>
  <div class="record-photograph">
    <Image
      src={receivingPhoto}
      alt="A warehouse receiver photographing a crushed carton corner on a pallet with his phone."
      widths={[320, 480, 640, 960, 1280]}
      sizes="(max-width: 640px) calc(100vw - 2rem), 608px"
      loading="lazy"
      class="record-image"
    />
  </div>

  <figcaption class="record-caption">
    <h3 id={titleId}>Document damaged goods so others can follow up</h3>

    <dl class="record-details">
      <div class="record-detail">
        <svg class="record-icon" viewBox="0 0 32 32" width="32" height="32" fill="none" aria-hidden="true" focusable="false">
          <path d="M8 4H20L26 10V28H8V4Z" />
          <path d="M20 4V10H26M12 15H21M12 20H19" />
          <path class="record-icon-accent" d="M4 10V24M2 13H6M2 20H6" />
        </svg>
        <div class="record-detail-copy">
          <dt>Identify the delivery</dt>
          <dd>Link the photos to the delivery reference.</dd>
        </div>
      </div>

      <div class="record-detail">
        <svg class="record-icon" viewBox="0 0 32 32" width="32" height="32" fill="none" aria-hidden="true" focusable="false">
          <path d="M2 18L9 14.5L16 18V25L9 28.5L2 25V18ZM2 18L9 21.5L16 18M9 21.5V28.5" />
          <path d="M16 18L23 14.5L30 18V25L23 28.5L16 25M16 18L23 21.5L30 18M23 21.5V28.5" />
          <path class="record-icon-accent" d="M9 6.5L16 3L23 6.5V14.5L16 18L9 14.5V6.5ZM9 6.5L16 10L23 6.5M16 10V18" />
        </svg>
        <div class="record-detail-copy">
          <dt>Record how much is damaged</dt>
          <dd>Give a count and specify cases or individual units.</dd>
        </div>
      </div>
    </dl>
  </figcaption>
</figure>

<style>
  .receiving-record {
    --record-paper: #fff8ee;
    --record-ink: #302b25;
    --record-muted: #695d4f;
    --record-rule: #e3d5c4;
    --record-orange: #FE5000;
    margin: 1.5rem 0 2rem;
    color: var(--record-ink);
    font-family: Inter, Arial, sans-serif;
    container-type: inline-size;
    scroll-margin-top: 2rem;
  }

  :global(.dark) .receiving-record {
    --record-paper: #241f19;
    --record-ink: #fff2dd;
    --record-muted: #cabba5;
    --record-rule: #514535;
  }

  .record-photograph { overflow: hidden; background: var(--record-rule); }
  .record-image { display: block; width: 100%; height: auto; }

  .record-caption {
    margin: 0;
    padding: 1.375rem 1.5rem 1.5rem;
    border: 1px solid var(--record-rule);
    border-top: 2px solid var(--record-orange);
    background: var(--record-paper);
  }

  .record-caption h3 {
    margin: 0;
    color: var(--record-ink);
    font-family: 'DD-Recoleta', 'Recoleta-Fallback', Georgia, serif;
    font-size: clamp(1.375rem, 4cqi, 1.625rem);
    font-weight: 500;
    line-height: 1.25;
    text-wrap: balance;
  }

  .record-details { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.125rem; margin: 1.125rem 0 0; }
  .record-detail { display: flex; align-items: flex-start; gap: 0.625rem; }
  .record-detail-copy { min-width: 0; }
  .record-icon { flex: 0 0 28px; width: 28px; height: 28px; margin-top: 0.0625rem; stroke: var(--record-muted); stroke-width: 1.4; stroke-linecap: round; stroke-linejoin: round; }
  .record-icon-accent { stroke: var(--record-orange); }
  .record-details dt { margin: 0; color: var(--record-ink); font-size: 0.8125rem; font-weight: 600; line-height: 1.5; }
  .record-details dd { margin: 0.1875rem 0 0; color: var(--record-muted); font-size: 0.75rem; line-height: 1.5; }

  @container (max-width: 430px) {
    .record-caption { padding: 1.125rem 1.125rem 1.25rem; }
    .record-caption h3 { font-size: 1.375rem; }
    .record-details { grid-template-columns: 1fr; gap: 0.875rem; margin-top: 1rem; }
    .record-icon { flex-basis: 26px; width: 26px; height: 26px; }
    .record-details dt { font-size: 0.8125rem; }
  }
</style>
