---
interface Props {
  name: 'Jo' | 'Dev' | 'Ren' | 'Mo';
  note?: string;
  learning?: boolean;
}
const { name, note, learning = false } = Astro.props;
---

<span class:list={['colleague', `colleague-${name.toLowerCase()}`, { 'colleague-lead': name === 'Ren', 'colleague-learning': learning }]}>
  <svg viewBox="0 0 48 62" aria-hidden="true" class="colleague-portrait">
    <ellipse class="portrait-shadow" cx="24" cy="58" rx="19" ry="3" />
    <path class="portrait-shirt" d="M7 54V40c0-9 7-14 17-14s17 5 17 14v14Z" />
    <path class="portrait-vest" d="m16 28 8 12 8-12 5 5v22H11V33Z" />
    <path class="portrait-seam" d="M24 40v15M14 45h20" />
    <rect class="portrait-face" x="19" y="22" width="10" height="10" rx="4" />
    {name === 'Mo' && <circle class="portrait-hair" cx="35" cy="8" r="5.5" />}
    <ellipse class="portrait-face" cx="24" cy="17" rx="11" ry="12" />
    {name === 'Jo' && <>
      <path class="portrait-hair" d="M13 13h4v8l-3-2Zm18 0h4l-1 6-3 2Z" />
      <path class="portrait-headgear" d="M12 14C12 6 17 3 24 3s12 3 12 11l3 1v3H9v-3Z" />
      <path class="portrait-headgear-detail" d="M22 4v9m4-9v9M13 14h22" />
    </>}
    {name === 'Dev' && <path class="portrait-hair" d="M13 19c-3-2-3-6-1-8-2-3 0-6 3-6 0-4 5-5 7-2 2-3 6-3 8 0 4-1 7 2 6 5 3 3 1 7-2 8v4l-3-6c-2 1-4 0-5-2-2 2-5 2-7 0l-3 3-1 5Z" />}
    {name === 'Ren' && <>
      <path class="portrait-hair" d="M13 20C10 9 14 4 20 4l-2 5-3 3v8Zm22 0c3-10-1-15-7-16l2 5 3 3v8Z" />
      <path class="portrait-hair" d="m14 21 4 2 2 3h8l2-3 4-2c-1 6-5 9-10 9s-9-3-10-9Z" />
    </>}
    {name === 'Mo' && <>
      <path class="portrait-hair" d="M13 20C9 12 12 3 23 3s15 7 12 17l-3-4-2-7c-3 5-8 6-14 6l-1 5Z" />
      <path class="portrait-hair-tie" d="m32 7 3 5" />
    </>}
    <path class="portrait-features" d="M20 18h.1M28 18h.1m-6 5q2 1 4 0" />
  </svg>
  <span class="colleague-name">{name}</span>
  {note && <span class="colleague-note">{note}</span>}
</span>

<style>
  .colleague { display: inline-flex; flex-direction: column; align-items: center; width: 64px; flex-shrink: 0; color: var(--team-ink); }
  .colleague-jo { --portrait-skin: #bd865f; --portrait-hair: #362a23; }
  .colleague-dev { --portrait-skin: #86543d; --portrait-hair: #281f1b; }
  .colleague-ren { --portrait-skin: #ddb18d; --portrait-hair: #79746c; }
  .colleague-mo { --portrait-skin: #efc5a9; --portrait-hair: #443025; }
  .colleague-portrait { display: block; width: 43px; height: 56px; overflow: visible; }
  .portrait-shadow { fill: var(--team-rule); }
  .portrait-shirt { fill: var(--team-paper); stroke: var(--team-ink); stroke-width: 1.3; }
  .portrait-vest { fill: var(--team-neutral); stroke: var(--team-ink); stroke-width: 1.3; }
  .colleague-lead .portrait-vest { fill: var(--team-orange); }
  .portrait-face { fill: var(--portrait-skin); stroke: #4d3428; stroke-width: 1.1; }
  .portrait-hair { fill: var(--portrait-hair); }
  .portrait-headgear { fill: #dbb66d; stroke: #5c4930; stroke-width: 1.1; stroke-linejoin: round; }
  .portrait-headgear-detail { fill: none; stroke: #8b6d3a; stroke-width: 1; stroke-linecap: round; }
  .portrait-hair-tie { fill: none; stroke: #dbb66d; stroke-width: 2; stroke-linecap: round; }
  .portrait-seam { fill: none; stroke: var(--team-paper); stroke-width: 2; }
  .portrait-features { fill: none; stroke: #33241d; stroke-width: 1.3; stroke-linecap: round; }
  .colleague-name { font-size: 0.8125rem; font-weight: 650; line-height: 1.4; }
  .colleague-note { color: var(--team-muted); font-size: 0.6875rem; line-height: 1.35; text-align: center; }
  .colleague-learning .portrait-vest { fill: var(--team-paper); stroke-dasharray: 2 2; }
</style>
