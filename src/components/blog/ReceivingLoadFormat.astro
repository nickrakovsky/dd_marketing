---
import ReceivingLoadScene from './ReceivingLoadScene.astro';

const instanceId = `receiving-load-${crypto.randomUUID()}`;
const formats = [
  {
    id: 'palletized-ftl' as const,
    label: 'Palletized FTL',
    insight: 'Pallet count alone doesn’t tell you the sorting workload.',
    confirm: 'Use the supplier’s packing list or ASN for the product breakdown. Clarify pallet grouping with the supplier only where it affects receiving.',
    plan: 'If receiving must sort or rebuild pallets, include that work in the appointment and staging plan.',
  },
  {
    id: 'ltl' as const,
    label: 'LTL',
    insight: 'One LTL arrival can cover several purchase orders.',
    confirm: 'Use the carrier’s shipment references to identify which supplier orders are arriving together.',
    plan: 'Allow time to check quantities against each PO, even when the freight arrives together.',
  },
  {
    id: 'floor-loaded' as const,
    label: 'Floor Loaded',
    insight: 'Unloading and palletizing are separate tasks.',
    confirm: 'Use the supplier’s packing list to gauge carton count and product mix. If an unloading service is involved, check which tasks it covers.',
    plan: 'Include any sorting and pallet-building that falls to your team in the labor and staging plan.',
  },
  {
    id: 'reefer' as const,
    label: 'Reefer',
    insight: 'The reefer setpoint isn’t the product’s temperature.',
    confirm: 'Use the product’s existing receiving specification for temperature limits, arrival checks and any required transit records.',
    plan: 'Make sure receiving knows who handles a temperature exception and where the load should wait while it is assessed.',
  },
  {
    id: 'flatbed' as const,
    label: 'Oversized / Flatbed',
    insight: 'The unloading method can determine where the truck goes.',
    confirm: 'Use the load dimensions, weight and agreed unloading method to choose the receiving position.',
    plan: 'If specialist equipment or a contractor is needed, coordinate their availability with the truck’s arrival window.',
  },
  {
    id: 'container' as const,
    label: 'Shipping Container',
    insight: 'The receiving slot is only one of the container’s deadlines.',
    confirm: 'For ocean freight, use the import or drayage updates to check cargo availability and the applicable last free dates.',
    plan: 'For a dropped container, agree how the carrier will be notified that it is empty and ready for collection.',
  },
];
---

<section id="receiving-load-format" class="load-format not-prose" aria-labelledby={`${instanceId}-title`}>
  <header class="load-heading">
    <h3 id={`${instanceId}-title`}>What changes the receiving plan?</h3>
  </header>

  <fieldset class="load-switcher">
    <legend class="load-visually-hidden">Choose a delivery scenario</legend>
    <div class="load-choices">
      {formats.map((format, index) => (
        <label class="load-choice">
          <input
            type="radio"
            name={instanceId}
            value={format.id}
            checked={index === 0}
            aria-controls={`${instanceId}-${format.id}`}
          />
          <span>{format.label}</span>
        </label>
      ))}
    </div>

    <div class="load-panels">
      {formats.map(format => (
        <section class="load-panel" data-format={format.id} id={`${instanceId}-${format.id}`} aria-label={`${format.label} delivery`}>
          <div class:list={['load-illustration', { 'load-illustration--ltl': format.id === 'ltl' }]}>
            {format.id === 'ltl' && (
              <div aria-hidden="true">
                <span class="load-cargo-label load-cargo-label--other">Goods for other facilities</span>
                <span class="load-cargo-label load-cargo-label--po2"><strong>PO 2</strong><span>Your facility</span></span>
                <span class="load-cargo-label load-cargo-label--po1"><strong>PO 1</strong><span>Your facility</span></span>
              </div>
            )}
            <ReceivingLoadScene format={format.id} idPrefix={`${instanceId}-${format.id}-scene`} />
          </div>
          <div class="load-explanation">
            <h4>{format.insight}</h4>
            <dl class="load-details">
              <div>
                <dt>Before arrival</dt>
                <dd>{format.confirm}</dd>
              </div>
              <div>
                <dt>Receiving plan</dt>
                <dd>{format.plan}</dd>
              </div>
            </dl>
          </div>
        </section>
      ))}
    </div>
  </fieldset>
</section>

<style>
  .load-format {
    --load-paper: #fff8ee;
    --load-surface: #f1e7d6;
    --load-ink: #302b25;
    --load-muted: #695d4f;
    --load-line: #d9cbb8;
    --load-box: #e3cba8;
    --load-box-side: #c6a980;
    --load-wood: #b69a72;
    --load-accent: #FE5000;
    --load-accent-wash: #ffeadc;
    container-type: inline-size;
    margin: 2rem 0;
    border: 1px solid var(--load-line);
    border-radius: 4px;
    background: var(--load-paper);
    color: var(--load-ink);
    font-family: Inter, Arial, sans-serif;
    scroll-margin-top: 2rem;
    overflow: hidden;
  }

  :global(.dark) .load-format {
    --load-paper: #241f19;
    --load-surface: #342c23;
    --load-ink: #fff2dd;
    --load-muted: #cabba5;
    --load-line: #655640;
    --load-box: #b5a082;
    --load-box-side: #8f785b;
    --load-wood: #a38b68;
    --load-accent-wash: #3d2d22;
  }

  .load-heading { padding: 1.5rem 1.5rem 0; }
  .load-heading h3 { margin: 0; color: var(--load-ink); font: 500 clamp(1.5rem, 4.5cqi, 1.875rem)/1.2 'DD-Recoleta', 'Recoleta-Fallback', Georgia, serif; text-wrap: balance; }
  .load-switcher { min-width: 0; margin: 0; padding: 0; border: 0; }
  .load-choices { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.625rem; margin: 1.25rem 1.5rem 0; }
  .load-choice { display: flex; align-items: center; justify-content: center; gap: 0.5rem; min-height: 44px; padding: 0.625rem; border: 1px solid var(--load-line); border-radius: 4px; color: var(--load-ink); font-size: 0.8125rem; font-weight: 500; line-height: 1.4; cursor: pointer; }
  .load-choice:has(input:checked) { border-color: var(--load-accent); background: var(--load-accent-wash); font-weight: 600; }
  .load-choice:has(input:focus-visible) { outline: 2px solid var(--load-accent); outline-offset: 3px; }
  .load-choice input { appearance: none; display: grid; place-content: center; width: 14px; height: 14px; margin: 0; flex-shrink: 0; border: 1px solid var(--load-muted); border-radius: 50%; background: transparent; cursor: pointer; }
  .load-choice input::before { content: ''; width: 6px; height: 6px; border-radius: 50%; background: var(--load-accent); transform: scale(0); }
  .load-choice input:checked { border-color: var(--load-accent); }
  .load-choice input:checked::before { transform: scale(1); }
  @media (forced-colors: active) {
    .load-choice input { appearance: auto; }
    .load-choice input::before { display: none; }
  }
  .load-panels { display: grid; }
  .load-panel { grid-area: 1 / 1; min-width: 0; visibility: hidden; }
  .load-switcher:has(input[value='palletized-ftl']:checked) .load-panel[data-format='palletized-ftl'],
  .load-switcher:has(input[value='ltl']:checked) .load-panel[data-format='ltl'],
  .load-switcher:has(input[value='floor-loaded']:checked) .load-panel[data-format='floor-loaded'],
  .load-switcher:has(input[value='reefer']:checked) .load-panel[data-format='reefer'],
  .load-switcher:has(input[value='flatbed']:checked) .load-panel[data-format='flatbed'],
  .load-switcher:has(input[value='container']:checked) .load-panel[data-format='container'] { visibility: visible; }
  .load-illustration { position: relative; padding: 0.5rem 0.5rem 0; }
  .load-illustration--ltl { margin-top: 0.75rem; padding-top: 2.0625rem; }
  .load-cargo-label { position: absolute; top: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; width: 26%; min-height: 1.875rem; transform: translateX(-50%); color: var(--load-ink); font-size: 0.75rem; line-height: 1.25; text-align: center; }
  .load-cargo-label strong { font-weight: 600; }
  .load-cargo-label--other { left: calc(24% + 0.26rem); width: 32%; color: var(--load-muted); font-weight: 500; }
  .load-cargo-label--po2 { left: calc(55% - 0.05rem); }
  .load-cargo-label--po1 { left: calc(81.8% - 0.318rem); }
  .load-illustration :global(svg) { display: block; width: 100%; height: auto; }
  .load-explanation { margin: 0 1.5rem; padding: 1.25rem 0 1.5rem; border-top: 1px solid var(--load-line); }
  .load-explanation h4 { margin: 0; color: var(--load-ink); font-size: 1.0625rem; font-weight: 600; line-height: 1.45; text-wrap: pretty; }
  .load-details { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.5rem; margin: 1rem 0 0; }
  .load-details dt { color: var(--load-ink); font-size: 0.8125rem; font-weight: 600; line-height: 1.5; }
  .load-details dd { margin: 0.375rem 0 0; color: var(--load-muted); font-size: 0.875rem; line-height: 1.6; text-wrap: pretty; }
  .load-visually-hidden { position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0; overflow: hidden; clip-path: inset(50%); white-space: nowrap; border: 0; }

  @container (max-width: 430px) {
    .load-heading { padding: 1.125rem 1.125rem 0; }
    .load-heading h3 { font-size: 1.5rem; }
    .load-choices { grid-template-columns: repeat(2, minmax(0, 1fr)); margin: 1rem 1.125rem 0; }
    .load-choice { justify-content: flex-start; }
    .load-illustration { padding-inline: 0; }
    .load-cargo-label--other { left: 24%; }
    .load-cargo-label--po2 { left: 55%; }
    .load-cargo-label--po1 { left: 81.8%; }
    .load-explanation { margin: 0 1.125rem; padding: 1rem 0 1.125rem; }
    .load-details { grid-template-columns: 1fr; gap: 0.875rem; }
  }
</style>
