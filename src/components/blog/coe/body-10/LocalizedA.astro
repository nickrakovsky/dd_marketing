---
import './localized.css';
---
<figure class="localized-scene">
  <svg viewBox="0 0 860 390" role="img" aria-label="A simple overhead warehouse illustration places a shared worktable on the operating floor, beside stored goods and a long North American tractor-trailer at the loading dock." xmlns="http://www.w3.org/2000/svg">
    <g stroke="var(--scene-line)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      <!-- An ordinary working site, viewed from above. -->
      <rect x="52" y="51" width="486" height="289" rx="5" fill="var(--scene-panel)" stroke="none" />
      <rect x="64" y="63" width="462" height="265" fill="var(--scene-paper)" stroke="none" />
      <path d="M526 137V63H64v265h462v-91" fill="none" stroke="var(--scene-ink)" stroke-width="3" />
      <path d="M538 137h-23m23 100h-23" fill="none" stroke="var(--scene-ink)" stroke-width="4" />
      <path d="M520 147v80m6-80v80" stroke="var(--scene-line)" />
      <!-- Storage bays leave a generous open working floor. -->
      <g fill="var(--scene-panel)">
        <rect x="91" y="88" width="153" height="49" rx="2" />
        <rect x="91" y="167" width="153" height="49" rx="2" />
        <rect x="91" y="246" width="153" height="49" rx="2" />
      </g>
      <g fill="var(--scene-paper)">
        <rect x="99" y="95" width="36" height="35" rx="1" />
        <rect x="146" y="95" width="36" height="35" rx="1" />
        <rect x="193" y="95" width="43" height="35" rx="1" />
        <rect x="99" y="174" width="45" height="35" rx="1" />
        <rect x="154" y="174" width="35" height="35" rx="1" />
        <rect x="199" y="174" width="37" height="35" rx="1" />
        <rect x="99" y="253" width="36" height="35" rx="1" />
        <rect x="146" y="253" width="36" height="35" rx="1" />
        <rect x="193" y="253" width="43" height="35" rx="1" />
      </g>
      <path d="M117 96v34m47-34v34m51-34v34M121 175v33m50-33v33m46-33v33M117 254v34m47-34v34m51-34v34" fill="none" opacity=".65" />
      <!-- A shared place to work is embedded in the facility, not a remote office. -->
      <rect x="313" y="103" width="112" height="72" rx="13" fill="var(--scene-orange)" stroke="none" />
      <rect x="320" y="110" width="98" height="58" rx="9" fill="var(--scene-paper)" stroke="var(--scene-ink)" />
      <g fill="var(--scene-panel)" stroke="var(--scene-ink)">
        <rect x="331" y="83" width="25" height="16" rx="5" />
        <rect x="380" y="83" width="25" height="16" rx="5" />
        <rect x="331" y="179" width="25" height="16" rx="5" />
        <rect x="380" y="179" width="25" height="16" rx="5" />
      </g>
      <path d="M342 122h47v31h-47z" fill="var(--scene-panel)" />
      <path d="M350 130h13v6h-13zm20 9h11v7h-11zm-7-3 7 3" fill="none" />
      <path d="M397 126v17" stroke="var(--scene-orange)" stroke-width="3" />
      <!-- A pallet and the dock opening connect the work area to material handling. -->
      <rect x="351" y="240" width="65" height="54" rx="2" fill="var(--scene-shade)" />
      <path d="M359 241v52m16-52v52m16-52v52m16-52v52" fill="none" />
      <rect x="357" y="246" width="24" height="20" fill="var(--scene-paper)" />
      <rect x="386" y="246" width="24" height="20" fill="var(--scene-panel)" />
      <rect x="363" y="272" width="41" height="16" fill="var(--scene-paper)" />
      <path d="M369 247v18m29-18v18m-15 8v14" fill="none" />
      <path d="M454 145h43m-43 80h43" fill="none" stroke="var(--scene-orange)" stroke-width="3" />
      <!-- A long trailer and conventional tractor, backed into the loading dock. -->
      <g stroke="var(--scene-ink)">
        <rect x="693" y="171" width="47" height="30" rx="3" fill="var(--scene-shade)" />
        <g fill="var(--scene-ink)" stroke="none">
          <rect x="563" y="151" width="15" height="8" rx="2" />
          <rect x="584" y="151" width="15" height="8" rx="2" />
          <rect x="563" y="213" width="15" height="8" rx="2" />
          <rect x="584" y="213" width="15" height="8" rx="2" />
          <rect x="693" y="157" width="14" height="8" rx="2" />
          <rect x="713" y="157" width="14" height="8" rx="2" />
          <rect x="693" y="207" width="14" height="8" rx="2" />
          <rect x="713" y="207" width="14" height="8" rx="2" />
          <rect x="782" y="163" width="16" height="8" rx="2" />
          <rect x="782" y="201" width="16" height="8" rx="2" />
        </g>
        <rect x="550" y="158" width="160" height="56" rx="3" fill="var(--scene-panel)" />
        <rect x="557" y="165" width="146" height="42" rx="1" fill="var(--scene-paper)" />
        <path d="M581 165v42m24-42v42m24-42v42m24-42v42m24-42v42" fill="none" opacity=".4" />
        <path d="M763 170h26l12 4v24l-12 4h-26z" fill="var(--scene-orange)" />
        <rect x="731" y="161" width="36" height="50" rx="5" fill="var(--scene-orange)" />
        <path d="M750 167v38" fill="none" opacity=".5" />
        <path d="M757 168h7v36h-7z" fill="var(--scene-paper)" />
        <path d="M806 173v26" fill="none" stroke-width="3" />
      </g>
      <path d="M612 288h132m-112 14h92" fill="none" opacity=".4" />
    </g>
  </svg>
</figure>
