---
interface Props { x: number; y: number; highlighted?: boolean; shape?: 'pin' | 'circle' | 'plain'; scale?: number; }
const {x,y,highlighted=false,shape='pin',scale=1}=Astro.props;
---
<g class:list={['map-facility',{highlighted},shape]} transform={`translate(${x} ${y}) scale(${scale})`} aria-hidden="true">
  {shape === 'pin' ? <path class="badge" d="M0 0C-4-9-23-20-23-37a23 23 0 1 1 46 0C23-20 4-9 0 0Z" /> : shape === 'circle' ? <><circle class="badge" cy="-21" r="24" /><path class="stem" d="M0 3v7" /></> : <circle class="anchor" r="3" />}
  <g class="building" transform={shape==='pin'?'translate(-18 -49)':shape==='circle'?'translate(-18 -35)':'translate(-22 -40) scale(1.2)'}>
    <path class="wall" d="M2 27V10L13 4v6l11-6v6h10v17Z" />
    <path class="roof" d="M2 10 13 4v4L2 14Zm11 0 11-6v4l-11 6Z" />
    <path d="M2 27V10L13 4v6l11-6v6h10v17ZM0 27h36M26 27V18h5v9m-5-5h5M6 18h4v4H6Zm9 0h4v4h-4Z" />
  </g>
</g>
<style>
  .map-facility { color:var(--ink,#24211d); }
  .badge { fill:var(--paper,#fff8ee); stroke:var(--line,#9f8d78); stroke-width:1.3; }
  .highlighted .badge { fill:var(--accent,#fe5000); stroke:var(--accent,#fe5000); }
  .building { stroke:currentColor; stroke-width:1.25; stroke-linecap:round; stroke-linejoin:round; fill:none; }
  .wall { fill:var(--paper,#fff8ee); }
  .roof { fill:var(--soft,#e3d5c4); stroke:none; }
  .highlighted .building { color:#24211d; }
  .highlighted .wall { fill:#fff8ee; }
  .highlighted .roof { fill:#ffc395; }
  .stem { stroke:var(--line,#9f8d78); stroke-width:1.5; }
  .highlighted .stem { stroke:var(--accent,#fe5000); }
  .anchor { fill:var(--line,#9f8d78); }
  .highlighted .anchor { fill:var(--accent,#fe5000); }
</style>
