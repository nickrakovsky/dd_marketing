---
/* eslint-disable astro/jsx-a11y/no-redundant-roles -- Preserve list semantics when CSS removes list markers. */
import expertise from './c-v3/expertise.webp';
import pilot from './c-v3/pilot.webp';
import practice from './c-v3/practice.webp';
---

<figure class="coe-cycle" aria-labelledby="coe-cycle-title">
  <figcaption id="coe-cycle-title">A center of excellence brings expertise together, tests ideas in practice and shares the learning.</figcaption>
  <ol class="cycle-stages" role="list">
    <li>
      <div class="scene">
        <img src={expertise.src} width={expertise.width} height={expertise.height} alt="" decoding="async" />
      </div>
      <div class="stage-copy">
        <h3>Bring expertise together</h3>
        <p>Operations, technology and commercial teams tackle the same supply chain problem.</p>
      </div>
    </li>
    <li>
      <div class="scene">
        <img src={pilot.src} width={pilot.width} height={pilot.height} alt="" decoding="async" />
      </div>
      <div class="stage-copy">
        <h3>Put ideas to the test</h3>
        <p>Try a change in a working facility and measure what happens.</p>
      </div>
    </li>
    <li>
      <div class="scene">
        <img src={practice.src} width={practice.width} height={practice.height} alt="" decoding="async" />
      </div>
      <div class="stage-copy">
        <h3>Give other teams a head start</h3>
        <p>Turn the findings into practical guidance other sites can adapt.</p>
      </div>
    </li>
  </ol>
</figure>

<style>
  .coe-cycle {
    --c-ink: var(--ink, #24211d);
    --c-muted: var(--muted, #686054);
    margin: 0;
    padding: 8px 0 10px;
    color: var(--c-ink);
    container-type: inline-size;
  }
  /* Name the figure without adding a fourth visible headline. */
  figcaption { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; border: 0; }
  .cycle-stages { display: grid; grid-template-columns: repeat(3, minmax(0,1fr)); gap: 26px; list-style: none; margin: 0; padding: 0; }
  li { min-width: 0; margin: 0; padding: 0; }
  .scene { margin: 0 -5px 20px; }
  .scene img { display: block; width: 100%; height: auto; border-radius: 0; filter: var(--coe-image-tone, none); }
  h3 { font: 400 23px/1.2 'DD-Recoleta', 'DD-Recoleta', Georgia, serif; margin: 0 0 12px; text-wrap: balance; }
  p { font: 400 14px/1.6 'Inter',sans-serif; margin: 0; color: var(--c-muted); }
  @container (max-width: 490px) {
    .cycle-stages { grid-template-columns: 1fr; gap: 30px; }
    li { display: grid; grid-template-columns: minmax(100px, .8fr) minmax(0, 1.2fr); column-gap: 18px; align-items: center; }
    .scene { margin: 0; }
    h3 { font-size: 22px; text-wrap: initial; margin-bottom: 9px; }
    p { font-size: 14px; }
  }
  @container (max-width: 300px) {
    li { grid-template-columns: 1fr; gap: 12px; }
    .scene { width: 210px; max-width: 100%; margin: 0 auto; }
    .stage-copy { max-width: 270px; }
  }
</style>
