---
import {shifts} from './shifts';
import ShiftIcon from './ShiftIcon.astro';
interface Props { variant: 'a'|'b'|'c'; }
const {variant}=Astro.props;
---
<figure class:list={['maturity',variant]} aria-label="Eight shifts in supply chain center of excellence emphasis. These are interdependent trends rather than a fixed sequence of stages.">
  {variant==='a' ? <>
    <div class="comparison-head" aria-hidden="true"><span>Earlier emphasis</span><span>Growing emphasis</span></div>
    <ol class="comparison">
      {shifts.map(shift=><li>
        <span class="earlier">{shift.earlier}</span>
        <span class="direction"><span class="sr-only">toward</span><svg viewBox="0 0 52 20" aria-hidden="true"><path d="M2 10h45m-6-6 6 6-6 6" /></svg></span>
        <span class="growing">{shift.growing}</span>
      </li>)}
    </ol>
  </> : variant==='b' ? <ol class="cards">
    {shifts.map(shift=><li>
      <div class="card-icon"><ShiftIcon kind={shift.icon} /></div>
      <div class="card-copy"><span class="earlier">{shift.earlier}</span><span class="direction"><span class="sr-only">toward</span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v17m-5-5 5 5 5-5" /></svg></span><span class="growing">{shift.growing}</span></div>
    </li>)}
  </ol> : <div class="explorer">
    <h3 class="explorer-intro">How the CoE’s role evolves</h3>
    {shifts.map((shift,index)=><details open={index===0}>
      <summary>
        <span class="summary-pair"><span class="earlier">{shift.earlier}</span><span class="direction"><span class="sr-only">toward</span><svg viewBox="0 0 30 20" aria-hidden="true"><path d="M2 10h24m-6-6 6 6-6 6" /></svg></span><span class="growing">{shift.growing}</span></span>
        <svg class="disclosure" viewBox="0 0 20 20" aria-hidden="true"><path d="m5 7 5 5 5-5" /></svg>
      </summary>
      <div class="explanation"><span class="detail-icon"><ShiftIcon kind={shift.icon} /></span><p>{shift.detail}</p></div>
    </details>)}
  </div>}
</figure>
<style>
  .maturity { margin:0; color:var(--ink,#24211d); container-type:inline-size; }
  .maturity * { box-sizing:border-box; }
  ol { margin:0; padding:0; list-style:none; }
  .earlier { color:var(--muted,#686054); }
  .growing { color:var(--ink,#24211d); }
  .direction { display:flex; align-items:center; justify-content:center; color:var(--accent,#fe5000); }
  .direction svg,.disclosure { fill:none; stroke:currentColor; stroke-width:1.4; stroke-linecap:round; stroke-linejoin:round; }
  .sr-only { position:absolute; width:1px; height:1px; padding:0; overflow:hidden; clip:rect(0,0,0,0); white-space:nowrap; border:0; }
  .comparison-head { display:grid; grid-template-columns:1fr 1fr; gap:64px; padding:0 21px 14px; font:400 14px/1.5 Inter,Arial,sans-serif; color:var(--muted); }
  .comparison-head span:last-child { color:var(--ink); }
  .comparison { border-top:1px solid var(--line); }
  .comparison li { display:grid; grid-template-columns:1fr 64px 1fr; align-items:center; min-height:65px; padding:13px 21px; border-bottom:1px solid var(--soft); gap:0; }
  .comparison li:nth-child(odd) { background:color-mix(in srgb,var(--soft) 20%,var(--paper)); }
  .comparison .earlier { font:400 17px/1.35 Inter,Arial,sans-serif; }
  .comparison .growing { font:400 23px/1.2 DD-Recoleta,Georgia,serif; }
  .comparison .direction { padding-right:22px; }
  .comparison .direction svg { width:42px; height:20px; }
  .cards { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:14px; }
  .cards li { display:flex; align-items:center; gap:19px; min-height:136px; padding:22px 19px; border:1px solid var(--soft); background:color-mix(in srgb,var(--soft) 15%,var(--paper)); border-radius:5px; }
  .card-icon { flex:0 0 47px; width:47px; }
  .card-copy { display:flex; flex-direction:column; align-items:flex-start; gap:7px; }
  .cards .earlier { font:400 14px/1.4 Inter,Arial,sans-serif; }
  .cards .growing { font:400 23px/1.15 DD-Recoleta,Georgia,serif; }
  .cards .direction svg { width:19px; height:19px; }
  .explorer-intro { margin:0 0 20px; font:400 25px/1.2 DD-Recoleta,Georgia,serif; }
  details { border-bottom:1px solid var(--soft); }
  details:first-of-type { border-top:1px solid var(--line); }
  summary { display:grid; grid-template-columns:minmax(0,1fr) 18px; align-items:center; gap:16px; cursor:pointer; padding:18px 16px; list-style:none; }
  summary::-webkit-details-marker { display:none; }
  summary:focus-visible { outline:2px solid var(--accent); outline-offset:2px; }
  summary:hover { background:color-mix(in srgb,var(--soft) 15%,var(--paper)); }
  .summary-pair { display:grid; grid-template-columns:minmax(0,.95fr) 52px minmax(0,1.05fr); align-items:center; gap:16px; min-width:0; font:500 16px/1.4 Inter,Arial,sans-serif; }
  .summary-pair > :is(.earlier,.growing) { min-width:0; overflow-wrap:break-word; text-wrap:pretty; }
  .summary-pair .earlier { font-weight:400; }
  .summary-pair .direction svg { width:26px; height:20px; }
  .disclosure { flex:0 0 18px; width:18px; height:18px; color:var(--muted); }
  details[open] { background:color-mix(in srgb,var(--soft) 15%,var(--paper)); }
  details[open] .disclosure { transform:rotate(180deg); }
  .explanation { display:flex; gap:17px; align-items:center; padding:0 20px 20px; }
  .detail-icon { flex:0 0 46px; width:46px; }
  .explanation p { margin:0; color:var(--muted); font:400 15px/1.6 Inter,Arial,sans-serif; }
  @container(max-width:480px) {
    .comparison-head { gap:36px; padding:0 12px 12px; font-size:12px; }
    .comparison li { grid-template-columns:1fr 36px 1fr; padding:13px 12px; min-height:68px; }
    .comparison .earlier { font-size:14px; }
    .comparison .growing { font-size:20px; }
    .comparison .direction { padding-right:10px; }
    .comparison .direction svg { width:26px; }
    .cards { gap:10px; }
    .cards li { display:block; min-height:0; padding:16px 13px; }
    .card-icon { width:38px; margin-bottom:15px; }
    .card-copy { gap:8px; }
    .cards .earlier { font-size:13px; min-height:36px; }
    .cards .growing { font-size:20px; }
    .explorer-intro { font-size:23px; }
    summary { padding:16px 12px; gap:12px; }
    .summary-pair { grid-template-columns:minmax(0,.95fr) 36px minmax(0,1.05fr); gap:12px; font-size:14px; }
    .summary-pair .direction svg { width:22px; }
    .explanation { gap:12px; padding:0 12px 18px; align-items:flex-start; }
    .detail-icon { flex-basis:36px; width:36px; }
    .explanation p { font-size:14px; }
  }
</style>
