---
/* eslint-disable astro/jsx-a11y/no-redundant-roles -- Preserve list semantics when CSS removes list markers. */
const { articleContext = false } = Astro.props;
import CompanyIcon from './CompanyIcon.astro';
const functions = [
  { name: 'marketing', label: 'Marketing' },
  { name: 'operations', label: 'Operations' },
  { name: 'technology', label: 'Technology' },
] as const;
const facilities = ['factory', 'warehouse', 'retail'] as const;
---
<figure class="company-diagram" aria-label="A company contains shared services supporting three business units, and a center of excellence with its own marketing, operations and technology teams and reporting structure. Company leadership covers both parts of the organization.">
  <div class="company-boundary">
    <h3 class="leadership">Company leadership</h3>

    <div class="company-branches">
      <section class="wider-business" aria-labelledby="company-a-services">
        <div class="shared-services">
          <h4 id="company-a-services">Shared services</h4>
          <ul class="service-functions" role="list" aria-label="Capabilities shared across the business units">
            {functions.map(team => <li><span class="function-label"><CompanyIcon name={team.name} /><span>{team.label}</span></span></li>)}
          </ul>
        </div>
        <div class="support-connection"><span>supports</span></div>
        <ul class="business-units" role="list" aria-label="Business units supported by shared services">
          {facilities.map((facility, index) => <li><CompanyIcon name={facility} /><span>Business unit {index + 1}</span></li>)}
        </ul>
      </section>

      <section class="coe-boundary" aria-labelledby="company-a-coe">
        <h4 id="company-a-coe">Center of excellence</h4>
        <div class="coe-organization">
          <p class="reporting">Its own reporting structure</p>
          <ul class="coe-teams" role="list" aria-label="Dedicated teams within the center of excellence">
            {functions.map(team => <li><CompanyIcon name={team.name} /><span>{team.label}</span></li>)}
          </ul>
        </div>
      </section>
    </div>
  </div>
  {!articleContext && <figcaption>Its own teams and reporting structure give the CoE room to work independently within the company.</figcaption>}
</figure>

<style>
  .company-diagram {
    --diagram-ink: var(--ink, #24211d);
    --diagram-muted: var(--muted, #686054);
    --diagram-line: var(--line, #9f8d78);
    --diagram-accent: var(--accent, #fe5000);
    --diagram-paper: var(--paper, #fff8ee);
    --diagram-soft: var(--soft, #e3d5c4);
    margin: 0;
    padding: 8px 0 0;
    color: var(--diagram-ink);
    container-type: inline-size;
  }
  .company-diagram *, .company-diagram *::before, .company-diagram *::after { box-sizing: border-box; }
  .company-boundary {
    padding: 22px;
    border: 1.5px solid var(--diagram-line);
    border-radius: 7px;
    background: color-mix(in srgb, var(--diagram-soft) 13%, var(--diagram-paper));
  }
  .leadership {
    position: relative;
    width: fit-content;
    max-width: 100%;
    margin: 0 auto;
    padding: 12px 20px;
    border: 1.5px solid var(--diagram-line);
    border-radius: 4px;
    background: var(--diagram-paper);
    text-align: center;
    font: 400 21px/1.2 'DD-Recoleta', Georgia, serif;
  }
  .leadership::after {
    position: absolute;
    top: 100%;
    left: calc(50% - .75px);
    height: 25px;
    border-left: 1.5px solid var(--diagram-line);
    content: '';
  }
  .company-branches {
    position: relative;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
    margin-top: 24px;
    padding-top: 24px;
  }
  .company-branches::before {
    position: absolute;
    top: 0;
    left: calc(25% - 6px);
    right: calc(25% - 6px);
    border-top: 1.5px solid var(--diagram-line);
    content: '';
  }
  section { position: relative; min-width: 0; }
  section::before {
    position: absolute;
    bottom: 100%;
    left: calc(50% - .75px);
    height: 25px;
    border-left: 1.5px solid var(--diagram-line);
    content: '';
  }
  h4 {
    margin: 0;
    text-wrap: balance;
    font: 400 23px/1.18 'DD-Recoleta', Georgia, serif;
  }
  .shared-services {
    padding: 18px 16px 10px;
    border: 1.5px solid var(--diagram-line);
    border-radius: 4px;
    background: color-mix(in srgb, var(--diagram-soft) 55%, var(--diagram-paper));
    text-align: center;
  }
  .service-functions { margin: 14px 0 0; padding: 0; list-style: none; }
  .service-functions li { padding: 9px 0; border-top: 1px solid color-mix(in srgb, var(--diagram-line) 38%, transparent); font: 400 15px/1.4 'Inter', Arial, sans-serif; }
  .function-label { display: flex; align-items: center; gap: 11px; width: 136px; max-width: 100%; margin: auto; text-align: left; }
  .support-connection {
    position: relative;
    display: grid;
    place-items: center;
    height: 40px;
    margin: 0 auto;
  }
  .support-connection::before { position: absolute; inset: 0 auto 0 50%; border-left: 1.5px dashed var(--diagram-line); content: ''; }
  .support-connection span { position: relative; padding: 2px 7px; background: color-mix(in srgb, var(--diagram-soft) 13%, var(--diagram-paper)); color: var(--diagram-muted); font: 400 14px/1.3 'Inter', Arial, sans-serif; }
  .business-units {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px;
    padding: 21px 0 0;
    margin: 0;
    list-style: none;
  }
  .business-units::before {
    position: absolute;
    top: 0;
    left: calc(16.6667% - 2.667px);
    right: calc(16.6667% - 2.667px);
    border-top: 1.5px dashed var(--diagram-line);
    content: '';
  }
  .business-units li {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 9px;
    align-items: center;
    justify-content: center;
    min-height: 108px;
    padding: 12px 4px;
    border: 1.5px solid var(--diagram-line);
    border-radius: 4px;
    background: var(--diagram-paper);
    text-align: center;
    text-wrap: balance;
    font: 400 clamp(12px, 2.7cqi, 14px)/1.4 'Inter', Arial, sans-serif;
  }
  .business-units li::before {
    position: absolute;
    bottom: 100%;
    left: calc(50% - .75px);
    height: 22px;
    border-left: 1.5px dashed var(--diagram-line);
    content: '';
  }
  .coe-boundary {
    display: grid;
    grid-template-rows: auto 1fr;
    align-self: stretch;
    border: 1.5px solid var(--diagram-accent);
    border-radius: 5px;
    background: color-mix(in srgb, var(--diagram-accent) 7%, var(--diagram-paper));
  }
  .coe-boundary::before { border-color: var(--diagram-accent); }
  .coe-boundary h4 {
    padding: 18px 16px;
    border-bottom: 1px solid color-mix(in srgb, var(--diagram-accent) 40%, transparent);
    border-radius: 4px 4px 0 0;
    background: color-mix(in srgb, var(--diagram-accent) 11%, var(--diagram-paper));
    text-align: center;
    font-size: 25px;
  }
  .coe-organization {
    display: grid;
    grid-template-rows: auto 1fr;
    padding: 18px;
  }
  .reporting {
    margin: 0;
    padding: 0 0 16px;
    color: var(--diagram-ink);
    font: 400 14px/1.45 'Inter', Arial, sans-serif;
  }
  .coe-teams {
    position: relative;
    display: grid;
    grid-template-rows: repeat(3, minmax(44px, 1fr));
    gap: 9px;
    margin: 0;
    padding: 0 0 0 18px;
    list-style: none;
  }
  .coe-teams::before {
    position: absolute;
    top: -10px;
    /* Follow the last row's center as the three equal rows expand. */
    bottom: calc((100% - 18px) / 6);
    left: 0;
    border-left: 1px solid var(--diagram-accent);
    content: '';
  }
  .coe-teams li {
    position: relative;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 9px 10px;
    border: 1px solid color-mix(in srgb, var(--diagram-accent) 45%, var(--diagram-line));
    border-radius: 3px;
    background: var(--diagram-paper);
    font: 400 15px/1.4 'Inter', Arial, sans-serif;
  }
  .coe-teams li::before {
    position: absolute;
    top: 50%;
    right: 100%;
    width: 19px;
    border-top: 1px solid var(--diagram-accent);
    content: '';
  }
  figcaption {
    margin-top: 20px;
    color: var(--diagram-muted);
    text-align: center;
    text-wrap: balance;
    font: 400 14px/1.5 'Inter', Arial, sans-serif;
  }
  @container (max-width: 460px) {
    .company-boundary { padding: 18px 16px; }
    .leadership { width: 100%; margin: 0; font-size: 21px; }
    .leadership::after { display: none; }
    .company-branches { grid-template-columns: minmax(0, 1fr); gap: 24px; margin-top: 24px; padding-top: 0; padding-left: 18px; }
    .company-branches::before { display: none; }
    section::before { left: -18px; top: 24px; bottom: auto; height: 0; width: 18px; border-left: 0; border-top: 1.5px solid var(--diagram-line); }
    .wider-business::after { position: absolute; left: -18px; top: -24px; bottom: -49px; border-left: 1.5px solid var(--diagram-line); content: ''; }
    .coe-boundary::before { left: -19.5px; width: 19.5px; border-top-color: var(--diagram-accent); }
    .shared-services { padding: 16px 16px 8px; }
    .shared-services h4 { font-size: 22px; }
    .business-units { gap: 8px; }
    .business-units li { min-height: 102px; padding: 10px 7px; font-size: 14px; }
    .coe-boundary h4 { padding: 16px; font-size: 25px; }
  }
</style>
