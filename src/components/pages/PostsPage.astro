---
import Layout from "../../layouts/Layout.astro";
import Navigation from "../../components/Navigation.astro";
import Footer from "../../components/Footer.astro";
import CTA from "../../components/home/CTA.astro";
import DemoCapture from "../../components/home-revamp/DemoCapture.astro";
import DailyBlogPreviewBanner from "../../components/preview/DailyBlogPreviewBanner.astro";
import AuthorAvatar from "../../components/home-revamp/AuthorAvatar.astro";
import { Truck, ChartNoAxesCombined, Warehouse, Network, Lightbulb } from "lucide-react";
import { getModularHubData } from "../../lib/wireframe-data";
import { ytThumb } from "../../lib/yt-thumb";
import { Image } from "astro:assets";
import PhoneFrame from "../../components/PhoneFrame.astro";
import ResourceArchive from "../../components/wireframes/ResourceArchive.astro";
import HubShorts from "../../components/wireframes/HubShorts.astro";
import mobileScreenshot from "../../assets/solutionsscreenshots/visibility/appscreenshot-screen.webp";
import desktopScreenshot from "../../assets/solutionsscreenshots/DataDocks-Calendar-Clean.webp";

interface Props {
  previewAsOf?: Date;
}

// A date override is available only to the explicit development preview wrapper.
const previewAsOf = import.meta.env.DEV ? Astro.props.previewAsOf : undefined;

const {
  evergreen1,
  evergreen2,
  evergreen3,
  evergreen4,
  evergreen5,
  evergreen6,
  evergreen7,
  evergreen8,
  evergreen9,
  foundationalGuides,
  latest5Posts,
  founderShorts,
  deepDiveVideos,
  olderResources
} = await getModularHubData(previewAsOf);

const feedTopicIcons: Record<string, typeof Warehouse> = {
  'Facility Operations': Warehouse,
  'Carrier Management': Truck,
  'Supply Chain Strategy': ChartNoAxesCombined,
  'Systems Integration': Network,
};

const title = "Resource Hub: Guides, Checklists & Insights for Operations Teams | DataDocks";
const description = "Comprehensive operational playbooks, dock scheduling guides, warehouse checklists, and founder video deep dives.";
---

<Layout title={title} description={description} noindex={Boolean(previewAsOf)}>
  <link
    rel="stylesheet"
    href="/css/lite-yt-embed.css"
    media="print"
    onload="this.media='all'"
  />
  <script is:inline src="/css/lite-yt-embed.js" defer></script>

  <style is:global>
    .modular-video-embed lite-youtube {
      aspect-ratio: 16 / 9;
      width: 100%;
      max-width: 100%;
      border-radius: 1rem;
    }
  </style>

  {/* 1. MAIN NAVIGATION */}
  <Navigation demoHref="#book-demo" />
  {previewAsOf && <DailyBlogPreviewBanner current="posts" />}

  <main class="min-h-screen bg-[#FFF8EE] text-gray-900 font-sans pb-0">

    {/* 2. HERO H1 (CENTRED, BRAND EDITORIAL STYLE MATCHING LIVE HUB) */}
    <header class="pt-16 pb-12 text-center max-w-5xl mx-auto px-4">
      <h1 class="text-4xl sm:text-5xl md:text-6xl lg:text-[76px] font-bruta uppercase leading-[0.88] tracking-tight">
        <span class="text-[#FE5000]">RESOURCE HUB:</span><br />
        <span class="text-black">Guides, Checklists & Insights<br class="hidden sm:inline" /> for Operations Teams</span>
      </h1>
    </header>

    <section id="start-guides" aria-label="Start with a guide" class="max-w-7xl mx-auto px-4 md:px-8 mb-10 md:mb-16">
      <div class="quick-guides">
        {[evergreen1, evergreen2, evergreen3].map(guide => (
          <a href={guide.url} class="quick-guide group">
            <span class="quick-guide-kicker">{guide.kicker}</span>
            <h2 class="quick-guide-title">{guide.title}</h2>
            <span class="quick-guide-arrow" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </section>

    {/* 4. SPLIT SECTION: SQUARER LATEST INSIGHTS (EQUAL HEIGHT, 0 GAPS, SQUARE HOVER FILL) VS EVERGREEN 4 */}
    <section class="max-w-7xl mx-auto px-4 md:px-8 mb-16">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-stretch">
        {/* Left Column (5/12 width): Squarer Latest Insights block */}
        <div class="lg:col-span-5 flex flex-col h-full">
          <div class="pb-3 border-b-2 border-black">
            <h2 class="font-sans font-bold text-lg md:text-xl text-black">
              Latest Insights
            </h2>
          </div>

          {/* 5 invisible cards of strictly equal height, 0 gap, square hover fill */}
          <div class="flex-1 flex flex-col divide-y divide-black/15">
            {latest5Posts.map((post, idx) => {
              const author = post.author === 'DataDocks' ? 'DataDocks Team' : post.author;
              const TopicIcon = feedTopicIcons[post.topic || ''] || Lightbulb;
              return <a
                href={post.url}
                class="latest-insight flex-1 flex items-center px-4 py-3.5 rounded-none group transition-colors duration-150 hover:bg-black/[0.05]"
              >
                <div class="latest-insight-layout flex items-baseline gap-3.5 w-full">
                  <span class="latest-insight-number font-mono text-sm font-bold text-[#FE5000] shrink-0 w-5">
                    {String(idx + 1).padStart(2, '0')}
                  </span>
                  <div class="latest-insight-body min-w-0 flex-1">
                    <div class="latest-insight-byline">
                      <AuthorAvatar name={author} />
                      <span class="latest-insight-attribution">
                        <span class="latest-insight-author">{author}</span>
                        <span aria-hidden="true">·</span>
                        <time datetime={new Date(post.pubDateValue).toISOString()}>{post.displayDate}</time>
                      </span>
                    </div>
                    <h3 class="latest-insight-title font-sans font-bold text-sm md:text-[15px] text-gray-900 leading-snug group-hover:text-[#FE5000] transition-colors line-clamp-2">
                      {post.title}
                    </h3>
                    <span class="latest-insight-details">
                      {post.topic && <><span class="latest-insight-topic"><TopicIcon size={14} strokeWidth={1.5} aria-hidden="true" /><span>{post.topic}</span></span><span aria-hidden="true">·</span></>}
                      <span class="latest-insight-type">Article</span>
                    </span>
                  </div>
                </div>
              </a>;
            })}
          </div>
        </div>

        {/* Right Column (7/12 width): Most Popular Post (Evergreen 4), smooth hover & matched height */}
        <a
          href={evergreen4.url}
          class="lg:col-span-7 flex flex-col group rounded-xl h-full"
        >
          {evergreen4.cardImage && (
            <div class="w-full h-56 md:h-64 rounded-xl overflow-hidden bg-gray-100 relative shrink-0 block">
              <Image
                src={evergreen4.cardImage}
                alt={evergreen4.cardAlt || evergreen4.title}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out"
                loading="lazy"
                widths={[448, 686, 900, 1200]}
                sizes="(min-width: 1024px) 686px, (min-width: 768px) calc(100vw - 64px), calc(100vw - 32px)"
              />
            </div>
          )}

          <div class="pt-4 flex-1 flex flex-col justify-between">
            <div>
              <div class="text-xs font-mono text-gray-400 mb-1.5 transition-colors duration-200 group-hover:text-gray-600">
                {evergreen4.displayDate}
              </div>

              <h2 class="font-bruta text-2xl md:text-3xl uppercase leading-tight text-black group-hover:text-[#FE5000] transition-colors mb-3">
                {evergreen4.title}
              </h2>

              <p class="text-sm md:text-base text-gray-700 font-recoleta leading-relaxed line-clamp-4 transition-colors duration-200 group-hover:text-black">
                {evergreen4.description}
              </p>
            </div>

            <div class="pt-3 text-xs font-mono text-gray-500 transition-colors duration-200 group-hover:text-gray-900">
              By {evergreen4.author} • {evergreen4.readTime}
            </div>
          </div>
        </a>

      </div>
    </section>

    <HubShorts items={founderShorts} />

    {/* 6. HUGE 'WHY' CTA FULL-WIDTH BANNER (NORMALIZED MARKETING HOOKS, SCALED SCREENSHOTS & CLEAN MOBILE CHASSIS) */}
    <section id="why-datadocks" class="w-full bg-[#EFE2D2] py-10 md:py-20 mb-12 md:mb-20">
      <div class="max-w-7xl mx-auto px-4 md:px-8">
        <div class="why-layout">
            <h2 class="why-heading font-bruta text-3xl sm:text-4xl md:text-5xl lg:text-[54px] uppercase tracking-tight text-black leading-[0.95]">
              Why 10,000 Operations Trust DataDocks
            </h2>

          <div class="why-copy">
            {/* 3 Oversized Icon-Illustrations NEXT TO 3 Normalized Arguments */}
            <div class="space-y-6">

              {/* Argument 1: Tactical and practical (Isometric Jigsaw Puzzle Piece) */}
              <div class="flex items-start gap-5 group">
                <div class="shrink-0 pt-0.5">
                  <svg class="w-14 h-14 text-black shrink-0 transition-transform group-hover:scale-105 duration-300" viewBox="0 0 56 56" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M12 25V33L28 42V34L12 25Z" fill="#C5B4A3" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
                    <path d="M28 42L44 33V25L28 34V42Z" fill="#B2A08F" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
                    <path d="M28 8 L34 11.5 C35 10 36.5 9 38.5 9 C41 9 42.5 11 42 13 C41.5 15 39.5 15.5 38 15 L44 18.5 L38.5 22 C37.5 20.5 35.5 20 33.5 20.5 C31.5 21 30.5 23 31.5 24.5 C32.5 26 34.5 26 36 25 L28 30 L22 26.5 C20.5 27.5 18.5 27.5 17.5 26 C16.5 24.5 17.5 22.5 19.5 22 C21.5 21.5 23 23 24 24.5 L12 18.5 L18 15 C16.5 14.5 14.5 14 14 12 C13.5 10 15 8 17.5 8 C19.5 8 21 9 22 10.5 L28 8Z" fill="#FFF8EE" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
                    <circle cx="28" cy="19" r="2.5" fill="#FE5000"/>
                  </svg>
                </div>
                <div>
                  <h3 class="font-recoleta font-bold text-xl md:text-2xl text-black leading-snug">
                    Tactical and practical
                  </h3>
                  <p class="font-sans text-sm md:text-base text-gray-700 leading-relaxed mt-1">
                    Mandatory POs and pre-verified appointment rules ensure fast driver check-ins and stop gate hold-ups before they start.
                  </p>
                </div>
              </div>

              {/* Argument 2: In depth (Isometric Lightbulb) */}
              <div class="flex items-start gap-5 group">
                <div class="shrink-0 pt-0.5">
                  <svg class="w-14 h-14 text-black shrink-0 transition-transform group-hover:scale-105 duration-300" viewBox="0 0 56 56" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M28 4V8" stroke="#FE5000" stroke-width="2" stroke-linecap="round"/>
                    <path d="M14 10L17 13" stroke="#FE5000" stroke-width="2" stroke-linecap="round"/>
                    <path d="M42 10L39 13" stroke="#FE5000" stroke-width="2" stroke-linecap="round"/>
                    <path d="M28 8C20 8 15 13.5 15 20C15 24 17.5 27.5 20 30.5V36C20 37 20.8 38 21.8 38H34.2C35.2 38 36 37 36 36V30.5C38.5 27.5 41 24 41 20C41 13.5 36 8 28 8Z" fill="#FFF8EE" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
                    <path d="M21 41C21 42 21.8 43 23 43H33C34.2 43 35 42 35 41V38H21V41Z" fill="#D6C7B8" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
                    <path d="M24 46C24 47 25 48 26.5 48H29.5C31 48 32 47 32 46V43H24V46Z" fill="#222222" stroke="currentColor" stroke-width="1.5"/>
                    <line x1="21" y1="38" x2="35" y2="38" stroke="currentColor" stroke-width="1.5"/>
                    <line x1="22" y1="41" x2="34" y2="41" stroke="currentColor" stroke-width="1.5"/>
                    <path d="M25 28V20L28 16L31 20V28" stroke="#FE5000" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                    <circle cx="28" cy="16" r="1.5" fill="#FE5000"/>
                  </svg>
                </div>
                <div>
                  <h3 class="font-recoleta font-bold text-xl md:text-2xl text-black leading-snug">
                    Smart appointment lengths
                  </h3>
                  <p class="font-sans text-sm md:text-base text-gray-700 leading-relaxed mt-1">
                    Duration-based scheduling sets slot lengths by actual load type, smoothing daily dock flow and cutting driver detention.
                  </p>
                </div>
              </div>

              {/* Argument 3: Zero carrier friction (Isometric Shipping Parcel) */}
              <div class="flex items-start gap-5 group">
                <div class="shrink-0 pt-0.5">
                  <svg class="w-14 h-14 text-black shrink-0 transition-transform group-hover:scale-105 duration-300" viewBox="0 0 56 56" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M10 21V36L28 46V31L10 21Z" fill="#E2D6C7" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
                    <path d="M28 31V46L46 36V21L28 31Z" fill="#C5B4A3" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
                    <path d="M28 10L46 20L28 30L10 20L28 10Z" fill="#FFF8EE" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
                    <path d="M10 20L46 20" stroke="currentColor" stroke-width="1.5" stroke-dasharray="2 2"/>
                    <path d="M23 12.8L33 17.2L33 32.8L23 28.4Z" fill="#FE5000" fill-opacity="0.2" stroke="#FE5000" stroke-width="1.5" stroke-linejoin="round"/>
                    <rect x="15" y="27" width="8" height="6" rx="1" transform="skewY(25)" fill="#FFFFFF" stroke="currentColor" stroke-width="1"/>
                    <line x1="17" y1="28.5" x2="21" y2="28.5" transform="skewY(25)" stroke="currentColor" stroke-width="0.8"/>
                    <line x1="17" y1="30.5" x2="21" y2="30.5" transform="skewY(25)" stroke="currentColor" stroke-width="0.8"/>
                    <path d="M36 33L36 29M34 31L36 29L38 31" transform="skewY(-25)" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </div>
                <div>
                  <h3 class="font-recoleta font-bold text-xl md:text-2xl text-black leading-snug">
                    Zero carrier friction
                  </h3>
                  <p class="font-sans text-sm md:text-base text-gray-700 leading-relaxed mt-1">
                    Carriers book directly through self-service links that respect your facility rules, eliminating endless email back-and-forth.
                  </p>
                </div>
              </div>

            </div>


          </div>

          {/* Right Column: Real Software Product Showcase (Desktop Master Calendar + Floating Mobile Chassis) */}
          <div class="why-showcase relative">
            {/* Desktop Browser Window Mockup with Real Master Calendar Screenshot */}
            <div class="showcase-desktop rounded-2xl overflow-hidden shadow-2xl border border-black/15 bg-white relative group/browser">
              {/* Browser Header Bar */}
              <div class="showcase-browser-bar bg-[#E5D7C5] border-b border-black/10 px-3 py-2.5 flex items-center justify-between gap-2">
                <div class="flex gap-2 items-center py-0.5 shrink-0">
                  {/* Red and Yellow are static muted controls */}
                  <div class="w-3 h-3 rounded-full bg-black/20 border border-black/10" aria-hidden="true"></div>
                  <div class="w-3 h-3 rounded-full bg-black/20 border border-black/10" aria-hidden="true"></div>
                  {/* Only Green button is interactive: lights up green when hovering anywhere on the frame, scales when hovered directly */}
                  <button
                    type="button"
                    id="mac-fullscreen-btn"
                    aria-haspopup="dialog"
                    class="group/green p-1.5 -m-1.5 flex items-center justify-center cursor-pointer transition-transform hover:scale-125"
                    title="View full screen (Esc to exit)"
                    aria-label="View desktop screenshot full screen"
                  >
                    <span class="w-3 h-3 rounded-full bg-black/20 border border-black/10 group-hover/browser:bg-[#27C93F] group-hover/browser:border-[#1AAB29] transition-all duration-200 flex items-center justify-center shadow-sm">
                      <svg class="w-1.5 h-1.5 text-black/80 opacity-0 group-hover/browser:opacity-100 transition-opacity duration-200" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7" />
                      </svg>
                    </span>
                  </button>
                </div>
                <div class="showcase-address bg-white/90 rounded-md px-2 py-0.5 text-[11px] font-mono text-gray-500 min-w-0 max-w-[220px] truncate select-none">
                  app.datadocks.com/schedule
                </div>
              </div>

              {/* Static Desktop Screenshot (non-clickable, no bounce-zoom on mouseover) */}
              <div class="relative overflow-hidden bg-white select-none">
                <Image
                  src={desktopScreenshot}
                  alt="DataDocks Live Dock Scheduling Master Calendar"
                  class="w-full h-auto object-cover object-top select-none pointer-events-none"
                  loading="lazy"
                  draggable="false"
                />
              </div>
            </div>

            {/* Floating Smartphone Screen using official PhoneFrame hardware component with real mobile app screenshot */}
            <div class="showcase-phone">
              <PhoneFrame
                src={mobileScreenshot}
                alt="DataDocks Mobile Dock Operations App"
              />
            </div>
            <div class="showcase-mobile-details">
              <p class="showcase-phone-caption">Your dock, wherever you are.</p>
              <a href="/images/DataDocks-Calendar-Clean.webp" data-open-desktop-schedule aria-haspopup="dialog" class="showcase-desktop-link">
                Explore the desktop schedule
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7" /></svg>
              </a>
            </div>
          </div>

            {/* Book a Demo Email Capture (Full-width form spanning the text column above) */}
            <form
              id="demo-banner-form"
              data-demo-capture
              class="why-cta"
            >
              <input
                type="email"
                name="email"
                aria-label="Email address"
                autocomplete="email"
                placeholder="Enter your email"
                class="min-w-0 w-full px-5 bg-white text-black placeholder:text-gray-500 text-base border border-black/20 font-recoleta focus:border-black rounded-none transition-all duration-300 sm:hover:pl-6 sm:focus:pl-6"
                required
              />
              <button
                type="submit"
                class="px-6 bg-black hover:bg-[#FE5000] text-white font-bold transition-colors duration-300 uppercase tracking-wide text-sm sm:text-base font-recoleta whitespace-nowrap rounded-none shrink-0"
              >
                Book a Demo
              </button>
              <p class="capture-status why-capture-status" data-capture-status role="status" aria-live="polite"></p>
            </form>

        </div>
      </div>
    </section>

    {/* 7 & 8. CONNECTED EVERGREEN SECTION: BIG POST 5 (RATIONALIZED CLICKABILITY) + 3 TRICOLOR CARDS */}
    <section class="max-w-7xl mx-auto px-4 md:px-8 mb-16">
      {/* Big Evergreen Post 5: 100% unified clickability and hover response */}
      <a
        href={evergreen5.url}
        class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-12 items-center mb-8 group rounded-xl"
      >
        <div class="aspect-[16/10] w-full rounded-xl bg-gray-100 overflow-hidden relative min-h-[200px]">
          {evergreen5.cardImage && (
            <Image
              src={evergreen5.cardImage}
              alt={evergreen5.cardAlt || evergreen5.title}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              loading="lazy"
            />
          )}
        </div>

        <div class="space-y-3">
          <h2 class="font-bruta text-2xl md:text-4xl uppercase leading-tight text-black group-hover:text-[#FE5000] transition-colors">
            {evergreen5.title}
          </h2>

          <div class="article-meta text-xs font-mono text-gray-500 flex items-center gap-3 transition-colors duration-200 group-hover:text-gray-900">
            <span class="article-meta-author">By {evergreen5.author}</span>
            <span class="article-meta-author-separator" aria-hidden="true">•</span>
            <span class="article-meta-details">
              <span>{evergreen5.displayDate}</span>
              <span aria-hidden="true">•</span>
              <span>{evergreen5.readTime}</span>
            </span>
          </div>

          <p class="text-sm md:text-base text-gray-700 font-recoleta leading-relaxed line-clamp-3 transition-colors duration-200 group-hover:text-black">
            {evergreen5.description}
          </p>
        </div>
      </a>

      {/* 3 Solid Fill Cards: Smooth scale zoom on hover without color shifts (Card 1 Orange, Card 2 Black, Card 3 Warm Sand) */}
      <div id="product-links" class="product-links grid grid-cols-1 md:grid-cols-3 gap-3 md:gap-6">

        {/* Card 1: Official Orange Fill */}
        <a
          href={evergreen6.url}
          class="product-link p-4 md:p-7 rounded-2xl bg-[#FE5000] text-white flex flex-col justify-between hover:scale-[1.03] hover:shadow-xl transition-all duration-300 ease-out group"
        >
          <div>
            <div class="flex items-start justify-between gap-4 mb-2">
              <h3 class="font-bruta uppercase text-xl md:text-2xl leading-tight text-white">
                {evergreen6.title}
              </h3>
              <span class="text-lg transition-transform duration-300 group-hover:translate-x-2 shrink-0 text-white">
                →
              </span>
            </div>
            <p class="text-sm font-recoleta text-white/90 leading-relaxed">
              {evergreen6.description}
            </p>
          </div>
        </a>

        {/* Card 2: Solid Black Fill */}
        <a
          href={evergreen7.url}
          class="product-link p-4 md:p-7 rounded-2xl bg-[#000000] text-white flex flex-col justify-between hover:scale-[1.03] hover:shadow-xl transition-all duration-300 ease-out group"
        >
          <div>
            <div class="flex items-start justify-between gap-4 mb-2">
              <h3 class="font-bruta uppercase text-xl md:text-2xl leading-tight text-white">
                {evergreen7.title}
              </h3>
              <span class="text-lg transition-transform duration-300 group-hover:translate-x-2 shrink-0 text-white">
                →
              </span>
            </div>
            <p class="text-sm font-recoleta text-white/90 leading-relaxed">
              {evergreen7.description}
            </p>
          </div>
        </a>

        {/* Card 3: Warm Sand Neutral Fill */}
        <a
          href={evergreen8.url}
          class="product-link p-4 md:p-7 rounded-2xl bg-[#EFE2D2] text-black border border-black/15 hover:border-black/30 flex flex-col justify-between hover:scale-[1.03] hover:shadow-xl transition-all duration-300 ease-out group"
        >
          <div>
            <div class="flex items-start justify-between gap-4 mb-2">
              <h3 class="font-bruta uppercase text-xl md:text-2xl leading-tight text-black">
                {evergreen8.title}
              </h3>
              <span class="text-lg transition-transform duration-300 group-hover:translate-x-2 shrink-0 text-black">
                →
              </span>
            </div>
            <p class="text-sm font-recoleta text-gray-700 leading-relaxed">
              {evergreen8.description}
            </p>
          </div>
        </a>

      </div>
    </section>

    {/* 9. SPACIOUS, BREATHABLE 'LATEST VIDEO DEEP DIVES FROM NICK' (2 MOST RECENT LONGFORM) */}
    <section class="max-w-7xl mx-auto px-4 md:px-8 mb-16">
      <div class="pb-3 border-b-2 border-black mb-8">
        <h2 class="font-bruta text-2xl md:text-3xl uppercase tracking-tight text-black">
          Latest Video Deep Dives from Nick
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-10">
        {deepDiveVideos.map((video) => (
          <article class="group deep-dive-card cursor-pointer" data-video-id={video.youtubeId}>
            <div class="aspect-video w-full rounded-xl overflow-hidden bg-black modular-video-embed">
              {video.youtubeId && (
                <lite-youtube
                  videoid={video.youtubeId}
