  <script is:inline>
    (function () {
      function attachInteractiveElements() {
        // Trigger deep-dive video playback when clicking anywhere on the card
        document.querySelectorAll('.deep-dive-card').forEach((card) => {
          if (!card.dataset.clickBound) {
            card.dataset.clickBound = 'true';
            card.addEventListener('click', (e) => {
              const yt = card.querySelector('lite-youtube');
              if (!yt || yt.contains(e.target)) return;
              const playBtn = yt.querySelector('.lty-playbtn');
              if (playBtn) {
                playBtn.click();
              } else {
                yt.click();
              }
            });
          }
        });

        // Desktop master calendar screenshot full-screen modal
        attachDesktopScreenshotModal();
      }

      function attachDesktopScreenshotModal() {
        const modal = document.getElementById('desktop-screenshot-modal');
        if (!modal || modal.dataset.bound || typeof modal.showModal !== 'function') return;
        modal.dataset.bound = 'true';
        const viewport = modal.querySelector('[data-schedule-viewport]');
        const image = viewport.querySelector('img');
        const toggle = modal.querySelector('[data-schedule-zoom]');
        const closeButton = modal.querySelector('#close-desktop-screenshot');
        const hint = modal.querySelector('#schedule-view-hint');
        let trigger = null;
        let zoomed = false;
        let previousOverflow = '';
        let drag = null;

        function setZoom(value) {
          zoomed = value;
          image.style.width = zoomed ? Math.max(1600, viewport.clientWidth) + 'px' : '100%';
          viewport.toggleAttribute('data-zoomed', zoomed);
          toggle.textContent = zoomed ? 'Show full week' : 'Zoom to read';
          hint.textContent = zoomed ? 'Swipe, drag or use arrow keys to explore the schedule.' : 'The full week. Zoom in to read appointment details.';
          viewport.scrollTo({ left: 0, top: 0 });
        }
        function openModal(link) {
          if (modal.open) return;
          trigger = link;
          previousOverflow = document.documentElement.style.overflow;
          document.documentElement.style.overflow = 'hidden';
          modal.showModal();
          setZoom(window.matchMedia('(max-width: 639px)').matches);
          closeButton.focus({ preventScroll: true });
        }
        function closeModal() { modal.close(); }
        closeButton.addEventListener('click', closeModal);
        modal.addEventListener('cancel', event => { event.preventDefault(); closeModal(); });
        modal.addEventListener('close', () => {
          document.documentElement.style.overflow = previousOverflow;
          const focusTarget = trigger?.getClientRects().length ? trigger
            : Array.from(document.querySelectorAll('[data-open-desktop-schedule], #mac-fullscreen-btn')).find(link => link.getClientRects().length);
          focusTarget?.focus({ preventScroll: true });
          drag = null;
          viewport.removeAttribute('data-dragging');
        });
        modal.addEventListener('click', event => {
          if (event.target !== modal) return;
          const box = modal.getBoundingClientRect();
          if (event.clientX < box.left || event.clientX > box.right || event.clientY < box.top || event.clientY > box.bottom) closeModal();
        });
        toggle.addEventListener('click', () => setZoom(!zoomed));
        viewport.addEventListener('pointerdown', event => {
          if (!zoomed || event.pointerType !== 'mouse' || event.button !== 0) return;
          drag = { id: event.pointerId, x: event.clientX, y: event.clientY, left: viewport.scrollLeft, top: viewport.scrollTop };
          viewport.setPointerCapture(event.pointerId);
          viewport.setAttribute('data-dragging', '');
        });
        viewport.addEventListener('pointermove', event => {
          if (!drag || drag.id !== event.pointerId) return;
          viewport.scrollLeft = drag.left + drag.x - event.clientX;
          viewport.scrollTop = drag.top + drag.y - event.clientY;
        });
        const stopDrag = () => { drag = null; viewport.removeAttribute('data-dragging'); };
        viewport.addEventListener('pointerup', stopDrag);
        viewport.addEventListener('pointercancel', stopDrag);
        viewport.addEventListener('lostpointercapture', stopDrag);
        document.addEventListener('click', event => {
          if (!(event.target instanceof Element)) return;
          const link = event.target.closest('[data-open-desktop-schedule], #mac-fullscreen-btn');
          if (!link || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey || event.button !== 0) return;
          event.preventDefault();
          openModal(link);
        });
      }

      attachInteractiveElements();
      document.addEventListener('astro:page-load', attachInteractiveElements);


    })();
  </script>
