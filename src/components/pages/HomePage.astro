  .heading-accent { color: var(--orange); }
  .hero-form { width: 100%; max-width: 470px; scroll-margin-top: 30px; }
  .hero-form-fields { display: flex; align-items: stretch; }
  .hero-form input { min-width: 0; width: 100%; height: 54px; background: #EFE2D2; color: #000; padding: 12px 16px; font: 18px 'DD-Recoleta', Georgia, serif; border: 1px solid #cdbda8; border-right: 0; border-radius: 0; }
  .hero-form button { flex-shrink: 0; min-height: 54px; background: #FE5000; color: #fff; padding: 10px 16px; font: 400 1.2rem/1.3 'DD-Recoleta', Georgia, serif; letter-spacing: .025em; text-shadow: 0 1px 2px #0006; white-space: nowrap; border: 0; border-radius: 0; }
  .hero-form button:hover { background: #000; text-shadow: none; }
  .hero-form button:disabled { opacity: .75; cursor: wait; }
  .hero-form input:focus-visible, .hero-form button:focus-visible { outline: 2px solid #000; outline-offset: 3px; }
  .hero-form input::placeholder { color: #65533d; opacity: 1; }

  /* Preview: calendar starts at (182,160); width 981 includes Monday–Thursday.
