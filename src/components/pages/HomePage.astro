---
import Layout from '../../layouts/Layout.astro';
import Footer from '../../components/Footer.astro';
import Navigation from '../../components/Navigation.astro';
import CTA from '../../components/home/CTA.astro';
import DemoCapture from '../../components/home-revamp/DemoCapture.astro';
import Clients from '../../components/home/Clients.astro';
import CustomerQuotes from '../../components/home-revamp/CustomerQuotes.astro';
import AuthorAvatar from '../../components/home-revamp/AuthorAvatar.astro';
import DailyBlogPreviewBanner from '../../components/preview/DailyBlogPreviewBanner.astro';
import { isPublished } from '../../lib/content-status';
import { getFeaturedEvergreenPost } from '../../lib/evergreen-content';
import interFont from '../../assets/fonts/Inter-Latin-Variable.woff2';
const calendar = { src: '/images/DataDocks-Calendar-Screenshot.webp', width: 2000, height: 717 };
import { ytThumb } from '../../lib/yt-thumb';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { rawTestimonials } from '../../data/testimonials';
import { CalendarCheck2, Truck, ChartNoAxesCombined, Warehouse, Network, Lightbulb } from 'lucide-react';

interface Props {
  previewAsOf?: Date;
}

// Only the explicit development preview wrapper supplies this prop.
// Normal page URLs and query parameters always use the real publication date.
const previewAsOf = import.meta.env.DEV ? Astro.props.previewAsOf : undefined;
const asOf = previewAsOf ?? new Date();

// Shared by the canonical homepage and its development-only publication preview.
const comparisonUrl = 'https://datadocks.com/comparison';
const videoId = 'VpQigBObIlI';
const stages = [
  {
    number: '01', when: 'A SCHEDULE THAT FITS YOUR OPERATION', title: 'You set the rules.',
    copy: 'Carriers book their own appointments within your capacity limits and booking rules. Collect the load details your team needs during booking, so they can prepare before the truck reaches the gate.',
    links: [{ label: 'Carrier self-scheduling', href: '/datadocks-features/carrier-portal' }, { label: 'Dock capacity management', href: '/datadocks-features/capacity-limits' }, { label: 'Automated scheduling rules', href: '/datadocks-features/custom-rules' }, { label: 'Appointment validation', href: '/datadocks-features/data-validation' }],
    icon: CalendarCheck2,
  },
  {
    number: '02', when: 'YOUR TEAM STAYS ONE STEP AHEAD', title: 'Keep sight of every load.',
    copy: 'See what has arrived, what is loading and where trailers are waiting. Coordinate yard moves, track dock progress and keep your team and carriers up to date as plans change.',
    links: [{ label: 'Yard visibility & jockey orders', href: '/datadocks-features/yard-management' }, { label: 'Live dock dashboard', href: '/datadocks-features/dock-dashboard' }, { label: 'Alerts & notifications', href: '/datadocks-features/notifications' }, { label: 'Mobile companion app', href: '/datadocks-features/access-anywhere' }],
    icon: Truck,
  },
  {
    number: '03', when: 'MAKE INFORMED DECISIONS', title: 'Put your data to work.',
    copy: 'Keep documents and inspection records with each load. Connect your systems, review detention and carrier performance, investigate delays and get answers from your operation’s data.',
    links: [{ label: 'QC & documentation', href: '/datadocks-features/documentation' }, { label: 'WMS & TMS integrations', href: '/datadocks-features/integration' }, { label: 'Detention & performance reports', href: '/datadocks-features/efficiency-reports' }, { label: 'AI logistics assistant', href: '/datadocks-features/ai-assistant' }],
    icon: ChartNoAxesCombined,
  },
];
const [allPosts, allVideos] = await Promise.all([getCollection('posts'), getCollection('videos')]);
const publishedPosts = allPosts
  .filter(post => isPublished(post.data.pubDate, asOf) && post.data.priority !== 'Hidden')
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
const featuredPost = getFeaturedEvergreenPost(allPosts, asOf);
const allResources: Array<CollectionEntry<'posts'> | CollectionEntry<'videos'>> = [...publishedPosts, ...allVideos];
const reading = allResources
  .filter(post => post !== featuredPost && isPublished(post.data.pubDate, asOf))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 5);
const postDate = new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
const feedTopicIcons: Record<string, typeof Warehouse> = {
  'Facility Operations': Warehouse,
  'Carrier Management': Truck,
  'Supply Chain Strategy': ChartNoAxesCombined,
  'Systems Integration': Network,
};
const benefits = [
  { title: 'See everything', href: '/benefits/see-everything', image: 'Managers-Office-500.webp', alt: 'Manager overlooking the dock and yard' },
  { title: 'Increase capacity', href: '/benefits/increase-capacity', image: 'ed60b008d9aeacd6d851628506ef7e44_Warehouse-Interior-p-500.webp', alt: 'Warehouse with organised cargo' },
  { title: 'Delight carriers', href: '/benefits/delight-carriers', image: 'Dock-Interior-500.webp', alt: 'Loading dock interior' },
  { title: 'Digitize operations', href: '/benefits/digitize-operations', image: 'Dock-Exterior-500.webp', alt: 'Trucks at warehouse loading docks' },
];
const faqs = [
  { question: 'Can it work the way our facility works?', answer: 'Set booking rules, capacity limits and required information around your load types and carriers. Collect the details your team needs before arrival, with room to manage exceptions when the day does not go to plan.' },
  { question: 'What does getting started involve?', answer: 'Our team helps configure your facility and onboard your staff and carriers. We work through your scheduling process with you, including the details that make your operation different.' },
  { question: 'Will it connect to our existing systems?', answer: 'DataDocks connects with WMS, TMS and ERP systems through APIs. We can help you work out which information needs to move between your systems and what the setup involves.' },
  { question: 'How is DataDocks priced?', answer: 'Talk to us for a quote based on your facility and requirements. A demo is a chance to work through your process, check the fit and understand the cost.' },
  { question: 'What is the difference between dock scheduling and yard management?', answer: 'Dock scheduling organises when trucks arrive and which door they use. Yard management tracks trailers on site and coordinates their movements. DataDocks connects the schedule with what is happening in your dock and yard.' },
  { question: 'Can carriers book their own appointments?', answer: 'Yes. Carriers book through your portal within the capacity limits and scheduling rules you set. Required fields help your team get the load details it needs before arrival.' },
  { question: 'How will people know when plans change?', answer: 'Automated notifications keep carriers and your team informed when appointments change. The shared schedule and live dock dashboard show the current status of the work.' },
  { question: 'Can our team use it away from a desk?', answer: 'The mobile app gives your team access to schedules, status updates and documentation from the dock floor and yard.' },
];
---

<Layout title="Dock Scheduling & Yard Management for Your Working Day | DataDocks" description="Plan arrivals, keep your dock and yard moving, and give your team one shared view. Dock scheduling and yard management built around your operation." noindex={Boolean(previewAsOf)} schemaData={{ faq: faqs, reviews: rawTestimonials.map(item => ({ author: item.author, quote: item.quote })) }} preloadImages={[
  /* Values below must stay character-for-character identical to the <source>/<img> pair
     in the hero <picture> further down this file, or Chrome treats the preload as a
     different resource from the one actually used and double-fetches the hero image. */
  { href: '/images/DataDocks-Calendar-Screenshot-mobile-749x540.webp', media: '(max-width: 960px)' },
  { imagesrcset: '/images/03f3c54fa64b3930f66a0bc62b3bc6f3_DataDocks-Calendar-Screenshot-p-800.webp 800w, /images/03f3c54fa64b3930f66a0bc62b3bc6f3_DataDocks-Calendar-Screenshot-p-1080.webp 1080w, /images/03f3c54fa64b3930f66a0bc62b3bc6f3_DataDocks-Calendar-Screenshot-p-1600.webp 1600w, /images/DataDocks-Calendar-Screenshot.webp 2000w', imagesizes: '(max-width: 600px) 900px, 1280px', media: '(min-width: 961px)' },
]}>
  <Fragment slot="head">
    <style is:inline set:html={`
      @font-face { font-family: 'Inter'; src: url('${interFont}') format('woff2'); font-style: normal; font-weight: 400 700; font-display: swap; }
    `} />
    <link rel="stylesheet" href="/css/lite-yt-embed.css" media="print" onload="this.media='all'" />
    <script is:inline src="/css/lite-yt-embed.js" defer></script>
  </Fragment>

  <a class="skip-link" href="#main-content">Skip to content</a>
  <Navigation demoHref="#book-demo" featuresHref="#features" />
  {previewAsOf && <DailyBlogPreviewBanner current="home" />}
  <div class="revamp">

    <main id="main-content">
      <section class="hero wrap" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="eyebrow">DOCK SCHEDULING + YARD MANAGEMENT</p>
          <h1 id="hero-title">YOUR OPERATIONS.<br /><span>UNDER CONTROL.</span></h1>
          <p class="hero-description">Let carriers book within your rules. Keep appointments, yard activity and your team in sync, with less time spent chasing updates.</p>
          <div class="hero-actions">
            <form id="book-demo" class="hero-form" data-demo-capture>
              <label class="sr-only" for="hero-email">Email address</label>
              <div class="hero-form-fields"><input id="hero-email" type="email" name="email" autocomplete="email" placeholder="Enter your email" required /><button type="submit">Book a Demo</button></div>
              <p class="capture-status" data-capture-status role="status" aria-live="polite"></p>
            </form>
            <a class="watch-link" href="#customer-story" data-play-customer-story><span class="play-circle" aria-hidden="true"><svg width="10" height="12" viewBox="0 0 10 12" fill="currentColor"><path d="m1 1 8 5-8 5z" /></svg></span> Watch a customer story</a>
          </div>
        </div>
        <figure class="product-figure">
          <a class="product-window" href={calendar.src} data-screenshot-zoom aria-label="Enlarge the DataDocks schedule screenshot">
            <picture>
              {/* At <=960px .product-window is a 749x540 crop window (see the matching @media
                  rule below): the base image only ever shows this rectangle, zoomed in via
                  transform. Serving that exact crop pre-rendered means the browser downloads
                  ~55 KB of already-correct pixels instead of 104-140 KB it would otherwise
                  scale/crop client-side -- and it's sharper, not blurrier, since the crop
                  supplies its full native resolution for the same on-screen box. */}
              <source media="(max-width: 960px)" srcset="/images/DataDocks-Calendar-Screenshot-mobile-749x540.webp" />
              <img src={calendar.src} srcset="/images/03f3c54fa64b3930f66a0bc62b3bc6f3_DataDocks-Calendar-Screenshot-p-800.webp 800w, /images/03f3c54fa64b3930f66a0bc62b3bc6f3_DataDocks-Calendar-Screenshot-p-1080.webp 1080w, /images/03f3c54fa64b3930f66a0bc62b3bc6f3_DataDocks-Calendar-Screenshot-p-1600.webp 1600w, /images/DataDocks-Calendar-Screenshot.webp 2000w" sizes="(max-width: 600px) 900px, 1280px" alt="DataDocks weekly calendar showing truck appointments, loading statuses and facility capacity limits." width={calendar.width} height={calendar.height} loading="eager" fetchpriority="high" />
            </picture>
          </a>
          <figcaption><a href={calendar.src} data-screenshot-zoom><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="10" cy="10" r="6" /><path d="m15 15 6 6M7 10h6M10 7v6" /></svg>Enlarge screenshot</a></figcaption>
        </figure>
      </section>

      <Clients variant="home-revamp" />

      <section class="workflow wrap section-space" id="features" aria-labelledby="workflow-title">
        <div class="section-heading"><div><p class="eyebrow">A better flow, even when the plan changes</p><h2 id="workflow-title">LESS <span class="keep-together">BACK-AND-FORTH.</span><br />EVERYONE ON THE SAME PAGE.</h2></div><p>A late truck shouldn’t mean five phone calls just to get everyone caught up. Bring bookings, yard activity and load details together so everyone can see what needs to happen next.</p></div>
        <div class="stages">{stages.map(stage => <article class="stage"><div class="stage-intro"><div class="stage-top"><span class="stage-number">{stage.number}</span><span class="stage-icon" aria-hidden="true"><stage.icon size={40} strokeWidth={1.5} /></span></div><p class="eyebrow">{stage.when}</p><h3>{stage.title}</h3><p class="stage-copy">{stage.copy}</p></div><div class="stage-links">{stage.links.map(link => <a href={link.href}>{link.label}<span aria-hidden="true"><svg class="direction-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 5 7 7-7 7" /></svg></span></a>)}</div></article>)}</div>
      </section>

      <section class="story-section" id="customer-story" aria-labelledby="story-title">
        <div class="story-grid wrap">
          <div class="story-copy"><p class="eyebrow">SEE IT IN A REAL OPERATION</p><h2 id="story-title">A BUSIER DOCK.<br />A BETTER WAY{" "}<br />TO RUN IT.</h2><p>How a food manufacturer scaled through automated dock scheduling.</p><p class="story-detail">See the customer story, then explore what a different scheduling process could look like at your facility.</p><a class="text-link" href="#book-demo">Talk through your operation <span aria-hidden="true"><svg class="direction-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 5 7 7-7 7" /></svg></span></a></div>
          <div class="story-video"><lite-youtube js-api videoid={videoId} playlabel="Play: How a Food Manufacturer Scaled Through Automated Dock Scheduling (Case Study)" params="rel=0" style={`background-image: url('${ytThumb(videoId, 'maxreswebp')}');`}><a class="lty-playbtn" href={`https://www.youtube.com/watch?v=${videoId}`} aria-label="Watch the food manufacturer case study on YouTube"><span class="lyt-visually-hidden">Watch the food manufacturer case study</span></a></lite-youtube><p class="video-caption"><span>CUSTOMER CASE STUDY</span></p></div>
        </div>
      </section>


      <section class="evaluation wrap section-space" aria-labelledby="evaluation-title">
        <div class="section-heading"><div><p class="eyebrow">MAKE AN INFORMED CHOICE</p><h2 id="evaluation-title">THE RIGHT SYSTEM<br />STARTS WITH <span class="heading-accent">YOUR REALITY.</span></h2></div><p>Start with the situations your team handles every week. A late truck. A full yard. A question that needs an answer. Then compare how each system helps you deal with them.</p></div>
        <div class="evaluation-grid">
          <a class="evaluation-card dock-guide" href={comparisonUrl}>
            <div class="card-top"><svg width="38" height="38" viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M5 34V12l15-7 15 7v22M13 34V18h14v16M13 24h14M13 29h14M2 34h36" /></svg></div>
            <h3>Which software fits your operation?</h3>
            <p>Look beyond the feature list. Compare booking rules, carrier access, yard workflows and support side by side.</p>
            <span class="card-action">Compare dock scheduling tools <span aria-hidden="true"><svg class="direction-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 5 7 7-7 7" /></svg></span></span>
          </a>
          <a class="evaluation-card yard-guide" href="/posts/best-yard-management-options">
            <div class="card-top"><svg width="38" height="38" viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M3 11h23v18H3zM26 18h6l5 7v4H26M29 18v7h8M7 29v3M22 29v3" /><circle cx="10" cy="31" r="3" /><circle cx="31" cy="31" r="3" /></svg></div>
            <h3>What does your yard actually need?</h3>
            <p>Different yards need different systems. Explore the options by facility type, operational requirements and fit.</p>
            <span class="card-action">Find the right yard management system <span aria-hidden="true"><svg class="direction-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 5 7 7-7 7" /></svg></span></span>
          </a>
        </div>
      </section>

      <div class="wrap"><CustomerQuotes /></div>

      <section class="resources-section" aria-labelledby="resources-title">
        <div class="resources-grid wrap">
          <div class="resources-intro">
            <h2 id="resources-title">HOW DATADOCKS CAN HELP YOUR TEAM.</h2>
            <div class="benefit-links">{benefits.map(benefit => <a href={benefit.href}><img src={`/images/${benefit.image}`} alt={benefit.alt} width="500" height="311" loading="lazy" decoding="async" /><span>{benefit.title}</span></a>)}</div>
          </div>
          <div class="reading-list">
            <div class="reading-header"><h3 class="reading-title">Latest resources, guides and updates</h3><a class="text-link all-resources" href={previewAsOf ? "/preview/daily-blog/posts" : "/posts"}>See all resources <svg class="direction-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m9 5 7 7-7 7" /></svg></a></div>
            <div class="editorial-grid">
              <ol class="post-feed" aria-label="Recent resources from DataDocks">{reading.map(post => {
                const type = post.data.postType.discriminant;
                const author = type === 'article' ? (post.data.author === 'DataDocks' ? 'DataDocks Team' : post.data.author) : 'Nick Rakovsky';
                const TopicIcon = feedTopicIcons[post.data.category || ''] || Lightbulb;
                return <li>
                <article class="feed-post">
                  <header class="feed-byline">
                    <AuthorAvatar name={author} />
                    <span class="feed-attribution"><span class="feed-author">{author}</span><span aria-hidden="true">·</span><time datetime={post.data.pubDate.toISOString()}>{postDate.format(post.data.pubDate)}</time></span>
                  </header>
                  <a class="feed-link" href={`/${post.collection}/${post.slug}${post.collection === 'videos' ? '?autoplay=1' : ''}`}>
                    <h4>{post.data.title}</h4>
                    <span class="feed-details">
                      {post.data.category && <><span class="feed-topic"><TopicIcon size={14} strokeWidth={1.5} aria-hidden="true" /><span>{post.data.category}</span></span><span aria-hidden="true">·</span></>}
                      <span>{type === 'article' ? 'Article' : type === 'short' ? 'Quick Take' : 'Video deep dive'}</span>
                    </span>
                  </a>
                </article>
              </li>})}</ol>
              {featuredPost && <a class="featured-post" href={"/posts/" + featuredPost.slug}>
                <div class="reading-image">{featuredPost.data.cardImage && <Image src={featuredPost.data.cardImage} alt={featuredPost.data.cardAlt || featuredPost.data.title} widths={[480, 720, 1080]} sizes="(max-width: 640px) calc(100vw - 40px), 600px" width={720} loading="lazy" />}</div>
                <div class="featured-copy">
                  <h4>{featuredPost.data.title}</h4>
                  {featuredPost.data.description && <p>{featuredPost.data.description}</p>}
                  <span class="small-link">Read the guide <span aria-hidden="true">→</span></span>
                </div>
              </a>}
          </div>
          </div>
        </div>
      </section>

      <section class="getting-started wrap section-space" aria-labelledby="getting-started-title">
        <div class="section-heading"><div><p class="eyebrow">SETUP, TRAINING AND ONGOING SUPPORT</p><h2 id="getting-started-title">A TEAM THAT HELPS<br />YOU <span class="heading-accent">MAKE IT WORK.</span></h2></div><p>From your first booking rules to the unexpected loads, we work with your people to get the details right.</p></div>
        <div class="faq-grid">{[faqs[0], faqs[2]].map(faq => <article><h3>{faq.question}</h3><p>{faq.answer}</p>{faq.question === 'Can it work the way our facility works?' && <a class="small-link" href="/datadocks-features/custom-rules">Explore booking rules <span aria-hidden="true"><svg class="direction-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 5 7 7-7 7" /></svg></span></a>}{faq.question === 'Will it connect to our existing systems?' && <a class="small-link" href="/integrations">Explore integrations <span aria-hidden="true"><svg class="direction-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 5 7 7-7 7" /></svg></span></a>}</article>)}</div>
        <div class="faq-followups">{[[faqs[1], faqs[4], faqs[5]], [faqs[3], faqs[6], faqs[7]]].map(column => <div class="faq-column">{column.map(faq => <details class="faq-answer"><summary><h3>{faq.question}</h3><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg></summary><p>{faq.answer}</p></details>)}</div>)}</div>
        {/* Replace this booking destination with /enterprise once that page is ready. */}
        <section class="enterprise-bridge" aria-label="Multiple facilities"><div><span class="eyebrow">ACROSS YOUR LOCATIONS</span><h3>Coordinating more than one facility?</h3><p>Talk through shared visibility, local rules and a rollout across your sites.</p></div><a class="text-link" href="#book-demo">Discuss a multi-site rollout <span aria-hidden="true"><svg class="direction-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 5 7 7-7 7" /></svg></span></a></section>
        <p class="security-note"><svg width="17" height="19" viewBox="0 0 20 22" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m10 2 7 3v6c0 5-7 9-7 9s-7-4-7-9V5z" /><path d="m6 10 3 3 5-6" /></svg>SOC 2 compliant. Built to keep your operational data secure.</p>
      </section>

      <CTA captureFirst tabletInline />
    </main>
    <Footer />
    <DemoCapture />
    <dialog class="screenshot-dialog" aria-labelledby="screenshot-title" aria-describedby="screenshot-hint">
      <header class="screenshot-toolbar">
        <h2 id="screenshot-title">The weekly schedule</h2>
        <button type="button" class="screenshot-toggle" aria-controls="screenshot-viewport" data-screenshot-toggle>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="10" cy="10" r="6" /><path d="m15 15 6 6M7 10h6" /><path data-zoom-plus d="M10 7v6" /></svg>
          <span>Zoom in</span>
        </button>
        <button type="button" class="screenshot-close" aria-label="Close screenshot"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m6 6 12 12M6 18 18 6" /></svg></button>
      </header>
      {/* eslint-disable-next-line astro/jsx-a11y/no-noninteractive-tabindex -- Keyboard focus enables arrow-key scrolling of the enlarged schedule. */}
      <div class="screenshot-scroll" id="screenshot-viewport" role="region" aria-label="DataDocks schedule image" tabindex="0">
        <div class="screenshot-stage"><div class="screenshot-crop"><img data-full-screenshot data-src={calendar.src} width={calendar.width} height={calendar.height} draggable="false" alt="DataDocks weekly schedule, Monday through Sunday, showing truck appointments, capacity and loading statuses." /></div></div>
      </div>
      <footer class="screenshot-footer"><p id="screenshot-hint" aria-live="polite">The full week. Zoom in to read appointment details.</p><span class="screenshot-escape" aria-hidden="true">Esc to close</span></footer>
    </dialog>
  </div>
</Layout>

<script>
  type CustomerStoryPlayer = HTMLElement & {
    getYTPlayer: () => Promise<{ playVideo: () => void }>;
  };
  const watchStory = document.querySelector<HTMLAnchorElement>('[data-play-customer-story]');
  const story = document.querySelector<HTMLElement>('#customer-story');
  const embed = story?.querySelector('lite-youtube') as CustomerStoryPlayer | null | undefined;
  if (watchStory && story && embed) {
    watchStory.addEventListener('click', event => {
      if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      event.preventDefault();
      if (location.hash !== '#customer-story') history.pushState(null, '', '#customer-story');
      embed.scrollIntoView({ behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth', block: 'center' });
      // The existing lite embed loads YouTube only after this explicit action.
      void customElements.whenDefined('lite-youtube').then(() => embed.getYTPlayer()).then(player => {
        player.playVideo();
      }).catch(() => {
        // Keep the embedded player's own controls available if playback is blocked.
        const playButton = embed.querySelector<HTMLElement>('.lty-playbtn');
        playButton?.focus({ preventScroll: true });
      });
    });
  }

  const zoom = document.querySelector<HTMLDialogElement>('.screenshot-dialog');
  if (zoom) {
    const viewport = zoom.querySelector<HTMLElement>('.screenshot-scroll')!;
    const crop = zoom.querySelector<HTMLElement>('.screenshot-crop')!;
    const toggle = zoom.querySelector<HTMLButtonElement>('[data-screenshot-toggle]')!;
    const hint = zoom.querySelector<HTMLElement>('#screenshot-hint')!;
    let trigger: HTMLElement | null = null;
    let enlarged = false;
    let previousOverflow = '';
    let drag: { id: number; x: number; y: number; left: number; top: number } | null = null;
