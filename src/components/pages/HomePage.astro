  /* The headline stays in phrases; the layout opens up before columns become cramped. */
  .section-heading > div { min-width: 0; container-type: inline-size; }
  .section-heading h2 { font-size: clamp(36px, 10.5cqw, 64px); text-wrap: balance; }
