  .stage-links a { display: flex; justify-content: space-between; align-items: center; gap: 12px; font-size: 14px; font-weight: 600; line-height: 1.5; padding-block: 9px; min-height: 44px; }
  .stage-links a > span { flex-shrink: 0; display: flex; }
  .stage-links a:hover { text-decoration: underline; color: #ab3500; }

  .benefit-links { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 28px; margin-top: 28px; }
  .benefit-links a { display: flex; flex-direction: column; gap: 14px; font: 600 20px/1.4 'DD-Recoleta', Georgia, serif; }
  .benefit-links img { display: block; width: 100%; height: auto; aspect-ratio: 500 / 311; object-fit: contain; }
  .benefit-links a:hover span { text-decoration: underline; text-underline-offset: 4px; }
  .reading-list { border-top: 1px solid #d4c9b9; padding-top: 28px; margin-top: 38px; }
  .reading-header { display: flex; align-items: center; justify-content: space-between; gap: 24px; margin-bottom: 26px; }
  /* Preview a heavier Recoleta treatment using the bundled semibold face. */
  .reading-title { margin: 0; font: 600 clamp(24px, 2vw, 28px)/1.2 'DD-Recoleta', Georgia, serif; letter-spacing: normal; word-spacing: normal; text-transform: none; text-wrap: balance; -webkit-text-stroke: .025em currentColor; paint-order: stroke fill; }
  .all-resources { margin: 0; flex-shrink: 0; }
  .reading-image { width: 100%; overflow: hidden; }
  .reading-image img { display: block; width: 100%; height: auto; }

  /* Show the actual remaining questions instead of a separate 'more answers' gate. */
  .faq-followups { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 70px; align-items: start; margin-top: 33px; }
  .faq-answer { border-top: 1px solid var(--line); padding-block: 20px; }
  .faq-answer summary { display: flex; align-items: start; justify-content: space-between; gap: 20px; list-style: none; cursor: pointer; }
  .faq-answer summary::-webkit-details-marker { display: none; }
  .faq-answer summary h3 { font: 600 20px/1.4 'DD-Recoleta', Georgia, serif; margin: 0; }
  .faq-answer summary svg { flex-shrink: 0; margin-top: 6px; transition: transform .2s; }
  .faq-answer[open] summary svg { transform: rotate(180deg); }
  .faq-answer p { margin: 14px 0 0; color: var(--muted); font-size: 16px; line-height: 1.8; }

