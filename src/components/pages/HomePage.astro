  .product-window picture { display: contents; }
  .product-window img { position: absolute; display: block; height: auto; width: 204.499%; max-width: none; left: 0; top: 0; transform: translate(-8.9%, -22.315%); }




  /* Shared rows align all twelve links, including labels that wrap. */
  .stages { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-top: 1px solid var(--line); }
  .stage { display: grid; grid-row: span 5; grid-template-rows: subgrid; padding: 28px 28px 0 0; min-width: 0; }
  .stage + .stage { border-left: 1px solid var(--line); padding-left: 28px; }
  .stage:last-child { padding-right: 0; }
  .stage-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; }
  .stage-number { font: 52px/1 Bruta, Impact, sans-serif; color: var(--orange); }
  .stage-icon { color: var(--ink); display: flex; }
  .stage .eyebrow { font-size: 12px; letter-spacing: .07em; margin-bottom: 9px; color: #605b53; }
  .stage h3 { font: 600 26px/1.2 'DD-Recoleta', Georgia, serif; margin: 0 0 15px; text-wrap: balance; }


  .stage-copy { font-size: 16px; line-height: 1.75; color: var(--muted); margin: 0 0 22px; text-wrap: pretty; }
