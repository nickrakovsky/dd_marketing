---
import measurements from '../../data/customer-logo-metrics.json';
interface Props { variant?: 'default' | 'home-revamp'; }
const { variant = 'default' } = Astro.props;
const airy = variant === 'home-revamp';
const basePath = import.meta.env.BASE_URL.replace(/\/$/, "");

/**
 * Per-logo sizing from SVG ink-ratio + aspect-ratio analysis.
 *
 * KEY FIX: both width AND height are constrained, with object-contain.
 * This prevents wide-aspect logos (Stitch Fix 8.3:1, Samsung 6.53:1)
 * from horizontally dominating square emblems (Pepsi 1:1, Columbia 1.23:1).
 *
 * How each dimension was chosen:
 *   w = the maximum horizontal footprint the logo should occupy
 *   h = the row height available; object-contain scales the logo to fit both
 *
 * Wide wordmarks  → wide w, short h  (logo constrained by w, renders small height)
 * Square emblems  → narrow w, tall h (logo constrained by h, renders full height)
 * Mixed logos     → balanced w+h
 *
 * All class strings are written out in full so Tailwind's scanner includes them.
 * object-position (CoG alignment) is inline since Tailwind has no clean utility.
 *
 * canvas ratios & ink analysis → see analyse-logos.mjs
 */
const logos = [
  { src: "Layer_1-2.svg",     alt: "LG Logo",         cls: "w-[118px] h-[52px] object-contain", pos: "41% 51%", w: 118, h: 52 },
  { src: "shipmonk_.svg",     alt: "ShipMonk Logo",   cls: "w-[164px] h-[41px] object-contain", pos: "48% 49%", w: 164, h: 41 },
  { src: "Layer_2-2.svg",     alt: "GSK Logo",        cls: "w-[140px] h-[42px] object-contain", pos: "47% 51%", w: 140, h: 42 },
  { src: "Group-1.svg",       alt: "HelloFresh Logo", cls: "w-[129px] h-[42px] object-contain", pos: "44% 50%", w: 129, h: 42 },
  { src: "Group.svg",         alt: "StitchFix Logo",  cls: "w-[220px] h-[27px] object-contain", pos: "49% 47%", w: 220, h: 27 },
  { src: "Pepsi_2023.svg",    alt: "Pepsi Logo",      cls: "w-[65px] h-[65px] object-contain",  pos: "50% 50%", w: 65, h: 65 },
  { src: "Samsung.svg",       alt: "Samsung Logo",    cls: "w-[187px] h-[29px] object-contain", pos: "50% 50%", w: 187, h: 29 },
  { src: "Toyota_Logo.svg",   alt: "Toyota Logo",     cls: "w-[90px] h-[65px] object-contain",  pos: "50% 51%", w: 90, h: 65 },
  { src: "columbia-wide.svg", alt: "Columbia Logo",   cls: "w-[260px] h-[39px] object-contain", pos: "46% 52%", w: 260, h: 39 },
];
const displayLogos = logos.map(logo => {
  const ink = measurements.find(item => item.src === logo.src);
  if (!airy || !ink) return { ...logo, inkStyle: undefined };
  const scale = Math.sqrt(950 / ink.inkArea);
  const px = (value: number) => `${value.toFixed(3)}px`;
  return { ...logo, inkStyle: [
    `--ink-width:${px(ink.width * scale)}`, `--ink-height:${px(ink.height * scale)}`,
    `--image-width:${px(ink.canvasWidth * scale)}`, `--image-height:${px(ink.canvasHeight * scale)}`,
    `--image-left:${px(-ink.left * scale)}`, `--image-top:${px(-ink.top * scale)}`,
    `--optical-y:${px((ink.height / 2 - ink.centroidY) * scale)}`,
  ].join(';') };
});
---


<section class:list={['clients-section py-16 bg-[#FFF8E9] overflow-hidden', { 'clients-airy': airy }]} aria-label="DataDocks customers">
  
  {/* Heading stays in container */}
  <div class="container mx-auto text-center">
    <h2 class="clients-heading font-recoleta text-xl md:text-2xl text-[#736146] mb-12 max-w-3xl mx-auto px-4">
      Trusted by the world's most relentless supply chains
    </h2>
  </div>

  {/* Full-width marquee */}
  <div id="clients-marquee" class="relative w-full flex overflow-hidden mb-12 opacity-80 cursor-grab active:cursor-grabbing" style="touch-action: pan-y;" tabindex="0" role="group" aria-label="Customer logos. Drag or use the left and right arrow keys to browse.">
    <div id="clients-track" class="flex w-max items-center">
      {/* 5x logos for plenty of content in both directions */}
      {[0, 1, 2, 3, 4].flatMap(copy => displayLogos.map(logo => ({ ...logo, copy }))).map((logo) => (
        <div class="client-slot flex-shrink-0 px-8 md:px-12 flex items-center justify-center" aria-hidden={logo.copy !== 2 ? 'true' : undefined}>
          <span class:list={{ 'client-ink': Boolean(logo.inkStyle) }} style={logo.inkStyle}>
          <img
            src={`${basePath}/images/${logo.src}`}
            alt={logo.copy === 2 ? logo.alt : ''}
            draggable="false"
            loading="lazy"
            decoding="async"
            fetchpriority="low"
            width={logo.w}
            height={logo.h}
            class={logo.cls}
            style={`object-position: ${logo.pos};`}
          />
          </span>
        </div>
      ))}
    </div>
  </div>

  {/* Trust statement stays in container */}
  {!airy && <div class="container mx-auto text-center">
    <h2 class="font-recoleta text-xl md:text-2xl text-[#736146] max-w-3xl mx-auto px-4">
      Backed by SOC 2 compliance, we deliver the <strong class="font-bold text-black">most secure</strong> dock scheduling platform in the industry
    </h2>
  </div>}
    
</section>

<style>
  .clients-airy { background: #FFF8EE; border-block: 1px solid #EFE2D2; padding-block: 30px; }
  .clients-airy .clients-heading { margin-bottom: 24px; color: #000; font-size: 22px; line-height: 1.5; }
  .clients-airy #clients-marquee { margin-bottom: 0; opacity: 1; }
  .clients-airy .client-slot { padding-inline: 46px; height: 72px; }
  .client-ink { position: relative; display: block; width: var(--ink-width); height: var(--ink-height); overflow: hidden; transform: translateY(var(--optical-y)); }
  .client-ink img { position: absolute; width: var(--image-width); height: var(--image-height); max-width: none; left: var(--image-left); top: var(--image-top); }
  #clients-marquee:focus-visible { outline: 2px solid #000; outline-offset: -2px; }
  @media(max-width:600px) { .clients-airy .clients-heading { font-size: 19px; max-width: 32ch; } .clients-airy .client-slot { padding-inline: 36px; } }
</style>

<script>
  const marquee = document.getElementById('clients-marquee');
  const track = document.getElementById('clients-track');
  if (marquee && track) {
    let pending: Promise<void> | undefined;
    let dispose: (() => void) | undefined;
    let removed = false;
    const load = () => pending ??= import('../../lib/client-marquee').then(({ initClientMarquee }) => {
      if (!removed) dispose = initClientMarquee(marquee, track);
    }).catch(() => { pending = undefined; });
    const observer = new IntersectionObserver(entries => {
      if (entries[0].isIntersecting) void load();
    });
    observer.observe(marquee);
    marquee.addEventListener('pointerdown', load, { once: true });
    marquee.addEventListener('focusin', load, { once: true });
    document.addEventListener('astro:before-swap', () => {
      removed = true;
      observer.disconnect();
      dispose?.();
    }, { once: true });
  }
</script>
