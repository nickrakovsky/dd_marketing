---
interface Props {
  kind?: 'internal' | 'back' | 'down' | 'external' | 'email';
  size?: number;
  class?: string;
}

const { kind = 'internal', size = 20, class: className } = Astro.props;

const paths = {
  internal: ['m9 6 6 6-6 6'],
  back: ['m15 6-6 6 6 6'],
  down: ['m6 9 6 6 6-6'],
  external: ['M13 4H4v16h9', 'm15 8 5 4-5 4'],
  email: ['M3 5h18v14H3z', 'm3 6 9 7 9-7'],
};
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  class:list={['link-icon', className]}
  data-link-icon={kind}
  aria-hidden="true"
  focusable="false"
>
  {paths[kind].map((d) => <path d={d} />)}
</svg>

<style>
  .link-icon {
    display: inline-block;
    flex-shrink: 0;
    vertical-align: middle;
  }
</style>
