const process = [
  { title: 'Purpose and criteria', text: 'What decision does this review support, and which requirements apply?', paths: ['M4 4h16v16H4z', 'M8 8h8v8H8z'], accent: 'M12 1v5m0 12v5M1 12h5m12 0h5' },
  { title: 'Evidence', text: 'What do the records, observations and worker accounts establish?', paths: ['M8 4H5v17h14V4h-3', 'M9 2h6v4H9z', 'M8 10h8'], accent: 'M8 14h8m-8 4h5' },
  { title: 'Finding and uncertainty', text: 'What differs from the requirement? What remains unexplained?', paths: ['M5 3h10l4 4v14H5z', 'M15 3v5h4', 'M8 11h7'], accent: 'M12 14v3m0 2v1' },
