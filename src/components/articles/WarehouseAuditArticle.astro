  { title: 'Stock record', text: 'Identify the location and recorded balance.', paths: ['M4 4h16v16H4z', 'M4 9h16', 'M9 9v11', 'M4 14h16'], accent: 'M12 17h5' },
  { title: 'Movements', text: 'Check what changed around the count.', paths: ['M4 7h15', 'm15 3 4 4-4 4'], accent: 'M20 17H5m4-4-4 4 4 4' },
