---
import { getEntry } from 'astro:content';
import ArticlePage from '../../components/pages/ArticlePage.astro';
import NotFound from '../404.astro';
import { isPublished } from '../../lib/content-status';

export const prerender = false;

const { slug } = Astro.params;
const entry = await getEntry('posts', slug ?? '');
const published = entry && isPublished(entry.data.pubDate, Astro.locals.publicationDate);
if (!published) {
  Astro.response.status = 404;
  Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');
}
---

{published ? <ArticlePage entry={entry} /> : <NotFound />}
