---
export const prerender = true;

import Layout from "../../layouts/Layout.astro";
import Navigation from "../../components/Navigation.astro";
import Footer from "../../components/Footer.astro";
import CTA from "../../components/home/CTA.astro";
import { getModularHubData } from "../../lib/wireframe-data";
import { ytThumb } from "../../lib/yt-thumb";
import { Image } from "astro:assets";
import PhoneFrame from "../../components/PhoneFrame.astro";
import mobileScreenshot from "../../assets/solutionsscreenshots/visibility/appscreenshot-screen.webp";
import desktopScreenshot from "../../assets/solutionsscreenshots/DataDocks-Calendar-Clean.webp";
import { CALENDLY_BOOKING_URL, CALENDLY_BRAND_PARAMS } from "../../lib/calendly-config.mjs";

const CALENDLY_FALLBACK_URL = `${CALENDLY_BOOKING_URL}?${CALENDLY_BRAND_PARAMS}`;

const {
  evergreen1,
  evergreen2,
  evergreen3,
  evergreen4,
  evergreen5,
  evergreen6,
  evergreen7,
  evergreen8,
  evergreen9,
  foundationalGuides,
  latest5Posts,
  founderShorts,
  deepDiveVideos,
  olderResources
} = await getModularHubData();

const title = "Resource Hub: Guides, Checklists & Insights for Operations Teams | DataDocks";
const description = "Comprehensive operational playbooks, dock scheduling guides, warehouse checklists, and founder video deep dives.";
---

<Layout title={title} description={description}>
  <link
    rel="stylesheet"
    href="/css/lite-yt-embed.css"
    media="print"
    onload="this.media='all'"
  />
  <script is:inline src="/css/lite-yt-embed.js" defer></script>

  <style is:global>
    /* Custom responsive styling for lite-youtube in shorts and video sections */
    .modular-short-embed lite-youtube {
      aspect-ratio: 9 / 14;
      width: 100%;
      max-width: 100%;
      border-radius: 0;
      background-position: center center;
      background-size: cover;
    }
    .modular-short-embed lite-youtube::after {
      padding-bottom: calc(100% * (14 / 9));
    }
    .modular-short-embed lite-youtube::before {
      display: none;
    }

    /* Smooth fade-in for YouTube iframe to eliminate flash */
    .modular-short-embed lite-youtube > iframe {
      animation: shortYtFadeIn 0.3s ease-out forwards;
    }
    @keyframes shortYtFadeIn {
      from { opacity: 0; }
      to { opacity: 1; }
    }

    /* Hide caption overlay and custom play button once lite-youtube has been activated */
    .modular-short-embed:has(.lyt-activated) .short-caption,
    .modular-short-embed:has(.lyt-activated) .short-play-icon {
      display: none !important;
      opacity: 0 !important;
      pointer-events: none !important;
    }

    /* Before activation: Keep lite-youtube button as an active invisible trigger over the entire card */
    .modular-short-embed lite-youtube:not(.lyt-activated) > .lty-playbtn {
      opacity: 0 !important;
      position: absolute !important;
      inset: 0 !important;
      width: 100% !important;
      height: 100% !important;
      border: 0 !important;
      cursor: pointer !important;
      z-index: 25 !important;
    }

    /* Once activated: Remove lty-playbtn so all pointer events reach the iframe directly */
    .modular-short-embed lite-youtube.lyt-activated > .lty-playbtn {
      display: none !important;
      pointer-events: none !important;
      z-index: -1 !important;
    }

    /* Native Fullscreen styling for shorts container */
    .modular-short-embed:fullscreen,
    .modular-short-embed:-webkit-full-screen {
      display: flex !important;
      align-items: center !important;
      justify-content: center !important;
      background: #0a0a0a !important;
      width: 100vw !important;
      height: 100vh !important;
      border-radius: 0 !important;
      padding: 0 !important;
      margin: 0 !important;
    }
    .modular-short-embed:fullscreen lite-youtube,
    .modular-short-embed:-webkit-full-screen lite-youtube {
      height: 100vh !important;
      width: auto !important;
      aspect-ratio: 9 / 16 !important;
      max-width: calc(100vh * (9 / 16)) !important;
    }
    .modular-short-embed:fullscreen .short-fullscreen-btn,
    .modular-short-embed:-webkit-full-screen .short-fullscreen-btn {
      opacity: 1 !important;
      top: 1.5rem !important;
      right: 1.5rem !important;
      width: 2.75rem !important;
      height: 2.75rem !important;
      background: rgba(0, 0, 0, 0.75) !important;
      border-color: rgba(255, 255, 255, 0.3) !important;
    }
    .modular-short-embed:fullscreen .short-fullscreen-btn svg,
    .modular-short-embed:-webkit-full-screen .short-fullscreen-btn svg {
      width: 1.25rem !important;
      height: 1.25rem !important;
    }

    .modular-video-embed lite-youtube {
      aspect-ratio: 16 / 9;
      width: 100%;
      max-width: 100%;
      border-radius: 1rem;
    }
  </style>

  {/* 1. MAIN NAVIGATION */}
  <Navigation />

  <main class="min-h-screen bg-[#FFF8EE] text-gray-900 font-sans pb-0">
    
    {/* 2. HERO H1 (CENTRED, BRAND EDITORIAL STYLE MATCHING LIVE HUB) */}
    <header class="pt-16 pb-12 text-center max-w-5xl mx-auto px-4">
      <h1 class="text-4xl sm:text-5xl md:text-6xl lg:text-[76px] font-bruta uppercase leading-[0.88] tracking-tight">
        <span class="text-[#FE5000]">RESOURCE HUB:</span><br />
        <span class="text-black">Guides, Checklists & Insights<br class="hidden sm:inline" /> for Operations Teams</span>
      </h1>
    </header>

    {/* 3. 3 MINIMALIST SHORT, WIDE CARDS (NASA REF 9: ALIGNED LEFT, 75% WIDTH, TOP DIVIDERS & CIRCULAR ARROW) */}
    <section class="max-w-7xl mx-auto px-4 md:px-8 mb-16">
      <div class="w-full lg:w-3/4 grid grid-cols-1 md:grid-cols-3 gap-6">
        
        {/* Card 1: Yard Management Systems */}
        <div class="border-t border-black/20 pt-4 pb-3">
          <span class="text-[13px] text-gray-500 font-sans block mb-2 leading-snug select-none">
            {evergreen1.kicker}
          </span>
          <a href={evergreen1.url} class="group flex items-start justify-between gap-4">
            <h3 class="font-sans font-bold text-base md:text-[17px] text-gray-900 group-hover:text-[#FE5000] transition-colors leading-snug">
              {evergreen1.title}
            </h3>
            <span class="w-5 h-5 rounded-full bg-[#FE5000] text-white flex items-center justify-center text-xs shrink-0 mt-0.5 group-hover:scale-110 transition-transform">
              →
            </span>
          </a>
        </div>

        {/* Card 2: Dock Scheduling */}
        <div class="border-t border-black/20 pt-4 pb-3">
          <span class="text-[13px] text-gray-500 font-sans block mb-2 leading-snug select-none">
            {evergreen2.kicker}
          </span>
          <a href={evergreen2.url} class="group flex items-start justify-between gap-4">
            <h3 class="font-sans font-bold text-base md:text-[17px] text-gray-900 group-hover:text-[#FE5000] transition-colors leading-snug">
              {evergreen2.title}
            </h3>
            <span class="w-5 h-5 rounded-full bg-[#FE5000] text-white flex items-center justify-center text-xs shrink-0 mt-0.5 group-hover:scale-110 transition-transform">
              →
            </span>
          </a>
        </div>

        {/* Card 3: Warehouse Audit Checklist */}
        <div class="border-t border-black/20 pt-4 pb-3">
          <span class="text-[13px] text-gray-500 font-sans block mb-2 leading-snug select-none">
            {evergreen3.kicker}
          </span>
          <a href={evergreen3.url} class="group flex items-start justify-between gap-4">
            <h3 class="font-sans font-bold text-base md:text-[17px] text-gray-900 group-hover:text-[#FE5000] transition-colors leading-snug">
              {evergreen3.title}
            </h3>
            <span class="w-5 h-5 rounded-full bg-[#FE5000] text-white flex items-center justify-center text-xs shrink-0 mt-0.5 group-hover:scale-110 transition-transform">
              →
            </span>
          </a>
        </div>

      </div>
    </section>

    {/* 4. SPLIT SECTION: SQUARER LATEST INSIGHTS (EQUAL HEIGHT, 0 GAPS, SQUARE HOVER FILL) VS EVERGREEN 4 */}
    <section class="max-w-7xl mx-auto px-4 md:px-8 mb-16">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-stretch">
        {/* Left Column (5/12 width): Squarer Latest Insights block */}
        <div class="lg:col-span-5 flex flex-col h-full">
          <div class="pb-3 border-b-2 border-black">
            <h2 class="font-sans font-bold text-lg md:text-xl text-black">
              Latest Insights
            </h2>
          </div>

          {/* 5 invisible cards of strictly equal height, 0 gap, square hover fill */}
          <div class="flex-1 flex flex-col divide-y divide-black/15">
            {latest5Posts.map((post, idx) => (
              <a
                href={post.url}
                class="flex-1 flex items-center px-4 py-3.5 rounded-none group transition-colors duration-150 hover:bg-black/[0.05]"
              >
                <div class="flex items-baseline gap-3.5 w-full">
                  <span class="font-mono text-sm font-bold text-[#FE5000] shrink-0 w-5">
                    {String(idx + 1).padStart(2, '0')}
                  </span>
                  <div class="min-w-0 flex-1">
                    <span class="text-[11px] font-mono text-gray-400 block mb-0.5">
                      {post.displayDate}
                    </span>
                    <h3 class="font-sans font-bold text-sm md:text-[15px] text-gray-900 leading-snug group-hover:text-[#FE5000] transition-colors line-clamp-2">
                      {post.title}
                    </h3>
                  </div>
                </div>
              </a>
            ))}
          </div>
        </div>

        {/* Right Column (7/12 width): Most Popular Post (Evergreen 4), smooth hover & matched height */}
        <a
          href={evergreen4.url}
          class="lg:col-span-7 flex flex-col group rounded-xl h-full"
        >
          {evergreen4.cardImage && (
            <div class="w-full h-56 md:h-64 rounded-xl overflow-hidden bg-gray-100 relative shrink-0 block">
              <Image
                src={evergreen4.cardImage}
                alt={evergreen4.cardAlt || evergreen4.title}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out"
                loading="lazy"
              />
            </div>
          )}

          <div class="pt-4 flex-1 flex flex-col justify-between">
            <div>
              <div class="text-xs font-mono text-gray-400 mb-1.5 transition-colors duration-200 group-hover:text-gray-600">
                {evergreen4.displayDate}
              </div>

              <h2 class="font-bruta text-2xl md:text-3xl uppercase leading-tight text-black group-hover:text-[#FE5000] transition-colors mb-3">
                {evergreen4.title}
              </h2>

              <p class="text-sm md:text-base text-gray-700 font-recoleta leading-relaxed line-clamp-4 transition-colors duration-200 group-hover:text-black">
                {evergreen4.description}
              </p>
            </div>

            <div class="pt-3 text-xs font-mono text-gray-500 transition-colors duration-200 group-hover:text-gray-900">
              By {evergreen4.author} • {evergreen4.readTime}
            </div>
          </div>
        </a>

      </div>
    </section>

    {/* 5. FULL-WIDTH BANNER: "60-SECOND TAKES FROM NICK" */}
    <section class="w-full bg-[#111111] text-white py-16 md:py-20">
      <div class="max-w-7xl mx-auto px-4 md:px-8">
        <div class="flex items-center justify-between mb-8">
          <h2 class="font-bruta text-xl sm:text-2xl md:text-3xl lg:text-[34px] xl:text-[38px] uppercase tracking-tight text-white leading-tight">
            Watch: 60-Second Takes from Nick Rakovsky, DataDocks Founder
          </h2>

          <div class="flex items-center gap-2 shrink-0">
            <button
              type="button"
              id="shorts-prev"
              class="w-10 h-10 rounded-full border border-white/20 bg-white/10 flex items-center justify-center hover:bg-white hover:text-black transition-colors"
              aria-label="Previous Short"
            >
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
            </button>
            <button
              type="button"
              id="shorts-next"
              class="w-10 h-10 rounded-full border border-white/20 bg-white/10 flex items-center justify-center hover:bg-white hover:text-black transition-colors"
              aria-label="Next Short"
            >
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
            </button>
          </div>
        </div>

        {/* Carousel of short-form videos: Slot 1 has original thumbnail + short title; Slots 2+ have darkened thumbnail + longer-form title */}
        <div
          id="shorts-carousel"
          class="flex gap-5 overflow-x-auto pb-4 scrollbar-none snap-x snap-mandatory scroll-smooth"
        >
          {founderShorts.map((short) => (
            <div class="w-56 md:w-64 shrink-0 snap-start flex flex-col group cursor-pointer">
              <div class="w-full aspect-[9/14] relative bg-black rounded-xl overflow-hidden modular-short-embed transition-transform duration-500 group-hover:scale-[1.03]">
                {short.youtubeId && (
                  <lite-youtube
                    videoid={short.youtubeId}
                    playlabel={short.rawTitle || short.title}
                    params={`controls=0&rel=0&modestbranding=1&iv_load_policy=3&loop=1&playlist=${short.youtubeId}&enablejsapi=1`}
                    style={`background-image: url('${ytThumb(short.youtubeId, 'sdwebp')}'), url('https://i.ytimg.com/vi/${short.youtubeId}/hqdefault.jpg'); background-position: center center; background-size: cover;`}
                    class="w-full h-full"
                  />
                )}

                {/* Darkness Filter Overlay (active when not playing, disappears when playing) */}
                <div class="short-dark-filter absolute inset-0 bg-black/45 group-hover:bg-black/35 transition-colors duration-300 pointer-events-none z-10"></div>

                {/* Video Title anchored at top displaying complete title */}
                <div class="short-caption absolute inset-x-0 top-0 p-4 md:p-5 bg-gradient-to-b from-black/85 via-black/35 to-transparent pointer-events-none z-20 transition-opacity duration-300">
                  <h3 class="font-sans font-bold text-sm md:text-[15px] text-white leading-snug drop-shadow">
                    {short.rawTitle || short.title}
                  </h3>
                </div>

                {/* Perfectly Centered Play Button Indicator on EVERY card (z-30) */}
                <div class="short-play-icon absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-14 h-14 rounded-full bg-black/55 backdrop-blur-sm border-2 border-white/90 flex items-center justify-center text-white shadow-xl pointer-events-none z-30 group-hover:scale-110 group-hover:bg-[#FE5000] group-hover:border-[#FE5000] transition-all duration-200">
                  <svg class="w-7 h-7" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M8 5.5v13l10-6.5z" />
                  </svg>
                </div>

                {/* Fullscreen Option (Native Fullscreen API) positioned at bottom-right */}
                <button
                  type="button"
                  class="short-fullscreen-btn absolute bottom-3 right-3 w-8 h-8 rounded-full bg-black/60 hover:bg-[#FE5000] text-white flex items-center justify-center backdrop-blur-sm border border-white/20 opacity-0 group-hover:opacity-100 transition-all duration-200 z-30 shadow-md cursor-pointer"
                  aria-label="Toggle full screen"
                  title="Full screen"
                >
                  <svg class="w-4 h-4 pointer-events-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path class="fs-expand-icon" d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3" />
                    <path class="fs-compress-icon" style="display: none;" d="M8 3v3a2 2 0 0 1-2 2H3m18 0h-3a2 2 0 0 1-2-2V3m0 18v-3a2 2 0 0 1 2-2h3M3 16h3a2 2 0 0 1 2 2v3" />
                  </svg>
                </button>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* 6. HUGE 'WHY' CTA FULL-WIDTH BANNER (NORMALIZED MARKETING HOOKS, SCALED SCREENSHOTS & CLEAN MOBILE CHASSIS) */}
    <section class="w-full bg-[#EFE2D2] py-16 md:py-24 mb-20">
      <div class="max-w-7xl mx-auto px-4 md:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-14 items-center">
          
          {/* Left Column: Normalized Operational Arguments and Expanded Demo capture */}
          <div class="lg:col-span-6">
            <h2 class="font-bruta text-3xl sm:text-4xl md:text-5xl lg:text-[54px] uppercase tracking-tight text-black leading-[0.95] mb-10">
              Why 10,000 Operations Trust DataDocks
            </h2>

            {/* 3 Oversized Icon-Illustrations NEXT TO 3 Normalized Arguments */}
            <div class="space-y-8 mb-10">
              
              {/* Argument 1: Tactical and practical (Isometric Jigsaw Puzzle Piece) */}
              <div class="flex items-start gap-5 group">
                <div class="shrink-0 pt-0.5">
                  <svg class="w-14 h-14 text-black shrink-0 transition-transform group-hover:scale-105 duration-300" viewBox="0 0 56 56" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M12 25V33L28 42V34L12 25Z" fill="#C5B4A3" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
                    <path d="M28 42L44 33V25L28 34V42Z" fill="#B2A08F" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
                    <path d="M28 8 L34 11.5 C35 10 36.5 9 38.5 9 C41 9 42.5 11 42 13 C41.5 15 39.5 15.5 38 15 L44 18.5 L38.5 22 C37.5 20.5 35.5 20 33.5 20.5 C31.5 21 30.5 23 31.5 24.5 C32.5 26 34.5 26 36 25 L28 30 L22 26.5 C20.5 27.5 18.5 27.5 17.5 26 C16.5 24.5 17.5 22.5 19.5 22 C21.5 21.5 23 23 24 24.5 L12 18.5 L18 15 C16.5 14.5 14.5 14 14 12 C13.5 10 15 8 17.5 8 C19.5 8 21 9 22 10.5 L28 8Z" fill="#FFF8EE" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
                    <circle cx="28" cy="19" r="2.5" fill="#FE5000"/>
                  </svg>
                </div>
                <div>
                  <h3 class="font-recoleta font-bold text-xl md:text-2xl text-black leading-snug">
                    Tactical and practical
                  </h3>
                  <p class="font-sans text-sm md:text-base text-gray-700 leading-relaxed mt-1">
                    Mandatory POs and pre-verified appointment rules ensure fast driver check-ins and stop gate hold-ups before they start.
                  </p>
                </div>
              </div>

              {/* Argument 2: In depth (Isometric Lightbulb) */}
              <div class="flex items-start gap-5 group">
                <div class="shrink-0 pt-0.5">
                  <svg class="w-14 h-14 text-black shrink-0 transition-transform group-hover:scale-105 duration-300" viewBox="0 0 56 56" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M28 4V8" stroke="#FE5000" stroke-width="2" stroke-linecap="round"/>
                    <path d="M14 10L17 13" stroke="#FE5000" stroke-width="2" stroke-linecap="round"/>
                    <path d="M42 10L39 13" stroke="#FE5000" stroke-width="2" stroke-linecap="round"/>
                    <path d="M28 8C20 8 15 13.5 15 20C15 24 17.5 27.5 20 30.5V36C20 37 20.8 38 21.8 38H34.2C35.2 38 36 37 36 36V30.5C38.5 27.5 41 24 41 20C41 13.5 36 8 28 8Z" fill="#FFF8EE" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
                    <path d="M21 41C21 42 21.8 43 23 43H33C34.2 43 35 42 35 41V38H21V41Z" fill="#D6C7B8" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
                    <path d="M24 46C24 47 25 48 26.5 48H29.5C31 48 32 47 32 46V43H24V46Z" fill="#222222" stroke="currentColor" stroke-width="1.5"/>
                    <line x1="21" y1="38" x2="35" y2="38" stroke="currentColor" stroke-width="1.5"/>
                    <line x1="22" y1="41" x2="34" y2="41" stroke="currentColor" stroke-width="1.5"/>
                    <path d="M25 28V20L28 16L31 20V28" stroke="#FE5000" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                    <circle cx="28" cy="16" r="1.5" fill="#FE5000"/>
                  </svg>
                </div>
                <div>
                  <h3 class="font-recoleta font-bold text-xl md:text-2xl text-black leading-snug">
                    Smart appointment lengths
                  </h3>
                  <p class="font-sans text-sm md:text-base text-gray-700 leading-relaxed mt-1">
                    Duration-based scheduling sets slot lengths by actual load type, smoothing daily dock flow and cutting driver detention.
                  </p>
                </div>
              </div>

              {/* Argument 3: Zero carrier friction (Isometric Shipping Parcel) */}
              <div class="flex items-start gap-5 group">
                <div class="shrink-0 pt-0.5">
                  <svg class="w-14 h-14 text-black shrink-0 transition-transform group-hover:scale-105 duration-300" viewBox="0 0 56 56" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M10 21V36L28 46V31L10 21Z" fill="#E2D6C7" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
                    <path d="M28 31V46L46 36V21L28 31Z" fill="#C5B4A3" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
                    <path d="M28 10L46 20L28 30L10 20L28 10Z" fill="#FFF8EE" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
                    <path d="M10 20L46 20" stroke="currentColor" stroke-width="1.5" stroke-dasharray="2 2"/>
                    <path d="M23 12.8L33 17.2L33 32.8L23 28.4Z" fill="#FE5000" fill-opacity="0.2" stroke="#FE5000" stroke-width="1.5" stroke-linejoin="round"/>
                    <rect x="15" y="27" width="8" height="6" rx="1" transform="skewY(25)" fill="#FFFFFF" stroke="currentColor" stroke-width="1"/>
                    <line x1="17" y1="28.5" x2="21" y2="28.5" transform="skewY(25)" stroke="currentColor" stroke-width="0.8"/>
                    <line x1="17" y1="30.5" x2="21" y2="30.5" transform="skewY(25)" stroke="currentColor" stroke-width="0.8"/>
                    <path d="M36 33L36 29M34 31L36 29L38 31" transform="skewY(-25)" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </div>
                <div>
                  <h3 class="font-recoleta font-bold text-xl md:text-2xl text-black leading-snug">
                    Zero carrier friction
                  </h3>
                  <p class="font-sans text-sm md:text-base text-gray-700 leading-relaxed mt-1">
                    Carriers book directly through self-service links that respect your facility rules, eliminating endless email back-and-forth.
                  </p>
                </div>
              </div>

            </div>

            {/* Book a Demo Email Capture (Full-width form spanning the text column above) */}
            <form
              id="demo-banner-form"
              class="flex flex-col sm:flex-row items-stretch w-full max-w-xl lg:max-w-[560px] pt-2 gap-0"
            >
              <input
                type="email"
                name="email"
                placeholder="Enter your email"
                style="outline: none !important; box-shadow: none !important; -webkit-appearance: none;"
                class="h-12 sm:h-14 flex-1 min-w-0 w-full px-5 bg-white text-black placeholder:text-gray-500 text-base border border-black/20 font-recoleta focus:ring-0 focus:outline-none focus:border-black rounded-none transition-all duration-300 sm:hover:pl-6 sm:focus:pl-6"
