  <script is:inline define:vars={{ CALENDLY_FALLBACK_URL, CALENDLY_BRAND_PARAMS }}>
    (function () {
      // Shorts Carousel Navigation
      const carousel = document.getElementById("shorts-carousel");
      const prevBtn = document.getElementById("shorts-prev");
      const nextBtn = document.getElementById("shorts-next");

      if (carousel && prevBtn && nextBtn) {
        const getScrollAmount = () => carousel.clientWidth * 0.75;
        prevBtn.addEventListener("click", () => {
          carousel.scrollBy({ left: -getScrollAmount(), behavior: "smooth" });
        });
        nextBtn.addEventListener("click", () => {
          carousel.scrollBy({ left: getScrollAmount(), behavior: "smooth" });
        });
      }

      function attachInteractiveElements() {
        // Hide short caption overlay and play icon when user clicks play, and pause other active shorts
        document.querySelectorAll('.modular-short-embed').forEach((container) => {
          const yt = container.querySelector('lite-youtube');
          if (yt && !yt.dataset.playBound) {
            yt.dataset.playBound = 'true';
            yt.addEventListener('click', () => {
              const caption = container.querySelector('.short-caption');
              const icon = container.querySelector('.short-play-icon');
              const darkFilter = container.querySelector('.short-dark-filter');
              if (caption) caption.style.display = 'none';
              if (icon) icon.style.display = 'none';
              if (darkFilter) darkFilter.style.display = 'none';

              // Pause any other currently playing shorts
              document.querySelectorAll('.modular-short-embed lite-youtube iframe').forEach((iframe) => {
                if (iframe.parentElement !== yt) {
                  try {
                    iframe.contentWindow.postMessage('{"event":"command","func":"pauseVideo","args":""}', '*');
                  } catch (e) {}
                }
              });
            });
          }
        });

        // Fullscreen toggle for shorts (Native Fullscreen API)
        document.querySelectorAll('.short-fullscreen-btn').forEach(function (btn) {
          if (!btn.dataset.bound) {
            btn.dataset.bound = 'true';
            btn.addEventListener('click', function (e) {
              e.stopPropagation();
              e.preventDefault();
              var container = btn.closest('.modular-short-embed');
              if (!container) return;

              var isFs = !!(document.fullscreenElement || document.webkitFullscreenElement);
              if (isFs) {
                if (document.exitFullscreen) {
                  document.exitFullscreen();
                } else if (document.webkitExitFullscreen) {
                  document.webkitExitFullscreen();
                }
              } else {
                var yt = container.querySelector('lite-youtube');
                if (yt && !yt.classList.contains('lyt-activated')) {
                  yt.click();
                }
                if (container.requestFullscreen) {
                  container.requestFullscreen();
                } else if (container.webkitRequestFullscreen) {
                  container.webkitRequestFullscreen();
                }
              }
            });
          }
        });

        // Double-click on card toggles fullscreen
        document.querySelectorAll('.modular-short-embed').forEach(function (container) {
          if (!container.dataset.dblBound) {
            container.dataset.dblBound = 'true';
            container.addEventListener('dblclick', function (e) {
              if (e.target.closest('button')) return;
              var fsBtn = container.querySelector('.short-fullscreen-btn');
              if (fsBtn) fsBtn.click();
            });
          }
        });

        // Trigger deep-dive video playback when clicking anywhere on the card
        document.querySelectorAll('.deep-dive-card').forEach((card) => {
          if (!card.dataset.clickBound) {
            card.dataset.clickBound = 'true';
            card.addEventListener('click', (e) => {
              const yt = card.querySelector('lite-youtube');
              if (!yt || yt.contains(e.target)) return;
              const playBtn = yt.querySelector('.lty-playbtn');
              if (playBtn) {
                playBtn.click();
              } else {
                yt.click();
              }
            });
          }
        });

        // Desktop master calendar screenshot full-screen modal
        attachDesktopScreenshotModal();
      }

      function attachDesktopScreenshotModal() {
        var modal = document.getElementById('desktop-screenshot-modal');
        if (!modal) return;

        function openModal(e) {
          if (e && e.preventDefault) e.preventDefault();
          modal.classList.remove('hidden');
          // Force layout reflow before triggering opacity transition
          void modal.offsetWidth;
          modal.classList.remove('opacity-0', 'pointer-events-none');
          modal.classList.add('opacity-100', 'pointer-events-auto');
          document.body.style.overflow = 'hidden';
        }

        function closeModal(e) {
          if (e && e.preventDefault) e.preventDefault();
          modal.classList.add('opacity-0', 'pointer-events-none');
          modal.classList.remove('opacity-100', 'pointer-events-auto');
          document.body.style.overflow = '';
          setTimeout(function () {
            if (modal.classList.contains('pointer-events-none')) {
              modal.classList.add('hidden');
            }
          }, 300);
        }

        if (!modal.dataset.bound) {
          modal.dataset.bound = 'true';

          // Robust click delegation: handles mac-fullscreen-btn, header-zoom-btn, desktop-mockup-screen, close-btn, and backdrop
          document.addEventListener('click', function (e) {
            var target = e.target;
            if (!target) return;

            // Trigger modal open (only from green window button or header zoom button)
            if (target.closest('#mac-fullscreen-btn, #header-zoom-btn')) {
              openModal(e);
              return;
            }

            // Close modal when active
            if (!modal.classList.contains('pointer-events-none')) {
              if (target.closest('#close-desktop-screenshot') || (modal.contains(target) && !target.closest('img'))) {
                closeModal(e);
              }
            }
          });

          // Pressing Escape closes modal
          document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape' && !modal.classList.contains('pointer-events-none')) {
              closeModal(e);
            }
          });
        }
      }

      function handleFsChange() {
        var isFs = !!(document.fullscreenElement || document.webkitFullscreenElement);
        document.querySelectorAll('.short-fullscreen-btn').forEach(function (btn) {
          var expand = btn.querySelector('.fs-expand-icon');
          var compress = btn.querySelector('.fs-compress-icon');
          if (expand && compress) {
            expand.style.display = isFs ? 'none' : 'block';
            compress.style.display = isFs ? 'block' : 'none';
          }
          btn.setAttribute('title', isFs ? 'Exit full screen' : 'Full screen');
          btn.setAttribute('aria-label', isFs ? 'Exit full screen' : 'Full screen');
        });
      }
      document.removeEventListener('fullscreenchange', handleFsChange);
      document.addEventListener('fullscreenchange', handleFsChange);
      document.removeEventListener('webkitfullscreenchange', handleFsChange);
      document.addEventListener('webkitfullscreenchange', handleFsChange);

      attachInteractiveElements();
      document.addEventListener('astro:page-load', attachInteractiveElements);

      // Book a Demo Form Handling
      function attachDemoForm() {
        const form = document.getElementById('demo-banner-form');
        if (!form || form.dataset.bound) return;
        form.dataset.bound = 'true';
        form.addEventListener('submit', function (e) {
          e.preventDefault();
          const emailInput = form.querySelector('input[name="email"]');
          const email = emailInput ? emailInput.value : '';
          if (email) {
            if (typeof window.ddSetEmail === 'function') {
              window.ddSetEmail(email);
            }
            if (typeof window.bento !== 'undefined' && typeof window.bento.identify === 'function') {
              window.bento.identify(email);
            }

            fetch('/api/bento-track', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                email: email,
                event: 'Demo Subscriber',
                source: window.location.pathname,
                landingPage: sessionStorage.getItem('dd_landing_page') || window.location.href,
                visitorUuid: (typeof window.getBentoVisitorUuid === 'function') ? window.getBentoVisitorUuid() : null,
                attribution: (typeof window.ddGetAttribution === 'function') ? window.ddGetAttribution() : null
              }),
              keepalive: true
            }).catch(function () {});
          }
          if (typeof window.ddOpenCalendly === 'function') {
            window.ddOpenCalendly(CALENDLY_BRAND_PARAMS);
          } else {
            window.open(CALENDLY_FALLBACK_URL, '_blank', 'noopener');
          }
          form.reset();
        });
      }

      attachDemoForm();
      document.addEventListener('astro:page-load', attachDemoForm);
    })();
  </script>
</Layout>
