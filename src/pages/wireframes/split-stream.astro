---
export const prerender = true;

import Layout from "../../layouts/Layout.astro";
import Navigation from "../../components/Navigation.astro";
import Footer from "../../components/Footer.astro";
import CTA from "../../components/home/CTA.astro";
import WireframeToolbar from "../../components/wireframes/WireframeToolbar.astro";
import { getWireframeData } from "../../lib/wireframe-data";
import { Image } from "astro:assets";

const { evergreenPosts, discoverPosts, topics } = await getWireframeData();

const today = new Date().toLocaleDateString("en-US", {
  weekday: "long",
  month: "long",
  day: "numeric",
  year: "numeric",
});

const title = "Resource Hub — Equal Split (50/50) | DataDocks";
const description = "Guides, checklists, and insights for warehouse and dock operations teams.";
---

<Layout title={title} description={description}>
  <WireframeToolbar currentVariant="split-stream" />
  <Navigation />

  <main class="min-h-screen bg-[#FFF8E9] text-gray-900 font-sans pb-20">
    {/* HERO HEADER */}
    <header class="pt-14 pb-10 border-b border-black/10">
      <div class="max-w-7xl mx-auto px-4 md:px-8">
        <div class="text-xs font-mono text-gray-600 uppercase tracking-wider mb-2">
          {today}
        </div>
        <h1 class="text-4xl md:text-6xl font-bruta uppercase tracking-tight text-black leading-none">
          Resource Hub: <span class="text-[#fd4f00]">Guides & Articles</span>
        </h1>
        <p class="mt-3 text-base md:text-lg text-gray-700 max-w-2xl font-recoleta">
          Practical strategies, dock scheduling playbooks, and carrier management workflows for warehouse operations.
        </p>

        {/* TOPIC FILTERS */}
        <div class="mt-8 flex items-center gap-2 overflow-x-auto pb-1 scrollbar-none" id="topic-filters">
          {topics.map((topic, i) => (
            <button
              type="button"
              data-filter={topic}
              class={`px-3.5 py-1.5 rounded-full text-xs font-mono transition-all shrink-0 border ${
                i === 0
                  ? "bg-black text-white border-black font-semibold"
                  : "bg-white text-gray-700 border-black/15 hover:border-black/40 hover:bg-gray-50"
              }`}
            >
              {topic}
            </button>
          ))}
        </div>
      </div>
    </header>

    {/* 50/50 SIDE-BY-SIDE GRID */}
    <div class="max-w-7xl mx-auto px-4 md:px-8 mt-10">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12 items-start">
        
        {/* LEFT COLUMN: CORE PLAYBOOKS (EVERGREEN) */}
        <section class="space-y-6">
          <div class="flex items-center justify-between pb-3 border-b-2 border-black">
            <div class="flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full bg-[#fd4f00]"></span>
              <h2 class="font-bruta text-2xl md:text-3xl uppercase tracking-tight text-black">
                Core Playbooks
              </h2>
            </div>
            <span class="text-xs font-mono text-gray-500">
              {evergreenPosts.length} Essential Guides
            </span>
          </div>

          <div class="space-y-6" id="evergreen-feed">
            {evergreenPosts.map((post) => (
              <article
                class="group bg-white rounded-2xl border border-black/10 overflow-hidden hover:border-[#fd4f00] hover:shadow-md transition-all flex flex-col relative"
                data-topic={post.topic}
              >
                <div class="aspect-[16/9] w-full bg-gray-100 overflow-hidden relative">
                  {post.data.cardImage ? (
                    <Image
                      src={post.data.cardImage}
                      alt={post.data.cardAlt || post.data.title}
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                      loading="lazy"
                    />
                  ) : (
                    <div class="w-full h-full bg-[#FAF8F5] flex items-center justify-center p-4">
                      <span class="text-xs font-mono text-gray-500 uppercase">{post.topic}</span>
                    </div>
                  )}
                  <span class="absolute top-3 left-3 bg-black text-white text-[11px] font-mono font-bold px-2 py-0.5 rounded">
                    #{post.rank} {post.topic}
                  </span>
                </div>

                <div class="p-6 flex-1 flex flex-col justify-between">
                  <div>
                    <div class="text-xs font-mono text-gray-500 mb-2">
                      {post.displayDate}
                    </div>
                    <h3 class="font-bruta text-xl md:text-2xl uppercase leading-tight text-black group-hover:text-[#fd4f00] transition-colors">
                      <a href={`/posts/${post.slug}`} class="after:absolute after:inset-0">
                        {post.data.title}
                      </a>
                    </h3>
                    <p class="mt-2 text-sm text-gray-600 font-recoleta line-clamp-3 leading-relaxed">
                      {post.data.description || "In-depth guide covering key operational practices and dock scheduling strategies."}
                    </p>
                  </div>

                  <div class="mt-5 pt-3 border-t border-black/5 flex items-center justify-between text-xs font-mono text-gray-500">
                    <span>By {post.data.author}</span>
                    <span class="font-bold text-black group-hover:text-[#fd4f00]">Read Guide →</span>
                  </div>
                </div>
              </article>
            ))}
          </div>
        </section>

        {/* RIGHT COLUMN: LATEST ARTICLES (DISCOVER) */}
        <section class="space-y-6">
          <div class="flex items-center justify-between pb-3 border-b-2 border-black">
            <h2 class="font-bruta text-2xl md:text-3xl uppercase tracking-tight text-black">
              Latest Articles
            </h2>
            <span class="text-xs font-mono text-gray-500">
              Newest First
            </span>
          </div>

          <div class="space-y-6" id="discover-feed">
            {discoverPosts.map((post) => (
              <article
                class="group bg-white rounded-2xl border border-black/10 overflow-hidden hover:border-[#fd4f00] hover:shadow-md transition-all flex flex-col relative"
                data-topic={post.topic}
              >
                <div class="aspect-[16/9] w-full bg-gray-100 overflow-hidden relative">
                  {post.data.cardImage ? (
                    <Image
                      src={post.data.cardImage}
                      alt={post.data.cardAlt || post.data.title}
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                      loading="lazy"
                    />
                  ) : (
                    <div class="w-full h-full bg-[#FAF8F5] flex items-center justify-center p-4">
                      <span class="text-xs font-mono text-gray-500 uppercase">{post.topic}</span>
                    </div>
                  )}
                  <span class="absolute top-3 left-3 bg-[#fd4f00] text-white text-[11px] font-mono font-bold px-2 py-0.5 rounded uppercase">
                    {post.topic}
                  </span>
                </div>

                <div class="p-6 flex-1 flex flex-col justify-between">
                  <div>
                    <div class="text-xs font-mono text-gray-500 mb-2">
                      {post.displayDate}
                    </div>
                    <h3 class="font-bruta text-xl md:text-2xl uppercase leading-tight text-black group-hover:text-[#fd4f00] transition-colors">
                      <a href={`/posts/${post.slug}`} class="after:absolute after:inset-0">
                        {post.data.title}
                      </a>
                    </h3>
                    <p class="mt-2 text-sm text-gray-600 font-recoleta line-clamp-3 leading-relaxed">
                      {post.data.description || "Read practical warehouse insights, carrier scheduling strategies, and dock management."}
                    </p>
                  </div>

                  <div class="mt-5 pt-3 border-t border-black/5 flex items-center justify-between text-xs font-mono text-gray-500">
                    <span>By {post.data.author}</span>
                    <span class="font-bold text-black group-hover:text-[#fd4f00]">Read Article →</span>
                  </div>
                </div>
              </article>
            ))}
          </div>
        </section>

      </div>
    </div>
  </main>

  <CTA />
  <Footer />

  <script is:inline>
    (function () {
      const buttons = document.querySelectorAll("[data-filter]");
      const evergreenCards = document.querySelectorAll("#evergreen-feed article");
      const discoverCards = document.querySelectorAll("#discover-feed article");

      buttons.forEach((btn) => {
        btn.addEventListener("click", () => {
          const selected = btn.getAttribute("data-filter");

          buttons.forEach((b) => {
            if (b === btn) {
              b.className = "px-3.5 py-1.5 rounded-full text-xs font-mono transition-all shrink-0 border bg-black text-white border-black font-semibold";
            } else {
              b.className = "px-3.5 py-1.5 rounded-full text-xs font-mono transition-all shrink-0 border bg-white text-gray-700 border-black/15 hover:border-black/40 hover:bg-gray-50";
            }
          });

          evergreenCards.forEach((c) => {
            const topic = c.getAttribute("data-topic");
            c.style.display = (selected === "All Topics" || topic === selected) ? "flex" : "none";
          });

          discoverCards.forEach((c) => {
            const topic = c.getAttribute("data-topic");
            c.style.display = (selected === "All Topics" || topic === selected) ? "flex" : "none";
          });
        });
      });
    })();
  </script>
</Layout>
