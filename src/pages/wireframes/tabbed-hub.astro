---
export const prerender = true;

import Layout from "../../layouts/Layout.astro";
import Navigation from "../../components/Navigation.astro";
import Footer from "../../components/Footer.astro";
import CTA from "../../components/home/CTA.astro";
import WireframeToolbar from "../../components/wireframes/WireframeToolbar.astro";
import { getWireframeData } from "../../lib/wireframe-data";
import { Image } from "astro:assets";

const { evergreenPosts, discoverPosts, topics } = await getWireframeData();

const featuredEvergreen = evergreenPosts[0];
const remainingEvergreen = evergreenPosts.slice(1);

const featuredDiscover = discoverPosts[0];
const remainingDiscover = discoverPosts.slice(1);

const today = new Date().toLocaleDateString("en-US", {
  weekday: "long",
  month: "long",
  day: "numeric",
  year: "numeric",
});

const title = "Resource Hub — Featured Pair + Split | DataDocks";
const description = "Top featured playbooks followed by side-by-side core guides and latest releases.";
---

<Layout title={title} description={description}>
  <WireframeToolbar currentVariant="tabbed-hub" />
  <Navigation />

  <main class="min-h-screen bg-[#FFF8E9] text-gray-900 font-sans pb-20">
    {/* HERO HEADER */}
    <header class="pt-14 pb-10 border-b border-black/10">
      <div class="max-w-7xl mx-auto px-4 md:px-8">
        <div class="text-xs font-mono text-gray-600 uppercase tracking-wider mb-2">
          {today}
        </div>
        <h1 class="text-4xl md:text-6xl font-bruta uppercase tracking-tight text-black leading-none">
          DataDocks <span class="text-[#fd4f00]">Resource Hub</span>
        </h1>
        <p class="mt-3 text-base md:text-lg text-gray-700 max-w-2xl font-recoleta">
          Explore foundational dock scheduling guides alongside our newest operational articles.
        </p>

        {/* TOPIC FILTERS */}
        <div class="mt-8 flex items-center gap-2 overflow-x-auto pb-1 scrollbar-none">
          {topics.map((topic, i) => (
            <button
              type="button"
              data-filter={topic}
              class={`px-3.5 py-1.5 rounded-full text-xs font-mono transition-all shrink-0 border ${
                i === 0
                  ? "bg-black text-white border-black font-semibold"
                  : "bg-white text-gray-700 border-black/15 hover:border-black/40 hover:bg-gray-50"
              }`}
            >
              {topic}
            </button>
          ))}
        </div>
      </div>
    </header>

    <div class="max-w-7xl mx-auto px-4 md:px-8 mt-12 space-y-16">
      
      {/* TOP SECTION: 2 FEATURED HERO CARDS SIDE-BY-SIDE */}
      <section>
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
          
          {/* Featured Evergreen */}
          {featuredEvergreen && (
            <article class="group bg-white rounded-2xl border-2 border-black p-6 md:p-8 flex flex-col justify-between shadow-md hover:shadow-xl transition-all relative">
              <div>
                <div class="aspect-video w-full rounded-xl bg-gray-100 overflow-hidden mb-6 relative">
                  {featuredEvergreen.data.cardImage ? (
                    <Image
                      src={featuredEvergreen.data.cardImage}
                      alt={featuredEvergreen.data.cardAlt || featuredEvergreen.data.title}
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                      loading="eager"
                    />
                  ) : (
                    <div class="w-full h-full bg-[#FAF8F5] flex items-center justify-center">
                      <span class="text-xs font-mono text-gray-500">{featuredEvergreen.topic}</span>
                    </div>
                  )}
                  <span class="absolute top-3 left-3 bg-[#fd4f00] text-white text-xs font-mono font-bold px-2.5 py-1 rounded uppercase">
                    Featured Playbook
                  </span>
                </div>

                <div class="text-xs font-mono text-gray-500 mb-2">
                  {featuredEvergreen.displayDate}
                </div>

                <h2 class="font-bruta text-2xl md:text-3xl uppercase leading-tight text-black group-hover:text-[#fd4f00] transition-colors">
                  <a href={`/posts/${featuredEvergreen.slug}`} class="after:absolute after:inset-0">
                    {featuredEvergreen.data.title}
                  </a>
                </h2>

                <p class="mt-3 text-sm text-gray-600 font-recoleta line-clamp-3 leading-relaxed">
                  {featuredEvergreen.data.description || "Our comprehensive foundational guide covering yard and dock operations."}
                </p>
              </div>

              <div class="mt-6 pt-4 border-t border-black/10 flex items-center justify-between text-xs font-mono text-gray-500">
                <span>By {featuredEvergreen.data.author}</span>
                <span class="font-bold text-black group-hover:text-[#fd4f00]">Read Guide →</span>
              </div>
            </article>
          )}

          {/* Featured Latest */}
          {featuredDiscover && (
            <article class="group bg-white rounded-2xl border-2 border-black/15 p-6 md:p-8 flex flex-col justify-between shadow-sm hover:shadow-xl transition-all relative">
              <div>
                <div class="aspect-video w-full rounded-xl bg-gray-100 overflow-hidden mb-6 relative">
                  {featuredDiscover.data.cardImage ? (
                    <Image
                      src={featuredDiscover.data.cardImage}
                      alt={featuredDiscover.data.cardAlt || featuredDiscover.data.title}
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                      loading="eager"
                    />
                  ) : (
                    <div class="w-full h-full bg-[#FAF8F5] flex items-center justify-center">
                      <span class="text-xs font-mono text-gray-500">{featuredDiscover.topic}</span>
                    </div>
                  )}
                  <span class="absolute top-3 left-3 bg-black text-white text-xs font-mono font-bold px-2.5 py-1 rounded uppercase">
                    Latest Article
                  </span>
                </div>

                <div class="text-xs font-mono text-gray-500 mb-2">
                  {featuredDiscover.displayDate}
                </div>

                <h2 class="font-bruta text-2xl md:text-3xl uppercase leading-tight text-black group-hover:text-[#fd4f00] transition-colors">
                  <a href={`/posts/${featuredDiscover.slug}`} class="after:absolute after:inset-0">
                    {featuredDiscover.data.title}
                  </a>
                </h2>

                <p class="mt-3 text-sm text-gray-600 font-recoleta line-clamp-3 leading-relaxed">
                  {featuredDiscover.data.description || "Read our newest practical takeaways for modern warehouse operations."}
                </p>
              </div>

              <div class="mt-6 pt-4 border-t border-black/10 flex items-center justify-between text-xs font-mono text-gray-500">
                <span>By {featuredDiscover.data.author}</span>
                <span class="font-bold text-black group-hover:text-[#fd4f00]">Read Article →</span>
              </div>
            </article>
          )}

        </div>
      </section>

      {/* LOWER SECTION: SIDE-BY-SIDE FEEDS (50/50) */}
      <section>
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12 items-start">
          
          {/* Left Column: More Core Guides */}
          <div class="space-y-6">
            <div class="pb-3 border-b-2 border-black">
              <h3 class="font-bruta text-2xl uppercase tracking-tight text-black">
                More Core Playbooks
              </h3>
            </div>

            <div class="space-y-4" id="more-evergreen-feed">
              {remainingEvergreen.map((post) => (
                <article
                  class="group bg-white rounded-xl border border-black/10 p-5 hover:border-[#fd4f00] hover:shadow-sm transition-all relative flex flex-col justify-between"
                  data-topic={post.topic}
                >
                  <div>
                    <div class="flex items-center justify-between text-xs font-mono text-gray-500 mb-2">
                      <span class="text-[#fd4f00] font-bold">#{post.rank} {post.topic}</span>
                      <span>{post.displayDate}</span>
                    </div>

                    <h4 class="font-bruta text-lg md:text-xl uppercase leading-snug text-black group-hover:text-[#fd4f00] transition-colors">
                      <a href={`/posts/${post.slug}`} class="after:absolute after:inset-0">
                        {post.data.title}
                      </a>
                    </h4>

                    <p class="mt-2 text-xs text-gray-600 font-recoleta line-clamp-2">
                      {post.data.description || "Key guide for warehouse and logistics teams."}
                    </p>
                  </div>

                  <div class="mt-4 pt-2 border-t border-black/5 flex items-center justify-between text-xs font-mono text-gray-500">
                    <span>By {post.data.author}</span>
                    <span class="font-bold text-black group-hover:text-[#fd4f00]">Read Guide →</span>
                  </div>
                </article>
              ))}
            </div>
          </div>

          {/* Right Column: Recent Articles */}
          <div class="space-y-6">
            <div class="pb-3 border-b-2 border-black">
              <h3 class="font-bruta text-2xl uppercase tracking-tight text-black">
                Recent Articles
              </h3>
            </div>

            <div class="space-y-4" id="more-discover-feed">
              {remainingDiscover.map((post) => (
                <article
                  class="group bg-white rounded-xl border border-black/10 p-5 hover:border-[#fd4f00] hover:shadow-sm transition-all relative flex flex-col justify-between"
                  data-topic={post.topic}
                >
                  <div>
                    <div class="flex items-center justify-between text-xs font-mono text-gray-500 mb-2">
                      <span class="text-[#fd4f00] font-bold">{post.topic}</span>
                      <span>{post.displayDate}</span>
                    </div>

                    <h4 class="font-bruta text-lg md:text-xl uppercase leading-snug text-black group-hover:text-[#fd4f00] transition-colors">
                      <a href={`/posts/${post.slug}`} class="after:absolute after:inset-0">
                        {post.data.title}
                      </a>
                    </h4>

                    <p class="mt-2 text-xs text-gray-600 font-recoleta line-clamp-2">
                      {post.data.description || "Read practical warehouse insights and carrier scheduling playbooks."}
                    </p>
                  </div>

                  <div class="mt-4 pt-2 border-t border-black/5 flex items-center justify-between text-xs font-mono text-gray-500">
                    <span>By {post.data.author}</span>
                    <span class="font-bold text-black group-hover:text-[#fd4f00]">Read Article →</span>
                  </div>
                </article>
              ))}
            </div>
          </div>

        </div>
      </section>

    </div>
  </main>

  <CTA />
  <Footer />

  <script is:inline>
    (function () {
      const buttons = document.querySelectorAll("[data-filter]");
      const egCards = document.querySelectorAll("#more-evergreen-feed article");
      const dcCards = document.querySelectorAll("#more-discover-feed article");

      buttons.forEach((btn) => {
        btn.addEventListener("click", () => {
          const selected = btn.getAttribute("data-filter");

          buttons.forEach((b) => {
            if (b === btn) {
              b.className = "px-3.5 py-1.5 rounded-full text-xs font-mono transition-all shrink-0 border bg-black text-white border-black font-semibold";
            } else {
              b.className = "px-3.5 py-1.5 rounded-full text-xs font-mono transition-all shrink-0 border bg-white text-gray-700 border-black/15 hover:border-black/40 hover:bg-gray-50";
            }
          });

          egCards.forEach((c) => {
            const topic = c.getAttribute("data-topic");
            c.style.display = (selected === "All Topics" || topic === selected) ? "flex" : "none";
          });

          dcCards.forEach((c) => {
            const topic = c.getAttribute("data-topic");
            c.style.display = (selected === "All Topics" || topic === selected) ? "flex" : "none";
          });
        });
      });
    })();
  </script>
</Layout>
