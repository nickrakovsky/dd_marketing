---
export const prerender = true;

import Layout from "../../layouts/Layout.astro";
import Navigation from "../../components/Navigation.astro";
import Footer from "../../components/Footer.astro";
import CTA from "../../components/home/CTA.astro";
import WireframeToolbar from "../../components/wireframes/WireframeToolbar.astro";
import { getKnowledgeHubData } from "../../lib/wireframe-data";
import { ytThumb } from "../../lib/yt-thumb";
import { Image } from "astro:assets";

const { evergreenGuides, liveFeedItems, featureList, benefitsList } = await getKnowledgeHubData();

const today = new Date().toLocaleDateString("en-US", {
  weekday: "long",
  month: "long",
  day: "numeric",
  year: "numeric",
});

const title = "Dock & Yard Knowledge Hub | DataDocks";
const description = "Guides, checklists and insights for supply chain professionals, operations leaders and truck transportation managers.";
---

<Layout title={title} description={description}>
  <link
    rel="stylesheet"
    href="/css/lite-yt-embed.css"
    media="print"
    onload="this.media='all'"
  />
  <script is:inline src="/css/lite-yt-embed.js" defer></script>

  <style is:global>
    /* Custom responsive styling for lite-youtube in live news feed */
    .feed-video-embed lite-youtube {
      aspect-ratio: 16 / 9;
      width: 100%;
      max-width: 100%;
      border-radius: 0.5rem;
    }
    .feed-video-embed lite-youtube::after {
      padding-bottom: 56.25%;
    }
    .feed-short-embed lite-youtube {
      aspect-ratio: 9 / 13;
      width: 100%;
      max-width: 100%;
      border-radius: 0;
      background-position: center center;
      background-size: auto 125%;
      background-repeat: no-repeat;
    }
    .feed-short-embed lite-youtube::after {
      padding-bottom: calc(100% * (13 / 9));
    }
    .feed-short-embed lite-youtube::before {
      display: none;
    }
  </style>

  <WireframeToolbar currentVariant="editorial-bento" />
  <Navigation />

  <main class="min-h-screen bg-[#FFF8E9] text-gray-900 font-sans pb-24">
    {/* HERO HEADER */}
    <header class="pt-14 pb-10 border-b border-black/10">
      <div class="max-w-7xl mx-auto px-4 md:px-8">
        <div>
          <h1 class="text-4xl sm:text-6xl lg:text-[68px] xl:text-[76px] font-bruta uppercase tracking-tight text-black leading-[0.9]">
            Dock & Yard <span class="text-[#fd4f00]">Knowledge Hub</span>
          </h1>
          
          {/* Dateline tight to H1 and slightly larger */}
          <div class="text-sm md:text-[15px] font-mono text-gray-500 uppercase tracking-widest mt-1">
            {today}
          </div>
        </div>

        {/* Subtitle constrained to not cross the 50% midway vertical line on desktop (wider than portrait tablet) */}
        <p class="mt-5 text-base md:text-lg text-gray-700 w-full lg:max-w-[50%] font-recoleta leading-relaxed">
          Guides, checklists and insights for supply chain professionals, operations leaders and truck transportation managers.
        </p>
      </div>
    </header>

    {/* MAIN CONTENT AREA: 28% NARROW NEWS FEED ON LEFT (Reduced by 5%), 72% PLAYBOOKS & PLATFORM ON RIGHT */}
    <div class="max-w-7xl mx-auto px-4 md:px-8 mt-10">
      <div class="grid grid-cols-1 lg:grid-cols-[28%_minmax(0,1fr)] gap-8 lg:gap-10 items-start">
        
        {/* LEFT COLUMN: LATEST INSIGHTS & NEWS (28% width) */}
        <section class="space-y-4">
          <div class="flex items-center gap-2 pb-2.5 border-b-2 border-black">
            <span class="w-2.5 h-2.5 rounded-full bg-[#fd4f00] animate-pulse"></span>
            <h2 class="font-bruta text-2xl md:text-3xl uppercase tracking-tight text-black">
              Latest Insights & News
            </h2>
          </div>

          <div class="space-y-3" id="live-news-feed">
            {liveFeedItems.map((item) => {
              const isShort = item.postType === 'short';
              const isVideo = item.postType === 'video';

              if (isShort && item.youtubeId) {
                // YouTube Short: 0-padding, top 10% & bottom 10% cropped (aspect 9/13), click-to-play lite-youtube embed
                return (
                  <article class="group bg-white rounded-xl border border-black/10 overflow-hidden hover:border-[#fd4f00] hover:shadow-sm transition-all relative flex flex-col">
                    <div class="p-3 pb-2 flex items-center justify-between text-[11px] font-mono text-gray-500">
                      <div class="flex items-center gap-1.5">
                        <span class="w-4 h-4 rounded-full bg-[#fd4f00] text-white flex items-center justify-center text-[9px] font-bold">▶</span>
                        <span class="font-bold text-black">{item.author}</span>
                      </div>
                      <span>{item.displayDate}</span>
                    </div>

                    <div class="px-3 pb-2.5">
                      <h3 class="font-sans font-bold text-xs md:text-sm text-gray-900 leading-snug group-hover:text-[#fd4f00] transition-colors line-clamp-2">
                        <a href={item.url}>
                          {item.title}
                        </a>
                      </h3>
                    </div>

                    {/* Edge-to-edge 0 padding, cropped top/bottom 10% (aspect 9/13), click replaces with playing lite-youtube */}
                    <div class="w-full aspect-[9/13] bg-black relative overflow-hidden feed-short-embed">
                      <lite-youtube
                        videoid={item.youtubeId}
                        playlabel={item.title}
                        params="autoplay=1"
                        style={`background-image: url('${ytThumb(item.youtubeId, 'sdwebp')}'); background-position: center center; background-size: auto 125%; background-repeat: no-repeat;`}
                        class="w-full h-full"
                      >
                        <div class="absolute bottom-2.5 left-2.5 bg-black/80 backdrop-blur-sm text-white text-[9px] font-mono font-bold px-2 py-0.5 rounded flex items-center gap-1.5 pointer-events-none z-10">
                          <span class="w-1.5 h-1.5 rounded-full bg-[#fd4f00]"></span>
                          <span>Short • {item.readTime}</span>
                        </div>
                      </lite-youtube>
                    </div>
                  </article>
                );
              }

              if (isVideo && item.youtubeId) {
                // Full Length YouTube Video: Social card with 16:9 click-to-play lite-youtube embed
                return (
                  <article class="group bg-white rounded-xl border border-black/10 overflow-hidden hover:border-[#fd4f00] hover:shadow-sm transition-all relative">
                    <div class="p-3 pb-2 flex items-center justify-between text-[11px] font-mono text-gray-500">
                      <div class="flex items-center gap-1.5">
                        <span class="w-4 h-4 rounded-full bg-black text-white flex items-center justify-center text-[9px] font-bold">DD</span>
                        <span class="font-bold text-black">{item.author}</span>
                      </div>
                      <span>{item.displayDate}</span>
                    </div>

                    <div class="px-3 pb-2">
                      <h3 class="font-sans font-bold text-xs md:text-sm text-gray-900 leading-snug group-hover:text-[#fd4f00] transition-colors line-clamp-2">
                        <a href={item.url}>
                          {item.title}
                        </a>
                      </h3>
                    </div>

                    <div class="mx-3 mb-3 aspect-video bg-black rounded-lg overflow-hidden relative feed-video-embed">
                      <lite-youtube
                        videoid={item.youtubeId}
                        playlabel={item.title}
                        params="autoplay=1"
                        style={`background-image: url('${ytThumb(item.youtubeId, 'sdwebp')}');`}
                        class="w-full h-full"
                      >
                        <div class="absolute bottom-2 left-2 bg-black/80 backdrop-blur-sm text-white text-[9px] font-mono px-1.5 py-0.5 rounded pointer-events-none z-10">
                          Video • {item.readTime}
                        </div>
                      </lite-youtube>
                    </div>
                  </article>
                );
              }

              // Standard Non-Video Blog Post: Small text-first card WITHOUT image
              return (
                <article class="group bg-white rounded-xl border border-black/10 p-3.5 hover:border-[#fd4f00] hover:shadow-sm transition-all relative flex flex-col justify-between">
                  <div>
                    <div class="flex items-center justify-between text-[11px] font-mono text-gray-500 mb-1.5">
                      <div class="flex items-center gap-1.5">
                        <span class="w-4 h-4 rounded-full bg-[#FAF8F5] border border-black/10 text-black flex items-center justify-center text-[9px] font-bold">
                          {item.author.charAt(0)}
                        </span>
                        <span class="font-bold text-black truncate max-w-[140px]">{item.author}</span>
                      </div>
                      <span class="shrink-0">{item.displayDate}</span>
                    </div>

                    <h3 class="font-sans font-bold text-xs md:text-sm text-gray-900 leading-snug group-hover:text-[#fd4f00] transition-colors line-clamp-2">
                      <a href={item.url} class="after:absolute after:inset-0">
                        {item.title}
                      </a>
                    </h3>

                    <p class="mt-1.5 text-xs text-gray-600 font-recoleta line-clamp-2 leading-relaxed">
                      {item.description}
                    </p>
                  </div>

                  <div class="mt-3 pt-2 border-t border-black/5 flex items-center justify-between text-[11px] font-mono text-gray-500">
                    <span>{item.readTime || '4 min read'}</span>
                    <span class="font-bold text-black group-hover:text-[#fd4f00]">Read ↗</span>
                  </div>
                </article>
              );
            })}
          </div>
        </section>

        {/* RIGHT COLUMN: PLAYBOOKS & GUIDES + FEATURES + BENEFITS (72% width) */}
        <section class="space-y-16">
          
          {/* 1. PLAYBOOKS & GUIDES (2-COL CARD GRID) */}
          <div class="space-y-6">
            <div class="pb-2.5 border-b-2 border-black">
              <h2 class="font-bruta text-2xl md:text-3xl uppercase tracking-tight text-black">
                Playbooks & Guides
              </h2>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
              {evergreenGuides.map((guide) => (
                <article class="group bg-white rounded-2xl border border-black/10 overflow-hidden hover:border-[#fd4f00] hover:shadow-md transition-all flex flex-col justify-between relative">
                  <div>
                    {guide.cardImage ? (
                      <div class="aspect-[16/10] w-full bg-gray-100 overflow-hidden relative">
                        <Image
                          src={guide.cardImage}
                          alt={guide.cardAlt || guide.title}
                          class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                          loading="lazy"
                        />
                      </div>
                    ) : (
                      <div class="aspect-[16/10] w-full bg-[#FAF8F5] border-b border-black/5 flex items-center justify-center p-4">
                        <span class="text-xs font-mono text-gray-500 uppercase">Foundational Guide</span>
                      </div>
                    )}

                    <div class="p-5">
                      <div class="text-xs font-mono text-gray-500 mb-2">
                        {guide.displayDate}
                      </div>

                      <h3 class="font-bruta text-xl md:text-2xl uppercase leading-tight text-black group-hover:text-[#fd4f00] transition-colors line-clamp-2">
                        <a href={guide.url} class="after:absolute after:inset-0">
                          {guide.title}
                        </a>
                      </h3>

                      <p class="mt-2 text-xs md:text-sm text-gray-600 font-recoleta line-clamp-3 leading-relaxed">
                        {guide.description}
                      </p>
                    </div>
                  </div>

                  <div class="px-5 pb-4 pt-2 border-t border-black/5 flex items-center justify-between text-xs font-mono text-gray-500">
                    <span>{guide.readTime || '5 min read'}</span>
                    <span class="font-bold text-black group-hover:text-[#fd4f00]">Read Guide →</span>
                  </div>
                </article>
              ))}
            </div>
          </div>

          {/* 2. DATADOCKS FEATURES (CAROUSEL SHOWING EXACTLY 3 WHOLE CARDS ON DESKTOP) */}
          <div class="space-y-6 pt-4 border-t-2 border-black/10">
            <div class="flex items-center justify-between pb-3 border-b border-black/10">
              <div>
                <h2 class="font-bruta text-2xl md:text-3xl uppercase tracking-tight text-black">
                  DataDocks Features
                </h2>
                <p class="text-xs text-gray-600 font-recoleta mt-0.5">
                  12 core capabilities built for high-throughput docks and yards.
                </p>
              </div>

              {/* Carousel Controls */}
              <div class="flex items-center gap-2">
                <button
                  type="button"
                  id="feat-prev-btn"
                  class="w-8 h-8 rounded-full border border-black/15 bg-white flex items-center justify-center hover:bg-black hover:text-white transition-colors text-sm font-bold"
                  aria-label="Previous Feature"
                >
                  ←
                </button>
                <button
                  type="button"
                  id="feat-next-btn"
                  class="w-8 h-8 rounded-full border border-black/15 bg-white flex items-center justify-center hover:bg-black hover:text-white transition-colors text-sm font-bold"
                  aria-label="Next Feature"
                >
                  →
                </button>
              </div>
            </div>

            {/* Scrollable Shelf: 3 whole cards on desktop, 2 on tablet, 1 on mobile */}
            <div
              id="features-carousel"
              class="flex gap-4 overflow-x-auto pb-4 scrollbar-none snap-x snap-mandatory scroll-smooth"
            >
              {featureList.map((feat) => (
                <a
                  href={feat.url}
                  class="group w-full sm:w-[calc((100%-1rem)/2)] lg:w-[calc((100%-2rem)/3)] shrink-0 snap-start p-5 rounded-2xl bg-white border border-black/10 hover:border-[#fd4f00] hover:shadow-md transition-all flex flex-col justify-between"
                >
                  <div>
                    <span class="text-[10px] font-mono uppercase tracking-wider text-[#fd4f00] font-bold block mb-2">
                      Feature
                    </span>
                    <h4 class="font-bruta text-lg uppercase leading-tight text-black group-hover:text-[#fd4f00] transition-colors mb-2">
                      {feat.title}
                    </h4>
                    <p class="text-xs text-gray-600 font-recoleta line-clamp-3 leading-relaxed">
                      {feat.description}
                    </p>
                  </div>

                  <div class="mt-4 pt-3 border-t border-black/5 flex items-center justify-between text-xs font-mono text-gray-500">
                    <span>Explore</span>
                    <span class="font-bold text-black group-hover:text-[#fd4f00]">View Feature →</span>
                  </div>
                </a>
              ))}
            </div>
          </div>

          {/* 3. 2x2 CARD GRID FOR THE 4 BENEFITS PAGES */}
          <div class="space-y-6 pt-4 border-t-2 border-black/10">
            <div class="pb-3 border-b border-black/10">
              <h3 class="font-bruta text-xl md:text-2xl uppercase tracking-tight text-black">
                Operational Benefits
              </h3>
              <p class="text-xs text-gray-600 font-recoleta mt-0.5">
                Measurable outcomes experienced by warehouse operations teams.
              </p>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              {benefitsList.map((benefit) => (
                <a
                  href={benefit.url}
                  class="group p-5 rounded-2xl bg-white border border-black/10 hover:border-[#fd4f00] hover:shadow-md transition-all flex flex-col justify-between"
                >
                  <div>
                    <span class="text-[10px] font-mono uppercase tracking-wider text-gray-500 block mb-1.5">
                      {benefit.tag}
                    </span>
                    <h4 class="font-bruta text-xl uppercase leading-tight text-black group-hover:text-[#fd4f00] transition-colors mb-2">
                      {benefit.title}
                    </h4>
                    <p class="text-xs md:text-sm text-gray-600 font-recoleta leading-relaxed">
                      {benefit.description}
                    </p>
                  </div>

                  <div class="mt-4 pt-3 border-t border-black/5 flex items-center justify-between text-xs font-mono text-gray-500">
                    <span>Learn More</span>
                    <span class="font-bold text-black group-hover:text-[#fd4f00]">See Details →</span>
                  </div>
                </a>
              ))}
            </div>
          </div>

        </section>

      </div>
    </div>
  </main>

  <CTA />
  <Footer />

  <script is:inline>
    (function () {
      const carousel = document.getElementById("features-carousel");
      const prevBtn = document.getElementById("feat-prev-btn");
      const nextBtn = document.getElementById("feat-next-btn");

      if (carousel && prevBtn && nextBtn) {
        const getScrollAmount = () => carousel.clientWidth;
        prevBtn.addEventListener("click", () => {
          carousel.scrollBy({ left: -getScrollAmount(), behavior: "smooth" });
        });
        nextBtn.addEventListener("click", () => {
          carousel.scrollBy({ left: getScrollAmount(), behavior: "smooth" });
        });
      }
    })();
  </script>
</Layout>
