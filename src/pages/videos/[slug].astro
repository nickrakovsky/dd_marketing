---
import { getCollection } from 'astro:content';
import VideoPage from '../../components/pages/VideoPage.astro';
import NotFound from '../404.astro';
import { isPublished } from '../../lib/content-status';

export const prerender = false;

const { slug } = Astro.params;
// Preserve the lowercase aliases previously emitted by getStaticPaths.
const entries = await getCollection('videos');
const entry = entries.find(item => item.slug === slug)
  ?? entries.find(item => item.slug.toLowerCase() === slug);
const published = entry && isPublished(entry.data.pubDate, Astro.locals.publicationDate);
if (!published) {
  Astro.response.status = 404;
  Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');
}
---

{published ? <VideoPage entry={entry} /> : <NotFound />}
