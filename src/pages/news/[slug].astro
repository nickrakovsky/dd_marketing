---
export const prerender = true;

import type { CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.astro';
import Footer from '../../components/Footer.astro';
import { getNewsEntries, newsDateLabel, toNewsItem } from '../../lib/news';
import DemoCapture from '../../components/home-revamp/DemoCapture.astro';
import CTA from '../../components/home/CTA.astro';
import LinkIcon from '../../components/LinkIcon.astro';

export async function getStaticPaths() {
  return (await getNewsEntries())
    .filter(entry => entry.data.destination === 'internal')
    .map(entry => ({ params: { slug: entry.slug }, props: { entry } }));
}

interface Props { entry: CollectionEntry<'news'> }
const { entry } = Astro.props;
const { data } = entry;
const item = toNewsItem(entry);
const { Content } = await entry.render();
const sources = [...(data.sourceUrl ? [{ label: data.sourceName, url: data.sourceUrl }] : []), ...data.sources]
  .filter((source, index, list) => list.findIndex(other => other.url === source.url) === index);
const publishedDate = data.publishedAt.toISOString().slice(0, 10);
const related = (await getNewsEntries())
  .filter(other => other.slug !== entry.slug)
  .sort((a, b) => Number(b.data.kind === data.kind) - Number(a.data.kind === data.kind))
  .slice(0, 2).map(toNewsItem);
---

<Layout
  title={`${data.title} | DataDocks`}
  description={data.summary}
  type="article"
  schemaData={{ newsArticle: {
    headline: data.title,
    datePublished: data.publishedAt,
    dateModified: data.updatedAt,
    section: item.kindLabel,
    citations: sources.map(source => source.url),
  } }}
>
  <a href="#news-story" class="story-skip">Skip to story</a>
  <Navigation demoHref="#book-demo" />
  <main class="news-story" id="news-story">
    <header class="story-header story-container">
      <a class="story-back" href="/news"><LinkIcon kind="back" /> News & updates</a>
      <div class="story-kicker"><span>{item.kindLabel}</span><span>{data.sourceName}</span></div>
      <h1>{data.title}</h1>
      <p class="story-deck">{data.summary}</p>
      <div class="story-dates">
        <p>{data.dateContext}: {item.datetime ? <time datetime={item.datetime}>{item.dateLabel}</time> : 'Date not listed'}</p>
        <p>By DataDocks <span aria-hidden="true">·</span> {data.dateContext.startsWith('Originally') ? 'Recap published' : 'Published'} <time datetime={publishedDate}>{newsDateLabel(publishedDate)}</time></p>
      </div>
    </header>

    <div class="story-container story-grid">
      <article class="story-body">
        <Content />
        {sources.length > 0 && <section class="story-sources" aria-labelledby="story-sources-heading">
          <h2 id="story-sources-heading">Sources & original coverage</h2>
          <ul>{sources.map(source => <li><a href={source.url} target="_blank" rel="noopener noreferrer">{source.label} <LinkIcon kind="external" /><span class="sr-only"> (opens in a new tab)</span></a></li>)}</ul>
        </section>}
      </article>

      <aside class="story-aside" aria-label="Related information">
        {data.kind === 'award' && <section class="story-award">
          <span class="aside-label">Recognition</span>
          <p class="award-year">{item.year}</p>
          <h2>{data.program || data.sourceName}</h2>
          <p>{data.awardCategory}</p>
          {data.sourceUrl && <a href={data.sourceUrl} target="_blank" rel="noopener noreferrer">View on {data.sourceName} <LinkIcon kind="external" /><span class="sr-only"> (opens in a new tab)</span></a>}
        </section>}
        <section class="story-next">
          <span class="aside-label">Explore DataDocks</span>
          <h2>See DataDocks<br />at work</h2>
          <p>See how dock scheduling and yard management work together at your facility.</p>
          <ul>{data.relatedLinks.map(link => <li><a href={link.url}>{link.label} <LinkIcon /></a></li>)}</ul>
          <a class="story-demo" href="#book-demo">Book a demo <LinkIcon /></a>
        </section>
      </aside>
    </div>

    <section class="story-container story-related" aria-labelledby="related-heading">
      <div class="related-heading"><h2 id="related-heading">Keep reading</h2><a href="/news">All news & updates <LinkIcon /></a></div>
      <div class="related-grid">{related.map(other => <a href={other.href} class="related-card" target={other.external ? '_blank' : undefined} rel={other.external ? 'noopener noreferrer' : undefined}>
        <span class="related-meta"><span>{other.kindLabel}</span><span>{other.year}</span></span>
        <h3>{other.title}</h3>
        <span class="related-source">{other.external ? `Read on ${other.sourceName}` : 'Read the story'} <LinkIcon kind={other.external ? 'external' : 'internal'} />{other.external && <span class="sr-only"> (opens in a new tab)</span>}</span>
      </a>)}</div>
    </section>
  </main>
  <CTA captureFirst tabletInline microcopyFont="inter" />
  <DemoCapture standalone microcopyFont="inter" />
  <Footer />
</Layout>

<style>
  .news-story { background: #FFF8E9; color: #000; padding: 54px 0 80px; font-family: Inter, system-ui, sans-serif; }
  .story-container { width: min(1180px, calc(100% - 96px)); margin-inline: auto; }
  .story-skip { position: fixed; top: 8px; left: 8px; z-index: 200; padding: 12px 18px; background: #151515; color: #fff8ee; transform: translateY(-180%); }
  .story-skip:focus { transform: translateY(0); }
  .story-back { display: inline-flex; align-items: center; gap: 10px; font-size: 14px; font-weight: 600; margin-bottom: 60px; }
  .story-kicker { display: flex; gap: 8px 24px; flex-wrap: wrap; font-size: 15px; line-height: 1.5; margin-bottom: 22px; }
  .story-kicker span:first-child { font-weight: 600; }
  h1 { font-family: 'Bruta', 'Bruta-Fallback', Impact, sans-serif; font-weight: 800; text-transform: uppercase; font-size: clamp(46px, 6.8vw, 88px); line-height: .98; letter-spacing: -.012em; max-width: 1000px; text-wrap: balance; }
  .story-deck { font-family: 'DD-Recoleta', 'Recoleta-Fallback', Georgia, serif; font-size: clamp(20px, 2.5vw, 28px); max-width: 870px; line-height: 1.45; margin-top: 28px; }
  .story-dates { display: flex; flex-wrap: wrap; gap: 14px 36px; color: #665f56; font-size: 14px; margin: 32px 0 48px; padding-bottom: 26px; border-bottom: 1px solid #d2c9bb; }
  .story-grid { display: grid; grid-template-columns: minmax(0, 730px) minmax(240px, 1fr); gap: 80px; align-items: start; }
  .story-body { font-family: 'DD-Recoleta', 'Recoleta-Fallback', Georgia, serif; font-size: 18px; line-height: 1.8; }
  .story-body :global(p) { margin-bottom: 24px; }
  .story-body :global(h2) { font-family: 'DD-Recoleta', 'Recoleta-Fallback', Georgia, serif; font-size: 28px; line-height: 1.2; margin: 40px 0 18px; letter-spacing: -.02em; }
  .story-body :global(h3) { font-size: 21px; font-weight: bold; margin: 24px 0 12px; }
  .story-body :global(a) { text-decoration: underline; text-decoration-color: #fe5000; text-underline-offset: 4px; }
  .story-body :global(ul), .story-body :global(ol) { margin: 20px 0 24px; padding-left: 23px; }
  .story-body :global(ul) { list-style: disc; }
  .story-body :global(ol) { list-style: decimal; }
  .story-body :global(li) { margin: 10px 0; padding-left: 5px; }
  .story-sources { border-top: 1px solid #d2c9bb; margin-top: 40px; padding-top: 8px; font: 400 15px/1.6 Inter, system-ui, sans-serif; }
  .story-sources h2 { font-size: 21px; }
  .story-aside { display: grid; gap: 26px; }
  .aside-label { font-size: 14px; line-height: 1.5; font-weight: 600; }
  .related-meta { display: flex; gap: 20px; font-size: 14px; line-height: 1.5; }
  .story-award { background: #EFE2D2; padding: 28px; border-top: 4px solid #fe5000; }
  .award-year { font-family: 'Bruta', 'Bruta-Fallback', Impact, sans-serif; font-size: 80px; line-height: 1; margin: 28px 0 14px; }
  .story-award h2 { font-family: 'DD-Recoleta', 'Recoleta-Fallback', Georgia, serif; font-size: 24px; line-height: 1.15; margin-bottom: 16px; }
  .story-award p:not(.award-year) { font-size: 14px; line-height: 1.5; margin-bottom: 24px; }
  .story-award a { font-size: 14px; font-weight: bold; text-decoration: underline; text-underline-offset: 4px; }
  .story-next { padding: 28px; background: #191919; color: #fff8ee; }
  .story-next h2 { font-family: 'Bruta', 'Bruta-Fallback', Impact, sans-serif; font-size: 35px; line-height: 1.05; text-transform: uppercase; margin: 25px 0 20px; }
  .story-next p { font-size: 14px; line-height: 1.6; color: #e0d4c4; }
  .story-next ul { margin: 25px 0; }
  .story-next li { border-bottom: 1px solid #ffffff35; padding: 12px 0; font-size: 15px; }
  .story-next li a { display: flex; justify-content: space-between; gap: 12px; }
  .story-demo { display: flex; gap: 20px; align-items: center; justify-content: space-between; background: #fe5000; color: #fff; padding: 14px 17px; font: 600 16px/1.4 Inter, system-ui, sans-serif; }
  .story-demo:hover { background: #fff; color: #000; text-decoration: none; }
  .story-demo:focus-visible { outline-color: #fff; }
  .story-related { margin-top: 88px; border-top: 2px solid #191919; padding-top: 28px; }
  .related-heading { display: flex; align-items: center; justify-content: space-between; gap: 20px; margin-bottom: 28px; }
  .related-heading h2 { font-family: 'DD-Recoleta', 'Recoleta-Fallback', Georgia, serif; font-size: 28px; }
  .related-heading a { display: inline-flex; gap: 10px; align-items: center; font-size: 15px; font-weight: 600; }
  .related-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; }
  .related-card { padding: 24px 0; border-top: 1px solid #d2c9bb; }
  .related-card h3 { font-family: 'DD-Recoleta', 'Recoleta-Fallback', Georgia, serif; font-size: 26px; line-height: 1.2; margin: 17px 0 26px; }
  .related-source { display: inline-flex; gap: 10px; align-items: center; font-size: 15px; font-weight: 600; }
  a:focus-visible { outline: 3px solid #a33400; outline-offset: 6px; }
  a:hover { text-decoration: underline; text-underline-offset: 4px; }
  @media (max-width: 900px) { .story-grid { gap: 36px; grid-template-columns: minmax(0, 1fr) 250px; } .story-container { width: calc(100% - 48px); } }
  @media (max-width: 680px) {
    .news-story { padding-top: 42px; padding-bottom: 48px; }
    .story-container { width: calc(100% - 40px); }
    .story-back { margin-bottom: 38px; }
    .story-grid, .related-grid { grid-template-columns: 1fr; }
    .story-body { font-size: 17px; }
    .story-aside { margin-top: 12px; }
    .story-dates { flex-direction: column; gap: 8px; margin-bottom: 30px; }
    .related-heading { align-items: flex-start; flex-direction: column; }
    .story-related { margin-top: 48px; }
    .related-grid { gap: 4px; }
  }
</style>
