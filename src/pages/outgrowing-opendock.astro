---
export const prerender = true;

import Layout from "../layouts/Layout.astro";
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";
import CTA from "../components/home/CTA.astro";
import { CALENDLY_BOOKING_URL, CALENDLY_BRAND_PARAMS } from "../lib/calendly-config.mjs";
// ?inline returns the PostCSS-processed (prefixed + minified) CSS as a string
// instead of adding it to the sitewide bundle. See the file header for why.
import pageCss from "../styles/landing/outgrowing-opendock.css?inline";

const CALENDLY_FALLBACK_URL = `${CALENDLY_BOOKING_URL}?${CALENDLY_BRAND_PARAMS}`;

const comparisonFaqs = [
  {
    question: "What is the difference between DataDocks and OpenDock?",
    answer: "DataDocks is a dock scheduling and yard management platform built for facilities handling medium-to-high volumes (more than 20 loads per week). OpenDock is an entry-level tool aimed at lower-volume facilities. DataDocks offers deeper customization, custom business rules, multi-site management, and hands-on support from a team that works directly with warehouse operators."
  },
  {
    question: "Which is better for high-volume facilities?",
    answer: "DataDocks is the stronger choice for any facility handling more than 20 loads per week. It supports complex scheduling rules, multi-location rollouts, integrations with enterprise WMS and ERP systems, and real-time yard visibility. OpenDock works for smaller operations but its functionality is limited for busy distribution centers."
  },
  {
    question: "Does DataDocks integrate with WMS and ERP systems like OpenDock?",
    answer: "Yes. DataDocks integrates with SAP, Oracle NetSuite, Blue Yonder, Manhattan Associates, and other leading WMS, TMS, and ERP systems via REST API. Custom integrations are also supported for facilities with non-standard tech stacks."
  },
  {
    question: "How much does DataDocks cost compared to OpenDock?",
    answer: "DataDocks offers flexible pricing with no minimum contract, quoted based on facility size and number of locations. Most customers recoup their investment in under six months from detention savings alone. For a facility processing high volume, DataDocks often delivers lower total cost per appointment than entry-level alternatives."
  },
  {
    question: "How long does it take to switch from OpenDock to DataDocks?",
    answer: "Most facilities switch in a matter of weeks, not months. DataDocks is cloud-based with no hardware installation required. Our onboarding team handles data migration, carrier communication, and staff training to make the transition smooth for both your team and your carriers."
  },
  {
    question: "Does DataDocks have a mobile app?",
    answer: "Yes. DataDocks offers native iOS and Android apps for internal warehouse teams. Managers can view schedules, transition appointments, capture photos for QC checks, and receive push notifications — all from the dock floor."
  }
];

const sections = [
  {
    id: "training",
    heading: "Training and Support",
    items: [
      { title: "Ease of Setup", odScore: 100, ddScore: 100 },
      { title: "Carrier Onboarding", odScore: 30, ddScore: 100 },
      { title: "Ongoing Support", odScore: 30, ddScore: 100 },
    ],
    summary: {
      dd: { title: "With DataDocks, you get comprehensive onboarding.", body: "And we stick around to make sure you and your carriers are successful." },
      od: { title: "Opendock will set you up in less than an hour.", body: "But users say: \"The service I'm receiving now isn't what I initially signed up for.\" <sup>1</sup>" },
    },
  },
  {
    id: "ui",
    heading: "User Interface",
    items: [
      { title: "Manage Multiple Facilities", odScore: 100, ddScore: 100 },
      { title: "User Permissions", odScore: 60, ddScore: 100 },
      { title: "Scalability", odScore: 30, ddScore: 100 },
    ],
    summary: {
      dd: { title: "DataDocks provides a custom dashboard for each user.", body: "With filters and settings for each facility, the interface stays clean as you scale." },
      od: { title: "Opendock puts all your facilities and their appointments in one place.", body: "It offers visibility but we think it gets congested over time." },
    },
  },
  {
    id: "who",
    heading: "Who is it for?",
    items: [
      { title: "National Carriers", odScore: 100, ddScore: 100 },
      { title: "Local Carriers", odScore: 30, ddScore: 100 },
      { title: "Integration with Other Systems", odScore: 50, ddScore: 100 },
    ],
    summary: {
      dd: { title: "DataDocks focusses on dock scheduling.", body: "We thrive on those nuances and tailor the system to match your setup." },
      od: { title: "Loadsmart excels at Freight Brokerage, and Opendock is part of that vision.", body: "But we don't think they get the nuances of warehouses and carrier relationships." },
    },
  },
  {
    id: "unexpected",
    heading: "Dealing with the Unexpected",
    items: [
      { title: "Reliability", odScore: 100, ddScore: 100 },
      { title: "Edge Cases", odScore: 10, ddScore: 100 },
      { title: "Rescheduling", odScore: 50, ddScore: 100 },
    ],
    summary: {
      dd: { title: "DataDocks is made for dealing with real-life challenges.", body: "Whether it's rescheduling canceled appointments or taking care of spot trailers." },
      od: { title: "Opendock is designed for operations with a fixed schedule.", body: "It \"can be limited\" <sup>2</sup> and service outages can be frustrating." },
    },
  },
  {
    id: "data",
    heading: "Data and Accountability",
    items: [
      { title: "Easy-to-use", odScore: 100, ddScore: 100 },
      { title: "Reporting", odScore: 20, ddScore: 100 },
      { title: "Customizability", odScore: 20, ddScore: 100 },
    ],
    summary: {
      dd: { title: "If you're preparing for a data-driven future, DataDocks is for you.", body: "Whether it's logging unscheduled trucks or editing past appointments, we make it easy." },
      od: { title: "If you want a logistics-friendly alternative to Google Calendar, Opendock nails it.", body: "But for continuous improvement, you need more accurate data." },
    },
  },
];
---

<Layout
  title="DataDocks vs OpenDock: Dock Scheduling Software Comparison"
  description="DataDocks vs OpenDock: side-by-side comparison of dock scheduling features, integrations, pricing, and support for warehouses and distribution centers."
  noindex={true}
  schemaData={{ faq: comparisonFaqs }}
>
  {/* Inlined into <head> — a <style> after the markup would paint unstyled. */}
  <style slot="head" is:inline set:html={pageCss}></style>

  <Navigation />

  <main class="vs-page bg-[#FFF8E9] min-h-screen overflow-x-hidden">

    <!-- ═══ HERO ══════════════════════════════════════════════════════════ -->
    <section class="vs-hero">
      <div class="vs-hero__inner">

        <img class="vs-hero__deco vs-hero__deco--left" src="/images/6.svg" alt="Dock scheduling software comparison illustration" loading="eager" />
        <img class="vs-hero__deco vs-hero__deco--right" src="/images/15.svg" alt="Dock scheduling software comparison illustration" loading="eager" />

        <div class="vs-hero__content">

          <h1 class="vs-hero__h1">
            <span class="vs-hero__outgrowing">Outgrowing</span>
            <span class="vs-hero__opendock">OpenDock?</span>
          </h1>

          <div class="vs-hero__body">
            <p class="vs-hero__body-text">
              When Do You Outgrow Your Dock Scheduling Software?<br /><br />
              If your facility gets about 20 loads per week, Opendock has you covered.<br /><br />
              Any more than that, and we think you'll appreciate what
              <strong class="vs-hero__orange">DataDocks</strong> can do.
            </p>
            <!-- Hero CTA — matches homepage CTA component style -->
            <form
              id="vs-hero-form"
              class="vs-hero__form"
              method="get"
              action="/demo"
            >
              <input
                class="vs-hero__form-input"
                type="email"
                name="email"
                id="hero-email"
                placeholder="Enter your email"
                aria-label="Enter your email"
                required
              />
              <button class="vs-hero__form-btn" type="submit">Book a Demo</button>
            </form>
          </div>

        </div>
      </div>
    </section>

    <!-- ═══ COMPARISON SECTIONS ══════════════════════════════════════════ -->
    {sections.map((section) => (
      <section class="vs-section" id={section.id}>
        <div class="vs-section__inner">

          <h2 class="vs-section__heading js-reveal">{section.heading}</h2>

          <div class="vs-section__grid">

            {section.items.map((item) => (
              <article class="gauge-item">
                <h3 class="gauge-item__title">{item.title}</h3>
                <div class="gauge-group">
                  <div class="gauge">
                    <div class="gauge__label-row">
                      <img src="/images/3.svg" alt="Opendock" class="gauge__logo" />
                      <span class="gauge__label">Opendock</span>
                    </div>
                    <div class="gauge__track-wrap">
                      <div class="gauge__track">
                        <div class="gauge__fill js-gauge" style={`--score: ${item.odScore}%`}></div>
                      </div>
                    </div>
                  </div>
                  <div class="gauge">
                    <div class="gauge__label-row">
                      <img src="/images/logo-3.svg" alt="DataDocks" class="gauge__logo" />
                      <span class="gauge__label">DataDocks</span>
                    </div>
                    <div class="gauge__track-wrap">
                      <div class="gauge__track">
                        <div class="gauge__fill gauge__fill--dd js-gauge" style={`--score: ${item.ddScore}%`}></div>
                      </div>
                    </div>
                  </div>
                </div>
              </article>
            ))}

            <div class="vs-summary js-reveal">
              <div class="vs-summary__card">
                <img src="/images/3.svg" alt="Opendock" class="vs-summary__icon" />
                <div>
                  <p class="vs-summary__title">{section.summary.od.title}</p>
                  <p class="vs-summary__body" set:html={section.summary.od.body}></p>
                </div>
              </div>
              <div class="vs-summary__card">
                <img src="/images/logo-3.svg" alt="DataDocks" class="vs-summary__icon" />
                <div>
                  <p class="vs-summary__title">{section.summary.dd.title}</p>
                  <p class="vs-summary__body">{section.summary.dd.body}</p>
                </div>
              </div>
            </div>

          </div>
        </div>
      </section>
    ))}

    <!-- ═══ FOOTNOTES ════════════════════════════════════════════════════ -->
    <div class="vs-footnotes">
      <a href="https://www.g2.com/products/opendock/reviews/opendock-review-7755123" target="_blank" rel="noopener noreferrer" class="vs-footnote"><sup>1</sup> Review posted to g2.com, February 2023</a>
      <a href="https://www.g2.com/products/opendock/reviews/opendock-review-8691077" target="_blank" rel="noopener noreferrer" class="vs-footnote"><sup>2</sup> Review posted to g2.com, October 2023</a>
    </div>

    <!-- ═══ CTA SECTION — identical to homepage ═════════════════════════ -->
    <CTA />

  </main>

  <Footer />
</Layout>

<script>
  // Gauge fill animation on scroll
  const gauges = document.querySelectorAll<HTMLElement>('.js-gauge');
  const reveals = document.querySelectorAll<HTMLElement>('.js-reveal');

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-animated', 'is-visible');
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.3 }
  );

  gauges.forEach((el) => observer.observe(el));
  reveals.forEach((el) => observer.observe(el));

  // Hero form — open Calendly — moved to is:inline below
</script>

<script is:inline define:vars={{ CALENDLY_FALLBACK_URL, CALENDLY_BRAND_PARAMS }}>
  (function() {
    function attachVsForm() {
      var form = document.getElementById('vs-hero-form');
      if (!form || form.dataset.bound) return;
      form.dataset.bound = 'true';
      form.addEventListener('submit', function(e) {
        e.preventDefault();
        var emailInput = form.querySelector('input[name="email"]');
        var email = emailInput ? emailInput.value : '';
        if (email) {
          if (typeof window.ddSetEmail === 'function') {
            window.ddSetEmail(email);
          }
          if (typeof window.bento !== 'undefined' && typeof window.bento.identify === 'function') {
            window.bento.identify(email);
          }

          fetch('/api/bento-track', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              email: email,
              event: 'Demo Subscriber',
              source: window.location.pathname,
              landingPage: sessionStorage.getItem('dd_landing_page') || window.location.href,
              visitorUuid: (typeof window.getBentoVisitorUuid === 'function') ? window.getBentoVisitorUuid() : null,
              attribution: (typeof window.ddGetAttribution === 'function') ? window.ddGetAttribution() : null
            }),
            keepalive: true
          }).catch(function() {});
        }
        if (typeof window.ddOpenCalendly === 'function') {
          window.ddOpenCalendly(CALENDLY_BRAND_PARAMS);
        } else {
          window.open(CALENDLY_FALLBACK_URL, '_blank', 'noopener');
        }
        form.reset();
      });
    }

    attachVsForm();
    document.addEventListener('astro:page-load', attachVsForm);
  })();
</script>


