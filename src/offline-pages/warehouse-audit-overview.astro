  }
</style>

<script>
  function bindAuditChecklist() {
    const checklist = document.querySelector<HTMLElement>('[data-audit-checklist]');
    if (!checklist || checklist.dataset.bound) return;
    checklist.dataset.bound = 'true';
    const listeners = new AbortController();
    const listenerOptions = { signal: listeners.signal };
    const disclosures = Array.from(checklist.querySelectorAll<HTMLDetailsElement>('[data-audit-guidance]'));
    // A shared question link reveals its guidance; area links only navigate.
    const revealLinkedCheck = () => {
      let id: string;
      try { id = decodeURIComponent(window.location.hash.slice(1)); } catch { return; }
      const target = document.getElementById(id);
      if (!target || !checklist.contains(target)) return;
      if (target.matches('.audit-check')) target.querySelector<HTMLDetailsElement>('[data-audit-guidance]')?.setAttribute('open', '');
      target.scrollIntoView({ block: 'start', behavior: 'instant' });
    };
    revealLinkedCheck();
    window.addEventListener('hashchange', revealLinkedCheck, listenerOptions);
    // Print all guidance and restore the reader's chosen state afterwards.
    let printState: boolean[] | undefined;
    window.addEventListener('beforeprint', () => {
      printState ??= disclosures.map(detail => detail.open);
      disclosures.forEach(detail => detail.open = true);
    }, listenerOptions);
    window.addEventListener('afterprint', () => {
      const restore = printState;
      if (restore) disclosures.forEach((detail, index) => detail.open = restore[index]);
      printState = undefined;
    }, listenerOptions);
    document.addEventListener('astro:before-swap', () => {
      listeners.abort();
      delete checklist.dataset.bound;
    }, { once: true });
  }
  bindAuditChecklist();
  document.addEventListener('astro:page-load', bindAuditChecklist);
</script>
