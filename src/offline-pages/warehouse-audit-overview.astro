  .audit-check-label { display: block; font: inherit; margin: 0; font-size: 1.125rem; font-weight: 600; line-height: 1.45; }
  .audit-check-question { display: block; margin: .5rem 0 0; font-size: 1.125rem; line-height: 1.6; }
