  .audit-area-index li { min-width: 0; margin: 0; }
  .audit-area-index a { display: flex; justify-content: space-between; align-items: baseline; gap: .75rem; padding: .5rem 0; color: inherit; font-size: 1rem; line-height: 1.5; text-decoration: underline; text-underline-offset: .2em; }
  .audit-area-index a:hover { color: #fd4f00; }
  .audit-check-area { margin: 2.5rem 0; scroll-margin-top: 2rem; }
  .audit-check-area h3 { margin: 0 0 1.25rem; }
  .audit-check-guidance summary::-webkit-details-marker { display: none; }
  .audit-disclosure-chevron { width: 1.25rem; height: 1.25rem; margin-top: .2rem; color: inherit; }
  .audit-check-guidance[open] > summary > .audit-disclosure-chevron { transform: rotate(180deg); }
  .audit-checks { list-style: none; padding: 0; margin: 1.25rem 0 0; }
  .audit-check { margin: 0; padding: 0 0 1.75rem; scroll-margin-top: 2rem; }
