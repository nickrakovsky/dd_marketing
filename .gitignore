# Only site-related root directories belong in Git. New directory types require
# an explicit exception here; the repository hygiene check enforces these rules.
/*/
!/.github/
!/.vscode/
!/src/
!/public/
!/scripts/
!/tests/
!/docs/
!/integrations/
!/internal/
!/content-revamps/

# build output
dist/

# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# environment variables
.env
.env.production

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

# Webflow export (large, not needed in CI)
webflow-migration/

# Offline print assets - excluded from production build
internal/assets/print/*
!internal/assets/print/.gitkeep

# Local marketing data & exports - NOT FOR GITHUB
internal/pages/*.txt
internal/pages/*.csv

# Local analysis and experiments
analysis/

# Private internal assets
internal-marketing/

# Scratch / one-off scripts
scratch/

# Test/prototype HTML files at repo root
/test*.html
/index.html

# Loose reference / artefact JSON files at repo root (keep tracked project files)
/*.json
!/package.json
!/package-lock.json
!/tsconfig.json

# Backup files left by editors / agents
*.bak

# Assets staging folder (used for one-off imports only)
assets-for-import/
temp-import/

# SEO audit reports (working documents, not production code)
/ACTION-PLAN.md
/FULL-AUDIT-REPORT.md
/SCHEMA-IMPLEMENTATION-GUIDE.md
/*-audit.md
/*-audit-report.md
/technical-seo-audit-datadocks.md

# Local reference material, experiments, repairs, and generated artifacts
/General Image Bank/
/[Uu][Ii] [Ee]xperiments/
/[Uu][Ii]-[Ee]xperiments/
/codex-path-repair/
/docs/analytics-crm-project.md
/.wrangler/
/node_modules
/playwright-report/
/test-results/
/*.log
/check_output*.txt
/lhci_output.txt
/report.html
