{
  "ref": "datadocks_www_to_apex",
  "description": "Redirect www.datadocks.com to the canonical HTTPS host before contacting the origin",
  "expression": "(http.host eq \"www.datadocks.com\")",
  "action": "redirect",
  "action_parameters": {
    "from_value": {
      "status_code": 301,
      "target_url": {
        "expression": "concat(\"https://datadocks.com\", http.request.uri.path)"
      },
      "preserve_query_string": true
    }
  },
  "enabled": true
}
