{
  "description": "Booking frame protection and nosniff on HTML and static assets",
  "expression": "http.host eq \"booking.datadocks.com\"",
  "action": "rewrite",
  "action_parameters": {
    "headers": {
      "x-content-type-options": {
        "operation": "set",
        "value": "nosniff"
      },
      "content-security-policy": {
        "operation": "add",
        "value": "base-uri 'self'; object-src 'none'; frame-ancestors 'self'; upgrade-insecure-requests"
      }
    }
  },
  "enabled": true
}
